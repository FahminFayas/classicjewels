    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
