{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/jewellery/necklaces/index.html",
        "http://localhost/jewellery/necklaces/kolkata-fringe-choker/index.html",
        "http://localhost/collections/kolkata/index.html",
        "http://localhost/gold-rate/index.html",
        "http://localhost/stores/deira-gold-souq-extension/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 800000
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
