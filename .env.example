# Copy to .env (local) or set in your host's environment.
# All PUBLIC_* values are embedded in the client bundle; never put secrets here.

# JSON endpoint that returns today's gold rate (see src/lib/gold-rate.ts for the shape).
# Production default is the existing script on the same host.
PUBLIC_GOLD_RATE_ENDPOINT=/gold-rates.php

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to disable tracking entirely.
PUBLIC_GTM_ID=

# Where the contact form posts. Default is the PHP endpoint shipped in public/api/contact.php.
# Any provider that accepts a form POST works (Formspree, Web3Forms, Basin, your own API).
PUBLIC_FORM_ENDPOINT=/api/contact.php

# ---------------------------------------------------------------------------------------------
# Cloudflare Pages Functions (functions/): read at request time on the server, never PUBLIC_.
# In production the plain values live in wrangler.toml [vars] and the key is a Pages secret.
# Locally `npm run pages:dev` reads them from .env (Wrangler reads .env; do not also create a
# .dev.vars file, which would take precedence). See docs/deployment.md.

# The store's rate script on the PHP host. Once classicjewels.ae moves to Cloudflare this must be
# the feed subdomain instead: https://feed.classicjewels.ae/gold-rates.php (docs/deployment.md, step 3).
ORIGIN_FEED_URL=https://classicjewels.ae/gold-rates.php
# Edge cache lifetime for the feed, in seconds.
FEED_CACHE_SECONDS=300

# Where enquiries go (commas separate several), the sender (on the Resend-verified domain) and
# the canonical origin the form may post from.
CONTACT_TO=hello@classicgroup.ae
CONTACT_FROM=Classic Jewels Website <no-reply@classicjewels.ae>
SITE_ORIGIN=https://classicjewels.ae

# Resend API key (https://resend.com/api-keys), sending permission on the verified domain.
# In production set it as an encrypted Pages secret, never in wrangler.toml or git.
RESEND_API_KEY=
