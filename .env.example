# Copy to .env (local) or set in your host's environment.
# All PUBLIC_* values are embedded in the client bundle; never put secrets here.

# JSON endpoint that returns today's gold rate (see src/lib/gold-rate.ts for the shape).
# Production default is the existing script on the same host.
PUBLIC_GOLD_RATE_ENDPOINT=/gold-rates.php

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to disable tracking entirely.
PUBLIC_GTM_ID=

# Where the contact form posts. Default is the PHP endpoint shipped in public/api/contact.php.
# Any provider that accepts a form POST works (Formspree, Web3Forms, Basin, your own API).
PUBLIC_FORM_ENDPOINT=/api/contact.php
