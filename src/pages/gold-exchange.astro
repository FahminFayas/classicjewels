---
/**
 * Exchanging old gold (docs/design-system-v2.md §6.9). A plum opener under the stage header (a
 * bronze seam between them) with the H1 beside the estimator, then the three steps at the counter
 * (stage), the hallmarks to look for (ivory), what to bring (parchment), the questions (ivory) and
 * the four doors (stage).
 *
 * Honest by construction: until site.exchange.confirmed is true (TODO(owner), ask 1) the title
 * and the H1 say "at today's rate", the estimator shows fine-gold weight rather than dirhams, and
 * no "0% deduction" or "no weight deduction" wording reaches the page, the FAQ answers included.
 */
import BranchDoors from '@/components/sections/BranchDoors.astro';
import Estimator from '@/components/sections/Estimator.astro';
import Faq from '@/components/sections/Faq.astro';
import KaratStamps from '@/components/sections/KaratStamps.astro';
import StepStrip from '@/components/sections/StepStrip.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDesignCollections, getFaqGroup } from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';

const [faq, collections, { latest }] = await Promise.all([
  getFaqGroup('gold-exchange'),
  getDesignCollections(),
  getRates(),
]);

const branchCount = countWord(openBranches.length).toLowerCase();
const lead = site.promises.find((p) => p.id === 'gold-exchange')?.detail;

/** Unconfirmed exchange terms stay off the page until the owner confirms them. */
const unconfirmed = /0\s?% deduction|no weight deduction|full weight/i;
const questions = site.exchange.confirmed
  ? faq.data.items
  : faq.data.items.filter((item) => !unconfirmed.test(`${item.question} ${item.answer}`));

const steps = [
  {
    title: 'Tested at the counter, in front of you',
    text: 'Before anything is weighed. The test gives the karat of each piece.',
  },
  {
    title: 'Weighed, with stones, springs and other parts set aside',
    text: 'On the counter scale, where you can see it. Only the gold counts towards the weight.',
  },
  {
    title: 'Credited at the day’s rate for its karat, against a new piece',
    text: 'Making charges and VAT apply to the new piece, as on any purchase.',
  },
];

const bring = ['The pieces', 'Any receipts you have', 'Your Emirates ID or passport'];

/* §6.9: the "0% deduction" wording may come back only once the owner confirms the terms. */
const title = 'Exchange Old Gold in Dubai at Today’s Rate';
const description = `Bring old gold to any of our ${branchCount} branches: tested in front of you, weighed, and credited at the day’s rate against a new piece. ${
  site.exchange.confirmed ? 'Work out an estimate first.' : 'Work out its fine gold first.'
}`;
---

<BaseLayout ground="stage" title={title} description={description}>
  <Section tone="stage" class="xhead" labelledby="exchange-title">
    <Breadcrumbs items={[{ name: 'Gold exchange', href: routes.goldExchange }]} />
    <div class="xhead__grid">
      <div class="xhead__text">
        <Eyebrow>Old gold</Eyebrow>
        <h1 id="exchange-title">
          Exchange old gold <em>at today’s rate</em>
        </h1>
        {lead && <p class="xhead__lead lead">{lead}</p>}
        <p class="xhead__note small">
          {site.exchange.confirmed ? 'Work out an estimate here' : 'Work out its fine gold here'},
          then message us with the weight and the branch you will bring it to.
        </p>
      </div>
      <div class="xhead__panel">
        <Estimator rate={latest} id="estimator" />
      </div>
    </div>
  </Section>

  <Section tone="stage" seam id="at-the-counter" labelledby="counter-title">
    <SectionHead
      eyebrow="At the counter"
      title="Tested"
      accent="in front of you"
      id="counter-title"
      shape="split"
      class="reveal"
    >
      Nothing leaves your sight: the test, the weighing and the credit are worked out on the
      counter.
    </SectionHead>
    <StepStrip steps={steps} />
  </Section>

  <Section tone="ivory" id="hallmarks" labelledby="hallmarks-title">
    <SectionHead
      title="Read your"
      accent="own hallmark"
      id="hallmarks-title"
      shape="stack"
      class="reveal"
    >
      Look inside the clasp or the band for one of these numbers.
    </SectionHead>
    <KaratStamps rate={latest} collections={collections} variant="compact" />
  </Section>

  <Section tone="parchment" id="what-to-bring" labelledby="bring-title">
    <div class="bring">
      <h2 class="bring__title" id="bring-title">
        What to bring
      </h2>
      <div class="bring__body">
        <ol class="bring__list rows" role="list">
          {bring.map((item, i) => (
            <li class="bring__item">
              <span class="bring__n fig" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="bring__note">
          Ask us for the exchange terms before you come; an offer running at the time can change
          them.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="ivory" id="questions" width="narrow" ruled>
    <Faq heading={faq.data.heading} items={questions} />
  </Section>

  <Section tone="stage" id="branches" labelledby="branches-title">
    <SectionHead
      eyebrow="Branches"
      title="Bring it"
      accent="to a branch"
      id="branches-title"
      shape="split"
      class="reveal"
    >
      {countWord(openBranches.length)} branches in {listWords(emirates)}. Message the one nearest
      you before you come.
    </SectionHead>
    <BranchDoors variant="compact" />
  </Section>
</BaseLayout>

<style>
  /* ---------- Opener: H1 and lead 5, the estimator 7 ---------- */
  :global(.sec.xhead) {
    padding-block-start: var(--space-5);
  }

  .xhead__grid {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    margin-block-start: var(--space-6);
  }

  .xhead__text {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .xhead__text :global(.eyebrow) {
    margin-block-end: 0;
  }

  /* Two levels: the action, then the italic terms on their own line. */
  .xhead__text h1 em {
    display: block;
  }

  .xhead__note {
    max-inline-size: var(--measure);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
  }

  @media (min-width: 64em) {
    .xhead__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: calc(var(--grid-gap) * 2);
      margin-block-start: var(--space-8);
    }

    .xhead__text {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-6));
      align-self: start;
    }
  }

  /* ---------- What to bring ---------- */
  .bring {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
  }

  .bring__item {
    display: grid;
    grid-template-columns: var(--space-8) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-4);
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
  }

  .bring__n {
    font-family: var(--ff-text);
    font-size: var(--t-small);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    color: var(--eyebrow);
  }

  .bring__note {
    margin-block-start: var(--space-5);
    max-inline-size: var(--measure);
    color: var(--body);
  }

  @media (min-width: 64em) {
    .bring {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: calc(var(--grid-gap) * 2);
      align-items: start;
    }
  }
</style>
