---
/**
 * Today's gold rate (docs/design-system-v2.md §6.8). The page is the instrument: a stage opener
 * with the H1 and the 200 px numeral (the LCP candidate; no image on this page), the four karat
 * keys as a vertical board beside it, then the hallmark stamps (ivory), our record of postings
 * (stage-raised), how a price is built (ivory, #price), old gold with the estimator (plum), the
 * questions (ivory) and the four doors (stage), so the page ends at a person.
 *
 * Every figure is baked at build from src/content/rates (or the live feed) and carries a rate.ts
 * hook, so a newer posting reaches the numeral, the keys, the stamps and the quote lines in place.
 */
import type { Dataset, WithContext } from 'schema-dts';

import BranchDoors from '@/components/sections/BranchDoors.astro';
import Estimator from '@/components/sections/Estimator.astro';
import Faq from '@/components/sections/Faq.astro';
import KaratStamps from '@/components/sections/KaratStamps.astro';
import QuoteLines from '@/components/sections/QuoteLines.astro';
import RateInstrument from '@/components/sections/RateInstrument.astro';
import RateRecord from '@/components/sections/RateRecord.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDesignCollections, getFaqGroup } from '@/lib/content';
import { countWord, formatDate, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { ORG_ID } from '@/lib/schema';
import { DISPLAY_KARATS, KARAT_FACTS } from '@/lib/tones';
import { whatsappGoldRate } from '@/lib/whatsapp';

const [faq, collections, { latest, history, stale, fetchedAt }] = await Promise.all([
  getFaqGroup('gold-rate'),
  getDesignCollections(),
  getRates(),
]);

const exchangePromise = site.promises.find((p) => p.id === 'gold-exchange')?.detail;
const oldest = history.at(-1);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const pageUrl = new URL(routes.goldRate, origin).toString();

/* Dataset markup for the posted figures we print (no rich result is claimed; design-spec §5.4). */
const jsonLd: WithContext<Dataset>[] = latest
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Dataset',
        name: 'Gold rate in Dubai, AED per gram',
        description: `${site.rate.source} ${site.rate.basis} for 24K, 22K, 21K and 18K gold in AED per gram, as posted on the boards at ${site.name}. Updated ${formatDate(latest.date)}.`,
        url: pageUrl,
        creator: { '@id': ORG_ID },
        spatialCoverage: { '@type': 'Place', name: 'Dubai, United Arab Emirates' },
        temporalCoverage: oldest ? `${oldest.date}/${latest.date}` : latest.date,
        variableMeasured: DISPLAY_KARATS.map((k) => ({
          '@type': 'PropertyValue',
          name: `${KARAT_FACTS[k].label} gold rate`,
          value: latest.perGram[k],
          unitText: 'AED per gram',
        })),
      },
    ]
  : [];

const description =
  'Today’s gold rate in Dubai, AED per gram for 24K, 22K, 21K and 18K, as posted in our branches, with what each karat holds and how a price is built.';
const steps = [
  'Tested at the counter, in front of you',
  'Weighed, with stones and clasps set aside',
  'Credited at the day’s rate for its karat',
];
---

<BaseLayout
  ground="stage"
  title="Gold Rate in Dubai Today: 24K, 22K, 21K, 18K per gram"
  description={description}
  jsonLd={jsonLd}
>
  <PageHead
    tone="stage"
    id="board"
    breadcrumbs={[{ name: 'Gold rate', href: routes.goldRate }]}
    eyebrow="Gold rate · Dubai"
    title="Today’s gold rate in Dubai"
  >
    <RateInstrument
      slot="media"
      rate={latest}
      stale={stale}
      fetchedAt={fetchedAt}
      variant="page"
      id="rate"
      history={history}
    />
    <Button href={whatsappGoldRate()} icon="whatsapp" external class="board__act">
      Ask on WhatsApp
    </Button>
    <Button href={routes.stores} variant="secondary" icon="map-pin" class="board__act">
      Find a branch
    </Button>
  </PageHead>

  <Section tone="ivory" id="karats" labelledby="karats-title">
    <SectionHead
      eyebrow="Karat guide"
      title="What each"
      accent="karat holds"
      id="karats-title"
      shape="stack"
      class="reveal"
    >
      Every piece carries the UAE hallmark for its karat, and your invoice prints its weight and
      fineness.
    </SectionHead>
    <KaratStamps rate={latest} collections={collections} variant="band" />
  </Section>

  <Section tone="stage-raised" id="record" labelledby="record-title">
    <RateRecord history={history}>
      <SectionHead title="Our record" id="record-title" shape="stack" class="reveal" />
    </RateRecord>
  </Section>

  <Section tone="ivory" id="price" labelledby="price-title">
    <QuoteLines karat="22k" rate={latest} title="How a price is built," accent="in three lines" />
    <p class="price__close">No prices online. Each piece is quoted on request at the day’s rate.</p>
  </Section>

  <Section tone="parchment" id="old-gold" labelledby="old-gold-title">
    <div class="oldgold">
      <div class="oldgold__text">
        <Eyebrow>Old gold</Eyebrow>
        <h2 id="old-gold-title">
          Old gold, <em>on today’s scale</em>
        </h2>
        {exchangePromise && <p class="lead">{exchangePromise}</p>}
        <ol class="oldgold__steps rows" role="list">
          {steps.map((step, i) => (
            <li>
              <span class="oldgold__n fig" aria-hidden="true">
                {i + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <Estimator rate={latest} id="estimator" />
    </div>
  </Section>

  <Section tone="ivory" id="questions" width="narrow">
    <Faq heading={faq.data.heading} items={faq.data.items} />
  </Section>

  <Section tone="stage" id="branches" labelledby="branches-title">
    <SectionHead
      eyebrow="Branches"
      title="Buy or exchange"
      accent="at today’s rate"
      id="branches-title"
      shape="split"
      class="reveal"
    >
      {countWord(openBranches.length)} branches in {listWords(emirates)}. Message the one nearest
      you before you come.
    </SectionHead>
    <BranchDoors variant="compact" />
  </Section>
</BaseLayout>

<style>
  /* Phones: the two actions as an even pair. */
  @media (max-width: 39.99em) {
    :global(.btn.board__act) {
      flex: 1 1 0;
      padding-inline: var(--space-3);
    }
  }

  .price__close {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.25;
    color: var(--fg);
    text-wrap: balance;
  }

  .oldgold {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    align-items: start;
  }

  .oldgold__text {
    display: grid;
    gap: var(--space-5);
    max-inline-size: 34rem;
  }

  .oldgold__text :global(.eyebrow) {
    margin-block-end: 0;
  }

  .oldgold__steps {
    margin-block-start: var(--space-3);
  }

  .oldgold__steps li {
    display: grid;
    grid-template-columns: var(--space-7) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-4);
    color: var(--fg);
  }

  .oldgold__n {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1;
    color: var(--numeral);
  }

  @media (min-width: 64em) {
    .oldgold {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: calc(var(--grid-gap) * 2);
    }
  }
</style>
