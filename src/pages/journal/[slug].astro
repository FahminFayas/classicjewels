---
/**
 * A journal article (docs/design-system-v2.md §6.16). Ivory, one reading column.
 *
 *   - the headline as the H1, the standfirst, the date and the byline;
 *   - the cover, drawn at most its source width (750 CSS px), the page's one priority image;
 *   - the Markdown body at --prose;
 *   - a 2 px bronze reading-progress hairline fixed under the header, driven by the page's own
 *     scroll (scroll(root)); only where scroll-driven animation exists and motion is welcome,
 *     hidden everywhere else;
 *   - the collections the article names and today's rate as a row of links, then an enquiry band.
 *
 * One JPEG for the share card and the Article image, never wider than the source; its real size
 * goes to the Open Graph tags.
 */
import { getImage, Picture } from 'astro:assets';
import { getEntries, render } from 'astro:content';

import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import PageHead from '@/components/ui/PageHead.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getArticles, type Article } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { articleSchema } from '@/lib/schema';
import { whatsappUrl } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;

const [{ Content }, relatedCollections, rates] = await Promise.all([
  render(article),
  getEntries(data.relatedCollections),
  getRates(),
]);

const headline = data.headline ?? data.title;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const canonical = new URL(routes.article(article.id), origin).toString();

/* The cover: never wider than its source (about 750 px), sharp where the screen allows. */
const cover = data.cover;
const coverCap = Math.min(750, cover.width);
const coverWidths = [...new Set([360, 480, 600, coverCap])]
  .filter((w) => w <= cover.width)
  .sort((a, b) => a - b);

const shareWidth = Math.min(1200, cover.width);
const shareHeight = Math.round((shareWidth * cover.height) / cover.width);
const share = await getImage({ src: cover, width: shareWidth, format: 'jpeg', layout: 'none' });
const coverUrl = new URL(share.src, origin).toString();

/* The breadcrumb repeats the sentence-case heading, not the SEO title. */
const crumb = headline.replace(/[.!]$/, '');

const enquiry = whatsappUrl(
  `${site.whatsapp.greeting} I read your article "${data.title}" and have a question.`,
);

const jsonLd = [
  articleSchema({
    headline,
    description: data.description,
    url: canonical,
    image: coverUrl,
    datePublished: data.pubDate,
    dateModified: data.updatedDate,
    author: data.author,
  }),
];
---

<BaseLayout
  ground="ivory"
  title={data.title}
  description={data.description}
  type="article"
  image={coverUrl}
  imageAlt={data.coverAlt}
  imageWidth={shareWidth}
  imageHeight={shareHeight}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"></div>

  <PageHead
    tone="ivory"
    breadcrumbs={[
      { name: 'Journal', href: routes.journal },
      { name: crumb, href: routes.article(article.id) },
    ]}
    eyebrow="Journal"
    title={headline}
    lead={data.description}
  >
    <p class="byline">
      <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{data.author}</span>
    </p>
  </PageHead>

  <Section tone="ivory" class="article" labelledby="page-title">
    <figure class="article__cover" style={`--cap:${coverCap}px`}>
      <Picture
        src={cover}
        alt={data.coverAlt}
        formats={['avif', 'webp']}
        widths={coverWidths}
        sizes={`(min-width: 64em) ${coverCap}px, min(${coverCap}px, calc(100vw - 2rem))`}
        fit="cover"
        priority
      />
    </figure>
    <div class="article__body prose">
      <Content />
      {data.updatedDate && (
        <p class="article__updated">
          Updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
        </p>
      )}
    </div>
    <nav class="related" aria-label="Related">
      <p class="related__row list-links">
        <span class="related__label eyebrow">Read on</span>
        {relatedCollections.map((c) => (
          <a class="link-wipe" href={routes.collection(c.id)}>
            {c.data.shortName}
          </a>
        ))}
        <a class="link-wipe" href={routes.goldRate}>
          Today’s gold rate
          {rates.latest && (
            <span class="related__rate">
              (22K <RateFigure rate={rates.latest} karat="22k" />)
            </span>
          )}
        </a>
      </p>
    </nav>
  </Section>

  <EnquiryBand
    title="Ask the counter"
    accent="about this"
    text="Send the question on WhatsApp, with a photo if you have one. We reply with figures: the rate, the weight, the making charge."
    whatsappUrl={enquiry}
    secondary={{ href: routes.journal, label: 'More from the journal' }}
  />
</BaseLayout>

<style>
  :global(.sec.article) {
    padding-block-start: 0;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--t-small);
    color: var(--muted);
  }

  .article__cover {
    inline-size: min(100%, var(--cap));
    margin: 0 0 var(--space-8);
    padding: var(--space-2);
    border: 1px solid var(--rule-strong);
  }

  .article__cover :global(picture) {
    display: block;
  }

  .article__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .article__body {
    font-size: var(--t-lead);
    line-height: 1.65;
  }

  .article__body :global(h2) {
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
  }

  /* Markdown tables scroll inside their own box on phones instead of widening the page. */
  @media (max-width: 47.99em) {
    .article__body :global(table) {
      display: block;
      overflow-x: auto;
    }
  }

  .article__updated {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
    font-size: var(--t-small);
    color: var(--muted);
  }

  .related {
    max-inline-size: var(--prose);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule-strong);
  }

  .related__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  .related__label {
    margin-inline-end: var(--space-3);
  }

  .related__rate {
    font-weight: var(--fw-text);
    color: var(--muted);
  }

  /* Reading progress: a 2 px bronze hairline under the header, scaled by the page's scroll. */
  .progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .progress {
        position: fixed;
        display: block;
        inset-block-start: var(--header-h);
        inset-inline: 0;
        z-index: var(--z-header);
        block-size: 2px;
        background: var(--rule-gold);
        transform-origin: 0 50%;
        animation: read-progress linear both;
        animation-timeline: var(--tl-scroll);
      }

      :global([dir='rtl']) .progress {
        transform-origin: 100% 50%;
      }
    }
  }

  @keyframes read-progress {
    from {
      scale: 0 1;
    }

    to {
      scale: 1 1;
    }
  }
</style>
