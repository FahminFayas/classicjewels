---
/**
 * Journal index (docs/design-system-v2.md §6.16). Ivory, a reading room: buying guides and rate
 * notes from the counter, newest first, as cards in three columns (one on phones). No reading
 * times. The ItemList JSON-LD mirrors the grid so search engines see the order a reader does.
 */
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import JournalCard from '@/components/sections/JournalCard.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getArticles } from '@/lib/content';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { whatsappUrl } from '@/lib/whatsapp';

const articles = await getArticles();
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();

const jsonLd = [
  itemListSchema(
    articles.map((a) => ({
      name: a.data.headline ?? a.data.title,
      url: new URL(routes.article(a.id), origin).toString(),
    })),
    'Journal articles',
  ),
];

const enquiry = whatsappUrl(`${site.whatsapp.greeting} I have a question about buying gold.`);
---

<BaseLayout
  ground="ivory"
  title="Journal: Dubai Gold Rates, Hallmarks & Buying Guides"
  description="Buying guides and rate notes from the counter: what the 916 and 750 stamps mean, how making charges and 5% VAT are added, which karat to choose. Ask us on WhatsApp."
  jsonLd={jsonLd}
>
  <PageHead
    tone="ivory"
    breadcrumbs={[{ name: 'Journal', href: routes.journal }]}
    eyebrow="Journal"
    title="Notes"
    accent="from the counter"
    lead="Buying guides and rate notes: what the stamps mean, how a price is built, which karat to choose."
  />

  <Section tone="ivory" class="journal-list">
    {articles.length > 0 ? (
      <>
        <h2 class="sr-only">Articles, newest first</h2>
        <ul class="articles" role="list">
          {articles.map((a, i) => (
            <li class:list={['articles__cell', i > 2 && 'reveal']}>
              <JournalCard article={a} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="lead">
        No articles yet. <MoreLink href={routes.goldRate}>Today’s gold rate</MoreLink>
      </p>
    )}
  </Section>

  <EnquiryBand
    title="Ask what the journal"
    accent="has not covered"
    text="Send the question on WhatsApp, with a photo if you have one. We reply with figures: today’s rate, the weight, the making charge."
    whatsappUrl={enquiry}
    secondary={{ href: routes.goldRate, label: 'Today’s gold rate' }}
  />
</BaseLayout>

<style>
  :global(.sec.journal-list) {
    padding-block-start: 0;
  }

  .articles {
    display: grid;
    gap: var(--space-8) var(--grid-gap);
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--rule);
  }

  @media (min-width: 48em) {
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .articles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
