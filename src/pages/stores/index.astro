---
/**
 * Store index: every open branch as a ruled row, the announced branches below, the visiting FAQ
 * and the enquiry block. Every fact comes from src/data/site.ts.
 */
import EnquiryBlock from '@/components/sections/EnquiryBlock.astro';
import Faq from '@/components/sections/Faq.astro';
import Hero from '@/components/sections/Hero.astro';
import StoreCard from '@/components/sections/StoreCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { branches, emirates, flagship, openBranches } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqGroup } from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { jewelryStoreSchema } from '@/lib/schema';
import { whatsappVisit } from '@/lib/whatsapp';

const faq = await getFaqGroup('stores');
const soon = branches.filter((b) => b.status === 'opening-soon');
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const storeImage = new URL('/og/default.png', origin).toString();

const count = countWord(openBranches.length);
const emirateList = listWords(emirates);
const description = `${count} Classic Jewels branches in ${emirateList}: ${listWords(
  openBranches.map((b) => b.shortName),
)}. Address, directions and WhatsApp for each.`;

/** "Deira in Dubai, Safari Mall and Rolla Mall in Sharjah and Madinat Zayed in Abu Dhabi" */
const byEmirate = new Map<string, string[]>();
for (const b of openBranches) {
  byEmirate.set(b.emirate, [...(byEmirate.get(b.emirate) ?? []), b.shortName]);
}
const places = listWords(
  [...byEmirate].map(([emirate, names]) => `${listWords(names)} in ${emirate}`),
);
const lead = `${places}${soon.length > 0 ? ', with more opening' : ''}. The day’s rate on the board is the same at every counter.`;

/** The flagship's JewelryStore is already in every page head (BaseLayout); the rest go here. */
const jsonLd = openBranches
  .filter((b) => !b.isFlagship)
  .map((b) => jewelryStoreSchema(b, storeImage));
---

<BaseLayout
  ground="ivory"
  title={`Our Stores in ${emirateList}`}
  description={description}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Stores', href: routes.stores }]} />
  </div>

  <Hero eyebrow="Stores" title="Our branches across the UAE" display lead={lead}>
    <Button href={whatsappVisit()} icon="whatsapp" external>
      WhatsApp before you visit
    </Button>
    <Button href={routes.store(flagship.id)} variant="secondary" icon="map-pin">
      The {flagship.shortName} flagship
    </Button>
  </Hero>

  <section class="section section--ruled">
    <div class="container">
      <SectionHead eyebrow="Open now" title="Where to find us.">
        Each branch page has the address, how to reach the counter and the hours we have for it.
      </SectionHead>
      <div class="rows">
        {openBranches.map((b) => (
          <StoreCard branch={b} compact />
        ))}
      </div>
    </div>
  </section>

  {soon.length > 0 && (
    <section class="section section--ruled">
      <div class="container">
        <SectionHead eyebrow="Opening soon" title="More counters are on the way.">
          Announced locations, with dates to follow once confirmed. Until then the nearest open
          branch is a message away.
        </SectionHead>
        <ul class="rows" role="list">
          {soon.map((b) => (
            <li class="soon">
              <div class="soon__text">
                <p class="soon__emirate small">{b.emirate}</p>
                <h3 class="soon__name">{b.name}</h3>
                <p class="soon__venue">{b.venue}</p>
              </div>
              <p class="soon__note small">{b.publicNote ?? 'Opening soon.'}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--ruled">
    <div class="container">
      <Faq heading={faq.data.heading} items={faq.data.items} />
    </div>
  </section>

  <section class="section section--ruled">
    <div class="container">
      <EnquiryBlock
        heading="Check before you set out"
        text="WhatsApp is fastest during shop hours: confirm today’s timings, or ask us to have a piece ready at the counter nearest you."
        whatsappUrl={whatsappVisit()}
        whatsappLabel="WhatsApp before you visit"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .soon {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }

  .soon__text {
    display: grid;
    gap: var(--space-1);
  }

  .soon__emirate {
    color: var(--gold-700);
    letter-spacing: 0.04em;
  }

  .soon__name {
    font-size: var(--t-h3);
  }

  .soon__venue {
    color: var(--ink-700);
  }

  .soon__note {
    color: var(--ink-500);
  }

  @media (min-width: 64em) {
    .soon {
      grid-template-columns: 7fr 5fr;
      column-gap: calc(var(--grid-gap) * 2);
      align-items: end;
    }
  }
</style>
