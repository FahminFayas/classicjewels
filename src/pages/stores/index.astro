---
/**
 * Branches (docs/design-system-v2.md §6.11): the four doors on the stage, drawn west to east, each
 * with Call, Directions and WhatsApp; the opening-soon row; the visiting questions on ivory; an
 * enquiry band for anyone not sure which branch suits them. Maps by link only, no iframe. Every
 * fact comes from src/data/site.ts: each door carries the hours, phone and Google rating its
 * branch publishes, the hours captioned "As listed on Google" until the owner confirms them.
 */
import BranchDoors from '@/components/sections/BranchDoors.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import Faq from '@/components/sections/Faq.astro';
import Button from '@/components/ui/Button.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import { emirates, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqGroup } from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { jewelryStoreSchema } from '@/lib/schema';
import { whatsappUrl } from '@/lib/whatsapp';

const faq = await getFaqGroup('stores');
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const storeImage = new URL('/og/default.png', origin).toString();

const count = countWord(openBranches.length);
const emirateList = listWords(emirates);
const description = `${count} Classic Jewels branches in ${emirateList}: ${listWords(
  openBranches.map((b) => b.shortName),
)}. Address, directions and WhatsApp for each.`;
const lead = `${count} branches in ${emirateList}. Message the one nearest you before you come.`;

/** Two counts for the opener, each with the names behind it: all from site.ts. */
const westToEast = [...openBranches].sort((a, b) => (a.routeOrder ?? 99) - (b.routeOrder ?? 99));
const tally = [
  {
    n: openBranches.length,
    label: 'Branches open',
    note: listWords(westToEast.map((b) => b.shortName)),
  },
  { n: emirates.length, label: emirates.length === 1 ? 'Emirate' : 'Emirates', note: emirateList },
];

const ask = whatsappUrl(
  `${site.whatsapp.greeting} which of your branches is best for me? I’m coming from`,
);

/** The flagship's JewelryStore is already in every page head (BaseLayout); the rest go here. */
const jsonLd = openBranches
  .filter((b) => !b.isFlagship)
  .map((b) => jewelryStoreSchema(b, storeImage));
---

<BaseLayout
  ground="stage"
  title={`Our Stores in ${emirateList}`}
  description={description}
  jsonLd={jsonLd}
>
  <PageHead
    tone="stage"
    breadcrumbs={[{ name: 'Branches', href: routes.stores }]}
    eyebrow="Branches"
    title="Our branches across the UAE"
    lead={lead}
    layout="split"
  >
    <Button href={ask} icon="whatsapp" external>
      WhatsApp us
    </Button>
    <Button href={`tel:${site.phone.landline.e164}`} variant="secondary" icon="phone">
      Call {site.phone.landline.display}
    </Button>
    <dl class="tally" slot="aside">
      {tally.map((t) => (
        <div class="tally__cell">
          <dt class="tally__label">{t.label}</dt>
          <dd class="tally__n fig">{t.n}</dd>
          <dd class="tally__note">{t.note}</dd>
        </div>
      ))}
    </dl>
  </PageHead>

  <Section tone="stage" seam class="stores-doors" labelledby="doors-title">
    <h2 class="sr-only" id="doors-title">
      The branches, west to east
    </h2>
    <BranchDoors variant="full" />
  </Section>

  <Section tone="ivory">
    <Faq heading={faq.data.heading} items={faq.data.items} />
  </Section>

  <EnquiryBand
    title="Not sure which branch?"
    accent="Ask us."
    text="Tell us where you are coming from and what you would like to see. We will say which counter suits you and check the piece is there."
    whatsappUrl={ask}
    secondary={{
      href: `tel:${site.phone.landline.e164}`,
      label: `Call ${site.phone.landline.display}`,
    }}
  />
</BaseLayout>

<style>
  /* The doors continue the opener's stage: one room, no second band edge between them. */
  :global(.sec.stores-doors) {
    padding-block-start: 0;
  }

  /* Two counts on the right of the opener: champagne numerals, the names under them. */
  .tally {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    border-block-start: 1px solid var(--rule);
  }

  .tally__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-start: var(--space-5);
  }

  .tally__n {
    order: -1;
    font-family: var(--ff-display);
    font-size: var(--t-stamp);
    font-weight: var(--fw-display);
    line-height: var(--lh-numeral);
    letter-spacing: var(--track-rate);
    color: var(--numeral);
  }

  .tally__label {
    margin-block-start: var(--space-3);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .tally__note {
    max-inline-size: 22ch;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--body);
  }
</style>
