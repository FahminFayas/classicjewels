---
/**
 * One branch (docs/design-system-v2.md §6.11), built for every open branch in src/data/site.ts.
 *
 *   1. Opener, stage: the branch name at display size, the emirate, the route miniature with this
 *      branch lit, WhatsApp and Directions; the media is a parchment facts plate (the venue set in
 *      Cormorant italic) until branch photographs exist. Never a jewellery photograph.
 *   2. Facts ledger, ivory: the address with its "located in" and plus-code lines, the phone (and
 *      Deira's mobile), WhatsApp this branch, directions and the map link, the hours by day
 *      (identical days collapsed, today marked, the breaks named, the open-now line in Dubai
 *      time, captioned "As listed on Google" until confirmed), the branch's own Google rating as
 *      one dated line, facilities, metro, parking and Instagram where site.ts has them.
 *   3. Book a visit, plum: the four-step visit form with this branch preselected.
 *   4. Every door, stage: BranchDoors compact, so the page ends at a person.
 *
 * Copy that only fits one branch is gated on its data (mall wording on venueType 'mall', metro
 * and parking rows only where site.ts has them). No map iframe: Google Maps by link only.
 */
import type { InferGetStaticPropsType } from 'astro';

import BranchDoors from '@/components/sections/BranchDoors.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import Ornament from '@/components/ui/Ornament.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { flagship, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/format';
import { breakLines, hoursCaption, hoursRuns, openNowData } from '@/lib/hours';
import { routes } from '@/lib/routes';
import { jewelryStoreSchema } from '@/lib/schema';
import { TITLE_MAX } from '@/lib/seo';
import { whatsappUrl } from '@/lib/whatsapp';

export function getStaticPaths() {
  return openBranches.map((branch) => ({ params: { slug: branch.id }, props: { branch } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { branch } = Astro.props;
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const storeImage = new URL('/og/default.png', origin).toString();

const own = Boolean(branch.phone);
const phone = branch.phone ?? site.phone.landline;
const inMall = branch.venueType === 'mall';
const mapUrl = branch.map?.url;

/** Address lines with the locality/region duplicate that mall branches carry removed. */
const addressLines = [branch.address.street, branch.address.locality, branch.address.region].filter(
  (line, i, all) => all.indexOf(line) === i,
);
/** "Located in" only when the venue is not already the whole street line. */
const locatedIn = branch.address.street === branch.venue ? undefined : branch.venue;
const hasUnit = /\b(shop|unit|no\.)/i.test(branch.address.street);
const lead = hasUnit
  ? `${branch.shortAddress ?? addressLines[0]}, ${branch.address.locality}.${
      branch.isFlagship ? ` Our first counter, open since ${site.founded.brandYear}.` : ''
    }`
  : `${inMall ? 'Inside' : 'In'} ${branch.venue}, ${branch.city}. Call or message for the shop number and we will guide you to the counter.`;

const parking = branch.facilities?.filter((f) => /parking/i.test(f)) ?? [];
const facilities = branch.facilities?.filter((f) => !/parking/i.test(f)) ?? [];
const directions =
  branch.directions ??
  `The shop is ${inMall ? 'inside' : 'in'} ${branch.venue}, ${branch.city}. Open the map for a route, then call or message us and we will guide you ${inMall ? 'from the mall entrance' : 'to the counter'}.`;

const runs = hoursRuns(branch);
const breaks = breakLines(branch);
const caption = hoursCaption(branch);
const nowData = openNowData(branch);
const hasHours = runs.length > 0;
const rating = branch.reviews;

const instagramHandle = branch.instagram
  ? new URL(branch.instagram).pathname.split('/').filter(Boolean)[0]
  : undefined;

const visitWhatsapp = whatsappUrl(
  `${site.whatsapp.greeting} I’d like to visit the ${branch.name} branch. Could you confirm today’s hours?`,
);

/* "Hours & Directions" only where the page prints hours. */
const [longTitle, shortTitle] = hasHours
  ? [`Jewellers in ${branch.name}: Hours & Directions`, `${branch.name}: Hours & Directions`]
  : [`Gold and Diamond Jewellers in ${branch.name}`, `Jewellers in ${branch.name}`];
const title = longTitle.length <= TITLE_MAX ? longTitle : shortTitle;
const description = hasHours
  ? `${site.name} at ${branch.venue}, ${branch.city}: address, hours, phone and directions. WhatsApp us to confirm today’s hours.`
  : `${site.name} at ${branch.venue}, ${branch.city}: address, directions and what the counter offers. WhatsApp us for the shop number before you visit.`;

/** The flagship's JewelryStore is already in every page head (BaseLayout). */
const jsonLd = branch.isFlagship ? [] : [jewelryStoreSchema(branch, storeImage)];
---

<BaseLayout ground="stage" title={title} description={description} jsonLd={jsonLd}>
  <PageHead
    tone="stage"
    breadcrumbs={[
      { name: 'Branches', href: routes.stores },
      { name: branch.name, href: routes.store(branch.id) },
    ]}
    eyebrow={`${branch.emirate}${branch.isFlagship ? ' · Flagship' : ''}`}
    title={branch.name}
    lead={lead}
    layout="split"
    size="display"
  >
    <Button href={visitWhatsapp} icon="whatsapp" external>
      WhatsApp this branch
    </Button>
    {mapUrl && (
      <Button href={mapUrl} variant="secondary" icon="map-pin" external>
        Directions
      </Button>
    )}
    <div class="plate-facts" data-tone="parchment" slot="media">
      <div class="plate-facts__frame">
        {branch.isFlagship ? (
          <Icon name="c-ring" class="plate-facts__ring" />
        ) : (
          <Ornament class="plate-facts__orn" />
        )}
        <p class="plate-facts__venue">{branch.venue}</p>
        <p class="plate-facts__place eyebrow">{branch.city}</p>
      </div>
    </div>
    <div slot="aside" class="opener-route">
      <BranchDoors variant="compact" lit={branch.id} showSoon={false} />
    </div>
  </PageHead>

  <Section tone="ivory" labelledby="facts-title">
    <SectionHead
      id="facts-title"
      eyebrow="Before you set out"
      title="Finding the counter"
      shape="split"
    >
      Everything we have for this branch, as it stands on its Google listing. For anything else, a
      message is quickest.
    </SectionHead>
    <dl class="ledger">
      <div class="ledger__row">
        <dt class="ledger__term">Address</dt>
        <dd class="ledger__value">
          <address class="ledger__address">
            {addressLines.map((line) => (
              <span>{line}</span>
            ))}
            <span>{site.address.countryName}</span>
          </address>
          {(locatedIn || branch.plusCode) && (
            <dl class="ledger__sub">
              {locatedIn && (
                <div class="ledger__subrow">
                  <dt>Located in</dt>
                  <dd>{locatedIn}</dd>
                </div>
              )}
              {branch.plusCode && (
                <div class="ledger__subrow">
                  <dt>Plus code</dt>
                  <dd class="fig">{branch.plusCode}</dd>
                </div>
              )}
            </dl>
          )}
        </dd>
      </div>
      <div class="ledger__row">
        <dt class="ledger__term">{own ? 'Phone' : 'Group line'}</dt>
        <dd class="ledger__value">
          <a class="ledger__big fig" href={`tel:${phone.e164}`}>
            {phone.display}
          </a>
          {branch.mobile && (
            <p class="ledger__also">
              <span class="ledger__also-label">Mobile</span>
              <a class="ledger__big fig" href={`tel:${branch.mobile.e164}`}>
                {branch.mobile.display}
              </a>
            </p>
          )}
          {!own && (
            <p class="ledger__note">
              The group’s number: calls go to the {flagship.shortName} counter.
            </p>
          )}
        </dd>
      </div>
      <div class="ledger__row">
        <dt class="ledger__term">WhatsApp</dt>
        <dd class="ledger__value">
          <a class="ledger__big fig" href={visitWhatsapp} target="_blank" rel="noopener">
            {site.whatsapp.display}
            <span class="sr-only"> (opens WhatsApp)</span>
          </a>
          <p class="ledger__note">
            WhatsApp this branch: the quickest way to check a piece is at this counter.
          </p>
        </dd>
      </div>
      <div class="ledger__row">
        <dt class="ledger__term">Directions</dt>
        <dd class="ledger__value">
          <p>{directions}</p>
          {mapUrl && (
            <MoreLink href={mapUrl} external icon="arrow-up-right">
              Open in Google Maps
            </MoreLink>
          )}
        </dd>
      </div>
      <div class="ledger__row">
        <dt class="ledger__term">Hours</dt>
        <dd class="ledger__value">
          {hasHours ? (
            <>
              <dl class="ledger__week">
                {runs.map((run) => (
                  <div class="ledger__run" data-hours-days={run.days.join(',')}>
                    <dt class="ledger__days">{run.label}</dt>
                    <dd class="ledger__times fig">{run.text}</dd>
                  </div>
                ))}
              </dl>
              {breaks.length > 0 && (
                <ul class="ledger__breaks" role="list">
                  {breaks.map((line) => (
                    <li class="fig">{line}</li>
                  ))}
                </ul>
              )}
              {branch.hours?.note && <p class="ledger__note">{branch.hours.note}</p>}
              {caption && <p class="ledger__caption caption">{caption}</p>}
              <p class="ledger__now" data-open-now={nowData}></p>
            </>
          ) : (
            <p>Call or message for today’s hours before you set out.</p>
          )}
        </dd>
      </div>
      {rating && mapUrl && (
        <div class="ledger__row">
          <dt class="ledger__term">On Google</dt>
          <dd class="ledger__value">
            <a class="ledger__rating" href={mapUrl} target="_blank" rel="noopener">
              <span class="ledger__big fig">{rating.rating.toFixed(1)}</span>
              <span class="ledger__rating-text">
                on Google, {rating.count} reviews, {formatDate(rating.asOf)}
              </span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>
      )}
      {facilities.length > 0 && (
        <div class="ledger__row">
          <dt class="ledger__term">At the branch</dt>
          <dd class="ledger__value">
            <ul class="ledger__list" role="list">
              {facilities.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      {branch.metro && (
        <div class="ledger__row">
          <dt class="ledger__term">Nearest metro</dt>
          <dd class="ledger__value">{branch.metro}</dd>
        </div>
      )}
      {parking.length > 0 && (
        <div class="ledger__row">
          <dt class="ledger__term">Parking</dt>
          <dd class="ledger__value">{parking.join('. ')}</dd>
        </div>
      )}
      {branch.instagram && instagramHandle && (
        <div class="ledger__row">
          <dt class="ledger__term">Instagram</dt>
          <dd class="ledger__value">
            <MoreLink href={branch.instagram} external icon="arrow-up-right">
              @{instagramHandle}
            </MoreLink>
          </dd>
        </div>
      )}
    </dl>
  </Section>

  <Section tone="parchment" id="visit" labelledby="visit-title">
    <SectionHead
      id="visit-title"
      eyebrow="Book a visit"
      title="Tell us when"
      accent="you are coming"
      shape="split"
    >
      Choose the day and what you would like to see, and send it on WhatsApp or by email. We reply
      to confirm.
    </SectionHead>
    <ContactForm variant="visit" branch={branch.id} />
  </Section>

  <Section tone="stage" seam labelledby="doors-title">
    <SectionHead
      id="doors-title"
      eyebrow="Branches"
      title="Every door,"
      accent="west to east"
      shape="split"
    >
      <MoreLink href={routes.stores} slot="aside">
        All branches
      </MoreLink>
    </SectionHead>
    <BranchDoors variant="compact" />
  </Section>
</BaseLayout>

<script src="@/scripts/open-now.ts"></script>

<style>
  /* ---------- The facts plate: a parchment nameplate until branch photographs exist ---------- */
  .plate-facts {
    container-type: inline-size;
    aspect-ratio: 3 / 2;
    margin: 0;
    padding: var(--space-3);
    background: var(--ground);
  }

  .plate-facts__frame {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    block-size: 100%;
    padding: var(--space-5);
    border: 1px solid var(--rule-strong);
    text-align: center;
  }

  .plate-facts :global(.plate-facts__ring) {
    inline-size: var(--space-7);
    block-size: var(--space-7);
    color: var(--wipe);
  }

  .plate-facts :global(.plate-facts__orn) {
    inline-size: var(--space-8);
    block-size: var(--space-3);
  }

  .plate-facts__venue {
    max-inline-size: 18ch;
    font-family: var(--ff-display);
    font-size: min(var(--t-h2), 10cqi);
    font-style: italic;
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    color: var(--fg);
    text-wrap: balance;
  }

  .plate-facts__place {
    margin: 0;
  }

  .opener-route {
    margin-block-start: var(--space-3);
  }

  /* ---------- Facts ledger ---------- */
  .ledger {
    border-block-start: 1px solid var(--rule-strong);
  }

  .ledger__row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }

  .ledger__term {
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .ledger__value {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-inline-size: var(--prose);
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--fg);
  }

  .ledger__address {
    display: grid;
  }

  /* "Located in" and the plus code: a small two-column list under the address. */
  .ledger__sub {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .ledger__subrow {
    display: contents;
  }

  .ledger__subrow dt {
    color: var(--muted);
  }

  .ledger__subrow dd {
    color: var(--body);
  }

  .ledger__list {
    display: grid;
    gap: var(--space-1);
  }

  .ledger__big {
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
    text-decoration-color: var(--rule-strong);
  }

  .ledger__big:hover {
    color: var(--accent);
    text-decoration-color: var(--wipe);
  }

  /* A second number under the first, labelled. */
  .ledger__also {
    display: grid;
    gap: var(--space-1);
  }

  .ledger__also-label {
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  .ledger__note {
    max-inline-size: 48ch;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------- Hours by day ---------- */
  .ledger__week {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    inline-size: 100%;
  }

  .ledger__run {
    display: contents;
  }

  .ledger__days {
    color: var(--body);
  }

  .ledger__times {
    color: var(--fg);
  }

  /* Today's run, marked by nav.ts in Dubai time. */
  .ledger__run[data-today] .ledger__days {
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  .ledger__breaks {
    display: grid;
    gap: var(--space-1);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--body);
  }

  .ledger__caption {
    margin: 0;
  }

  /* Written by open-now.ts: the line keeps its height so nothing below it moves when it fills. */
  .ledger__now {
    min-block-size: calc(var(--t-lead) * 1.55);
    color: var(--body);
  }

  .ledger__now[data-state='open'] {
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  /* ---------- Rating ---------- */
  .ledger__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    color: var(--fg);
    text-decoration: none;
  }

  .ledger__rating .ledger__big {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.16em;
  }

  .ledger__rating:is(:hover, :focus-visible) .ledger__big {
    color: var(--accent);
    text-decoration-color: var(--wipe);
  }

  .ledger__rating-text {
    color: var(--body);
  }

  @media (min-width: 64em) {
    .ledger__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      padding-block: var(--space-6);
    }

    .ledger__term {
      grid-column: 1 / span 4;
    }

    .ledger__value {
      grid-column: 5 / span 8;
    }
  }
</style>
