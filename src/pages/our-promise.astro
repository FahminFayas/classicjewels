---
/**
 * Our promise (docs/design-system-v2.md §6.15). Ivory, a reading page.
 *
 *   1. Opener, then the full promise ledger: every commitment, each row linking to its terms.
 *   2. Each promise's terms: what it covers, what it does not, how to claim it. The returns terms
 *      print site.returnPolicy verbatim with its statutory line, as the terms page does.
 *   3. Questions, then an enquiry band.
 *
 * The exchange promise keeps its site.ts title ("no weight deduction") only once the owner has
 * confirmed the terms (site.exchange.confirmed). Until then it reads "Old gold exchanged at the
 * day's rate", the "no weight deduction" line is left out of its terms, and FAQ entries that
 * promise a 0% or no deduction are not shown. Facts about the law come from
 * docs/research/facts-and-sources.md; anything the owner has not confirmed is phrased as "ask in
 * store".
 */
import AssuranceLedger from '@/components/sections/AssuranceLedger.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import Faq from '@/components/sections/Faq.astro';
import Icon from '@/components/ui/Icon.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqGroup } from '@/lib/content';
import { countWord } from '@/lib/format';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { DISPLAY_KARATS, KARAT_FACTS } from '@/lib/tones';
import { whatsappUrl } from '@/lib/whatsapp';

const faq = await getFaqGroup('our-promise');
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();

const days = site.returnPolicy.days;
const confirmed = site.exchange.confirmed;

/** The promises as shown: the exchange title waits for the owner's confirmation. */
const promises = site.promises.map((p) =>
  p.id === 'gold-exchange' && !confirmed
    ? { ...p, title: 'Old gold exchanged at the day’s rate' }
    : p,
);

/** FAQ entries that promise a deduction-free exchange wait for the same confirmation. */
const faqItems = confirmed
  ? faq.data.items
  : faq.data.items.filter((item) => !/deduction/i.test(`${item.question} ${item.answer}`));

interface Terms {
  covers: string[];
  excludes: string[];
  claim: string[];
  links?: { label: string; href: string }[];
}

/*
 * Scope is phrased generically until the owner signs off the exact terms (launch checklist item 9):
 * no "every branch", no free repairs or re-plating, and the exchange scope is something to ask
 * about. The return wording is site.returnPolicy, verbatim, as on the terms page.
 */
const terms: Record<string, Terms> = {
  'certified-diamonds': {
    covers: [
      'Every diamond we sell is tested on an instrument at the counter before it is sold. Ask to watch the test.',
      'Larger diamonds come with a grading report from an independent laboratory, stating carat, colour, clarity and cut.',
      'Keep the report with your invoice. A return or an exchange of a stone with a report needs both.',
    ],
    excludes: [
      'The counter test shows that a stone is a diamond; it is not a grading. Only the laboratory report states carat, colour, clarity and cut.',
      'Small stones and melee are sold tested, not certified. Ask in store which stones in a piece carry a report.',
      'The laboratory varies by stone. Ask which laboratory issued the report for the piece you are considering, and check the report number on that laboratory’s own website.',
      'Stones bought elsewhere: ask in store whether we can test them for you.',
    ],
    claim: [
      'Ask to see the test at the counter before you pay.',
      'For a stone with a report, ask for the report and check its number against the laboratory’s verification page.',
      'If a question comes up later, bring the piece, the invoice and the report to the branch that sold it, or WhatsApp us with the invoice number.',
    ],
    links: [{ label: 'Diamond jewellery', href: routes.diamonds }],
  },
  'hallmark-916': {
    covers: [
      'Every piece of gold jewellery we sell carries a hallmark, as UAE Federal Law No. 11 of 2015 requires. 22K is stamped 916: 916 parts per thousand, or 91.6% gold.',
      '18K is stamped 750, 21K 875 and 24K 999. The stamp is applied after assay, so the purity is verified rather than promised.',
      'Your invoice states the weight and the fineness of what you bought. In Dubai, jewellers and their scales are inspected by Dubai Municipality’s Dubai Central Laboratory.',
    ],
    excludes: [
      'Pieces under one gram of gold are exempt from stamping under the law, and a piece too small to stamp comes with an identification card instead.',
      'The hallmark certifies the gold, not the stones set in it, and not the weight. Stones are covered by the diamond promise; the weight is on the invoice.',
      'Plating and surface finishes are not part of the hallmark. A rhodium finish on white gold is a coating over the stamped gold.',
    ],
    claim: [
      'Ask to see the stamp before you pay. On a very small piece, ask for the identification card.',
      'If you ever doubt a piece we sold, bring it with the invoice to the branch that sold it and we will test it in front of you.',
      'Any piece can also be tested independently by Dubai Municipality’s Dubai Central Laboratory.',
    ],
    links: [{ label: 'Today’s rate by karat', href: routes.goldRate }],
  },
  'lifetime-maintenance': {
    covers: [
      'Cleaning, polishing and a check of the settings on a piece bought from us, for as long as you own it.',
      'Bring the piece in whenever it looks dull or a setting feels loose; we tell you what we find before any other work is done.',
    ],
    excludes: [
      'Repairs, re-plating, resizing, remodelling and replacing a lost stone are separate work, quoted before we start.',
      'Surface finishes wear with daily use: rhodium on white gold, matte and antique finishes. Restoring a finish is re-plating, quoted separately.',
      'Accidental damage, and alterations made by another jeweller: ask in store before you assume these are covered.',
      'Wear of a finish is not a defect. Your rights for a genuinely defective piece under UAE consumer law are separate and unaffected.',
    ],
    claim: [
      'Bring the piece and, if you have it, the invoice to the branch that sold it, or WhatsApp us to ask which counter to bring it to.',
      'Tell us what you have noticed: a dull finish, a loose stone, a bent clasp.',
      'Message us on WhatsApp first if you want to know whether the work you have in mind is cleaning and polishing or a quoted repair.',
    ],
    links: [{ label: 'Remaking old jewellery', href: routes.customJewellery }],
  },
  'gold-exchange': {
    covers: [
      'Old gold is tested and weighed in front of you and credited by weight at the day’s rate for its karat against a new piece.',
      ...(confirmed
        ? [
            'No weight deduction: the credit is the weight the scale shows, at the rate for the karat the test shows.',
          ]
        : []),
      `The Classic Group has been ${site.group.experience}; we price old gold the way traders do.`,
    ],
    excludes: [
      'Ask whether a promotion or the type of gold changes the terms, for example for gold bought elsewhere.',
      'The credit is against a new piece. Terms for a cash sale of old gold differ; ask before you come in.',
      'Making charges and 5% VAT apply to the new piece as normal. The credit covers the gold value only.',
      'Stones and non-gold parts are not gold weight. Ask in store how stones in an old piece are treated before it is weighed.',
    ],
    claim: [
      'Bring the gold to a branch with photo identification (Emirates ID or passport), and the receipt if you have it.',
      'Watch the test and the weighing, and ask for the weight and the rate used to be shown on the new invoice.',
      'If you want an idea before you travel, WhatsApp first with the karat stamped on the piece and its approximate weight.',
    ],
    links: [
      { label: 'How gold exchange works', href: routes.goldExchange },
      { label: 'Today’s rate', href: routes.goldRate },
    ],
  },
  returns: {
    covers: [
      site.returnPolicy.text,
      site.returnPolicy.statutory,
      'Under that law a defective item must be repaired, replaced or refunded.',
    ],
    excludes: [
      'Customised, engraved and resized pieces, which are exchange-only.',
      'Pieces that have been worn, altered or damaged.',
      'Coins, bars and deposits on a booked rate: ask in store how these are treated, before you buy.',
    ],
    claim: [
      `Bring the piece and the invoice, with the certificate where one was issued, to the branch that sold it within ${days} days of purchase.`,
      'Tell us whether you want a refund or an exchange. If how a refund is paid matters to you, ask in store before you buy.',
      `For a defective piece at any time, bring it in with the invoice; your statutory rights apply regardless of the ${days} days.`,
    ],
    links: [{ label: 'Terms of use', href: routes.terms }],
  },
  'easy-exchange': {
    covers: [
      'A piece bought from us can be exchanged for a different design from our trays. Its gold is credited by weight at the day’s rate for its karat against the new piece.',
      'Customised, engraved and resized pieces, which cannot be returned, can be exchanged this way.',
      'No forms. Bring the piece and the invoice.',
    ],
    excludes: [
      'The credit covers the gold value. Ask in store how the making charge and VAT paid on the original piece are treated; making charges and VAT apply to the new piece.',
      'Diamond and stone-set pieces: the stones are valued separately from the gold. Ask in store how a stone-set piece is credited before you buy.',
      'Pieces altered by another jeweller: ask in store before you bring them in.',
    ],
    claim: [
      'Bring the piece and its invoice to the branch that sold it and choose the new design. Ask on WhatsApp if another branch suits you better.',
      'We weigh the old piece and credit its gold at the day’s rate. Any difference is paid at the counter; if the new piece is lighter, ask in store how the balance is handled.',
      'Want an idea first? Message us on WhatsApp with the invoice number and the piece you have in mind.',
    ],
    links: [{ label: 'All jewellery', href: routes.jewellery }],
  },
};

const rows = promises.map((p, i) => {
  const t = terms[p.id];
  if (!t) throw new Error(`No terms written for promise "${p.id}" on /our-promise/`);
  return { p, t, no: String(i + 1).padStart(2, '0') };
});

/** Fineness table for the hallmark section: 24K to 18K, as stamped. */
const stampRows = DISPLAY_KARATS.map((k) => KARAT_FACTS[k]);

const jsonLd = [
  itemListSchema(
    promises.map((p) => ({
      name: p.title,
      url: `${new URL(routes.promise, origin).toString()}#${p.id}`,
    })),
    'Our promises',
  ),
];

const ask = whatsappUrl(
  `${site.whatsapp.greeting} I have a question about your terms before I buy.`,
);

const title = 'Our Promises: Hallmark, Diamonds, Returns and Exchange';
const description = `${countWord(site.promises.length)} written commitments: the UAE hallmark, tested diamonds, ${days}-day returns, cleaning for life and old gold credited by weight. Ask on WhatsApp.`;
---

<BaseLayout ground="ivory" title={title} description={description} jsonLd={jsonLd}>
  <PageHead
    tone="ivory"
    breadcrumbs={[{ name: 'Our promise', href: routes.promise }]}
    eyebrow="Our promise"
    title="Our terms,"
    accent="in writing"
    lead={`${countWord(promises.length)} commitments, each with what it covers, what it does not and how to claim it. If a term is unclear for your piece, ask before you buy.`}
  />

  <Section tone="ivory" class="promise-ledger">
    <h2 class="sr-only">The commitments</h2>
    <AssuranceLedger variant="full" />
  </Section>

  <Section tone="ivory" ruled labelledby="full-title">
    <SectionHead
      id="full-title"
      eyebrow="The terms in full"
      title="What each one covers"
      shape="split"
    >
      What is included, what is not, and what to bring when you claim it.
    </SectionHead>
    {rows.map(({ p, t, no }) => (
      <article class="promise" id={p.id} aria-labelledby={`${p.id}-title`}>
        <div class="promise__head">
          <span class="promise__no fig" aria-hidden="true">
            {no}
          </span>
          <h3 class="promise__title" id={`${p.id}-title`}>
            {p.title}
          </h3>
          <p class="promise__detail">{p.detail}</p>
        </div>
        <div class="terms">
          <div class="terms__block">
            <h4 class="terms__title">What it covers</h4>
            <ul class="terms__list" role="list">
              {t.covers.map((item) => (
                <li>
                  <span class="terms__mark" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="terms__block">
            <h4 class="terms__title">What it does not cover</h4>
            <ul class="terms__list" role="list">
              {t.excludes.map((item) => (
                <li>
                  <Icon name="minus" class="terms__glyph" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="terms__block">
            <h4 class="terms__title">How to claim it</h4>
            <ol class="terms__list" role="list">
              {t.claim.map((item, i) => (
                <li>
                  <span class="terms__step fig" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
        {p.id === 'hallmark-916' && (
          <div class="stamp">
            <h4 class="terms__title">Reading the stamp</h4>
            <table class="stamp__table">
              <caption class="sr-only">Karat, fineness stamp and gold content</caption>
              <thead>
                <tr>
                  <th scope="col">Karat</th>
                  <th scope="col">Stamp</th>
                  <th scope="col">Gold content</th>
                </tr>
              </thead>
              <tbody>
                {stampRows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    <td class="fig stamp__n">{r.stamp}</td>
                    <td class="fig">{r.percent}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="caption">
              Parts per thousand of gold, as stamped under UAE Federal Law No. 11 of 2015; in Dubai,
              inspected by Dubai Municipality’s Dubai Central Laboratory.
            </p>
          </div>
        )}
        {t.links && (
          <p class="promise__links">
            {t.links.map((l) => (
              <MoreLink href={l.href}>{l.label}</MoreLink>
            ))}
          </p>
        )}
      </article>
    ))}
  </Section>

  <Section tone="ivory" ruled>
    <Faq heading={faq.data.heading} items={faqItems} />
  </Section>

  <EnquiryBand
    title="Ask about a term"
    accent="before you buy"
    text="Tell us the piece and the question. We reply with the terms that apply to it."
    whatsappUrl={ask}
    secondary={{ href: routes.stores, label: 'Find a branch' }}
  />
</BaseLayout>

<style>
  :global(.sec.promise-ledger) {
    padding-block-start: 0;
  }

  .promise {
    scroll-margin-block-start: calc(var(--header-h) + var(--space-5));
  }

  .promise + .promise {
    margin-block-start: var(--space-9);
  }

  .promise__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    align-items: baseline;
    margin-block-end: var(--space-6);
  }

  .promise__no {
    min-inline-size: 2ch;
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1;
    color: var(--numeral);
  }

  .promise__title {
    font-size: var(--t-h3);
  }

  .promise__detail {
    grid-column: 2;
    max-inline-size: 52ch;
    color: var(--body);
  }

  @media (min-width: 64em) {
    .promise__head {
      grid-template-columns: auto minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--grid-gap);
    }

    .promise__detail {
      grid-column: 3;
    }
  }

  /* Three ruled blocks: one column on phones, three with hairlines between on wide screens. */
  .terms {
    display: grid;
    border-block-start: 1px solid var(--rule-strong);
  }

  .terms__block {
    min-inline-size: 0;
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }

  .terms__title {
    margin-block-end: var(--space-4);
    font-family: var(--ff-text);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .terms__list {
    display: grid;
    gap: var(--space-3);
    color: var(--body);
  }

  .terms__list li {
    display: grid;
    grid-template-columns: var(--space-5) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  /* The covered mark: the small turned square used for stations and selections. */
  .terms__mark {
    inline-size: var(--space-2);
    block-size: var(--space-2);
    margin-block-start: 0.55em;
    margin-inline-start: var(--space-1);
    background: var(--wipe);
    rotate: 45deg;
  }

  .terms :global(.terms__glyph) {
    inline-size: var(--space-4);
    block-size: var(--space-4);
    margin-block-start: 0.2em;
    color: var(--muted);
  }

  .terms__step {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.1;
    color: var(--numeral);
  }

  .stamp {
    margin-block-start: var(--space-7);
    max-inline-size: 32rem;
  }

  .stamp__table {
    font-size: var(--t-small);
    border-block: 1px solid var(--rule-strong);
  }

  .stamp__table th,
  .stamp__table td {
    padding-block: var(--space-3);
    padding-inline: var(--space-3);
    text-align: start;
    border-block-end: 1px solid var(--rule);
  }

  .stamp__table th {
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  .stamp__n {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    color: var(--numeral);
  }

  .stamp .caption {
    margin-block-start: var(--space-3);
  }

  .promise__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 64em) {
    .terms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .terms__block {
      padding-inline-end: var(--space-6);
    }

    .terms__block + .terms__block {
      padding-inline-start: var(--space-6);
      border-inline-start: 1px solid var(--rule);
    }
  }
</style>
