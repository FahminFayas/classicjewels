---
/**
 * One campaign offer (docs/design-system-v2.md §6.14). Ivory.
 *
 *   1. Opener: "Until {endsOn}", the headline as the H1 (the clause after its colon in italic),
 *      the summary, "Ask on WhatsApp" and "Find a branch".
 *   2. The offer: the body beside its terms as a numbered, ruled list, and where it applies.
 *   3. When the offer is about the rate (Diwali: "book the rate"), today's rate on the stage.
 *   4. Questions, then an enquiry band.
 *
 * Only offers that are live today are built, so an expired campaign disappears with its next
 * build.
 */
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import Faq from '@/components/sections/Faq.astro';
import RateInstrument from '@/components/sections/RateInstrument.astro';
import Button from '@/components/ui/Button.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { branches, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveOffers, getFaqGroup } from '@/lib/content';
import { formatDate, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { whatsappUrl } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const offers = await getActiveOffers();
  return offers.map((offer) => ({ params: { slug: offer.id }, props: { offer } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { offer } = Astro.props;
const { data } = offer;
const [faq, rates, { Content }] = await Promise.all([
  getFaqGroup('offers'),
  getRates(),
  render(offer),
]);

const isoDate = (d: Date) => d.toISOString().slice(0, 10);

/* The end date set large beside the opener: "10" over "November 2026". */
const endDay = formatDate(data.endsOn, { month: undefined, year: undefined });
const endMonth = formatDate(data.endsOn, { day: undefined });
const startLabel = formatDate(data.startsOn, {
  year: data.startsOn.getFullYear() === data.endsOn.getFullYear() ? undefined : 'numeric',
});

/* Short names ("Deira, Safari Mall and Rolla Mall"): full names carry commas of their own. */
const branchName = new Map(branches.map((b) => [b.id, b.shortName]));
const where =
  data.branches.length > 0
    ? data.branches.map((id) => branchName.get(id) ?? id)
    : openBranches.map((b) => b.shortName);

/* "Diwali 2026: book the rate, no making charge on selected pieces." -> lead + italic clause. */
const headline = data.headline.trim().replace(/[.!]$/, '');
const colon = headline.indexOf(':');
const lead = colon > 0 ? headline.slice(0, colon + 1) : headline;
const clause = colon > 0 ? headline.slice(colon + 1).trim() : undefined;

/** An offer about the rate itself (booking it, locking it) shows today's rate. */
const aboutRate = /\brate\b/i.test(`${data.headline} ${data.summary}`);

const whatsapp = whatsappUrl(
  data.whatsappMessage ??
    `${site.whatsapp.greeting} I’d like to know more about the offer “${data.headline}”.`,
);
---

<BaseLayout ground="ivory" title={data.title} description={data.description}>
  <PageHead
    tone="ivory"
    breadcrumbs={[
      { name: 'Offers', href: routes.offers },
      { name: headline, href: routes.offer(offer.id) },
    ]}
    eyebrow={`Until ${formatDate(data.endsOn)}`}
    title={lead}
    accent={clause}
    lead={data.summary}
    layout="split"
  >
    <Button href={whatsapp} icon="whatsapp" external>
      Ask on WhatsApp
    </Button>
    <Button href={routes.stores} variant="secondary" icon="map-pin">
      Find a branch
    </Button>
    <p class="until" slot="aside">
      <span class="until__label eyebrow">The last day</span>
      <span class="until__day fig">{endDay}</span>
      <span class="until__month">{endMonth}</span>
      <span class="until__from">From {startLabel}</span>
    </p>
  </PageHead>

  <Section tone="ivory" ruled labelledby="terms-title">
    <div class="offer">
      <div class="offer__body prose">
        <Content />
      </div>
      <div class="offer__terms">
        <h2 class="offer__heading" id="terms-title">
          The terms
        </h2>
        <ol class="terms" role="list">
          {data.terms.map((term, i) => (
            <li class="terms__row">
              <span class="terms__no fig" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="terms__text">{term}</p>
            </li>
          ))}
        </ol>
        <p class="offer__valid">
          Valid until <time datetime={isoDate(data.endsOn)}>{formatDate(data.endsOn)}</time>.
          Available at {listWords(where)}.
        </p>
      </div>
    </div>
  </Section>

  {aboutRate && (
    <Section tone="stage" labelledby="rate-title">
      <SectionHead
        id="rate-title"
        eyebrow="Today"
        title="The rate"
        accent="you would book"
        shape="split"
      >
        The posted rate per gram, before making charges and 5% VAT. Ask us to confirm it on the day
        you book.
        <MoreLink href={routes.goldRate} slot="aside">
          Today’s gold rate
        </MoreLink>
      </SectionHead>
      <RateInstrument
        rate={rates.latest}
        stale={rates.stale}
        fetchedAt={rates.fetchedAt}
        variant="compact"
        id="offer-rate"
      />
    </Section>
  )}

  <Section tone="ivory">
    <Faq heading={faq.data.heading} items={faq.data.items} />
  </Section>

  <EnquiryBand
    title="Ask about"
    accent="this offer"
    text="Tell us which branch you plan to visit and we will confirm which pieces qualify."
    whatsappUrl={whatsapp}
    secondary={{ href: routes.stores, label: 'Find a branch' }}
  />
</BaseLayout>

<style>
  .until {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule-strong);
  }

  .until__day {
    font-family: var(--ff-display);
    font-size: var(--t-stamp);
    font-weight: var(--fw-display);
    line-height: var(--lh-numeral);
    letter-spacing: var(--track-rate);
    color: var(--numeral);
  }

  .until__month {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
  }

  .until__from {
    font-size: var(--t-small);
    color: var(--muted);
  }

  .offer {
    display: grid;
    gap: var(--space-8);
  }

  .offer__body {
    font-size: var(--t-lead);
    line-height: 1.6;
  }

  .offer__heading {
    margin-block-end: var(--space-5);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
  }

  .terms {
    border-block-start: 1px solid var(--rule-strong);
  }

  .terms__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--rule);
  }

  .terms__no {
    min-inline-size: 2ch;
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    color: var(--numeral);
  }

  .terms__text {
    color: var(--body);
  }

  .offer__valid {
    margin-block-start: var(--space-5);
    font-size: var(--t-small);
    color: var(--muted);
  }

  @media (min-width: 64em) {
    .offer {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: calc(var(--grid-gap) * 2);
    }
  }
</style>
