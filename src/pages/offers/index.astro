---
/**
 * Offers (docs/design-system-v2.md §6.14). Ivory. Each offer running today is a campaign line
 * (the end date, the headline with its italic clause, "See the offer", "Ask on WhatsApp") with
 * its summary under it. An offer past its end date is not built and CampaignLine checks the dates
 * again, so the page can only ever show what is actually on. With nothing running it says so and
 * points to the day's rate. Either way the page ends at a person.
 */
import CampaignLine from '@/components/sections/CampaignLine.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import { branches, emirates, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveOffers } from '@/lib/content';
import { formatDate, listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { clampDescription } from '@/lib/seo';
import { whatsappGoldRate, whatsappUrl } from '@/lib/whatsapp';

const offers = await getActiveOffers();

const branchName = new Map(branches.map((b) => [b.id, b.shortName]));
/** Branches an offer is limited to ("Deira and Safari Mall"), or "every branch" when none are named. */
const whereFor = (ids: string[]) =>
  ids.length > 0 ? listWords(ids.map((id) => branchName.get(id) ?? id)) : 'every branch';

const first = offers[0];
const description = clampDescription(
  first
    ? `On now, until ${formatDate(first.data.endsOn)}: ${first.data.headline.replace(/[.!]?$/, '.')} Offers apply in store at every branch unless stated. Ask us on WhatsApp.`
    : 'Campaign offers at Classic Jewels & Diamonds run for a stated period and apply in store at every branch. See what is on now, or WhatsApp us to ask.',
);
const enquiry = whatsappUrl(
  first?.data.whatsappMessage ??
    `${site.whatsapp.greeting} is there an offer running at the moment?`,
);
---

<BaseLayout
  ground="ivory"
  title={`Gold Jewellery Offers in ${listWords(emirates)}`}
  description={description}
>
  <PageHead
    tone="ivory"
    breadcrumbs={[{ name: 'Offers', href: routes.offers }]}
    eyebrow="Offers"
    title="Current offers"
    lead="Campaign offers run for a stated period and apply in store at every branch unless the offer says otherwise."
  />

  {offers.length > 0 ? (
    offers.map((o) => (
      <>
        <CampaignLine offer={o} tone="ivory" headingLevel="h2" />
        <Section tone="ivory" pad="slim" class="offer-summary">
          <div class="summary">
            <p class="summary__text">{o.data.summary}</p>
            <p class="summary__where">
              Applies at {whereFor(o.data.branches)}. The terms are on the offer page.
            </p>
          </div>
        </Section>
      </>
    ))
  ) : (
    <Section tone="ivory" pad="slim" class="offer-summary">
      <div class="summary">
        <p class="summary__text">No offers are running today. Ask us about the day’s rate.</p>
        <MoreLink href={routes.goldRate}>Today’s gold rate</MoreLink>
      </div>
    </Section>
  )}

  {offers.length > 0 ? (
    <EnquiryBand
      title="Ask which pieces"
      accent="qualify"
      text="Tell us which offer and which branch, and we will confirm what qualifies before you visit."
      whatsappUrl={enquiry}
      secondary={{ href: routes.stores, label: 'Find a branch' }}
    />
  ) : (
    <EnquiryBand
      title="Ask for"
      accent="today’s rate"
      text="We reply with the rate for the karat you want and the making charge for the piece."
      whatsappUrl={whatsappGoldRate()}
      secondary={{ href: routes.goldRate, label: 'Today’s gold rate' }}
    />
  )}
</BaseLayout>

<style>
  /* The campaign rows sit on the opener's ivory: a hairline marks where each one starts. */
  :global(.sec.campaign[data-tone='ivory']) {
    border-block-start: 1px solid var(--rule);
  }

  :global(.sec.offer-summary) {
    padding-block-start: 0;
  }

  .summary {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--rule);
  }

  .summary__text {
    max-inline-size: var(--measure);
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--body);
  }

  .summary__where {
    font-size: var(--t-small);
    color: var(--muted);
  }

  @media (min-width: 64em) {
    .summary {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .summary > * {
      grid-column: 1 / span 7;
    }
  }
</style>
