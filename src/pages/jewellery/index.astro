---
/**
 * The catalogue (/jewellery/), docs/design-system-v2.md §6.2. Opens on the stage like the shop
 * after dark: the velvet pieces lit in their cases, then the counter by daylight.
 *
 *   1  Opener (stage): eyebrow, H1, one-sentence lead, then the filters (karat chips with
 *      today's rate, style chips, sort) driving both grids.
 *   2  On the velvet (stage): every velvet piece in a lit wall, filterable. A catalogue, not a
 *      moment, so no stagger.
 *   3  By piece (ivory): one plate per category, a rail on phones.
 *   4  From the trays (ivory, ruled): every studio cut-out on its lilac counter, filterable.
 *   5  Ask what we have in the cases today (plum, seam).
 *
 * The filters keep one canonical URL (hash state); a grid's section hides when nothing in it
 * matches. Without JavaScript the filter block lists the category pages instead.
 */
import CaseWall from '@/components/sections/CaseWall.astro';
import CategoryPlate from '@/components/sections/CategoryPlate.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import Filters from '@/components/sections/Filters.astro';
import PlateGrid from '@/components/sections/PlateGrid.astro';
import Icon from '@/components/ui/Icon.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  collectionShortNames,
  getCategories,
  getDesignCollections,
  getProducts,
  photoGround,
  splitByGround,
} from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { whatsappGeneral } from '@/lib/whatsapp';

const [categories, products, collections, rates] = await Promise.all([
  getCategories(),
  getProducts(),
  getDesignCollections(),
  getRates(),
]);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const rate = rates.latest;
const { velvet, lilac } = splitByGround(products);
const names = collectionShortNames(collections);

/** Facets present across both grids, in the order the counter reads them. */
const karats = [22, 21, 18, 24].filter((k) => products.some((p) => p.data.karat === k));
const stylesPresent = collections
  .filter((c) => products.some((p) => p.data.collection?.id === c.id))
  .map((c) => ({ id: c.id, name: c.data.shortName }));
const categoryLinks = categories.map((c) => ({ id: c.id, name: c.data.shortName ?? c.data.name }));

/** One plate per category: its first piece photographed on the category's own ground. */
const trays = categories.map((category) => {
  const items = products.filter((p) => p.data.category.id === category.id);
  const pick = items.find((p) => photoGround(p) === category.data.ground);
  return { category, image: pick?.data.images[0]?.src, count: items.length };
});

const jsonLd = [
  itemListSchema(
    products.map((p) => ({
      name: p.data.name,
      url: new URL(routes.product(p.data.category.id, p.id), origin).toString(),
      image: p.data.images[0] ? new URL(p.data.images[0].src.src, origin).toString() : undefined,
    })),
    'Gold and diamond jewellery',
  ),
];
---

<BaseLayout
  ground="stage"
  title="Gold & Diamond Jewellery in Dubai, Sharjah & Abu Dhabi"
  description={`22K and 18K hallmarked gold, tested diamonds and 24K coins, each listed with its karat and hallmark. Priced at today’s Dubai rate across our branches.`}
  jsonLd={jsonLd}
>
  <PageHead
    tone="stage"
    id="catalogue"
    layout="split"
    breadcrumbs={[{ name: 'Jewellery', href: routes.jewellery }]}
    eyebrow="Jewellery"
    title="Gold and diamond jewellery,"
    accent="by the gram"
    lead={`Prices follow today’s Dubai rate plus a making charge quoted for each piece, at our branches in ${listWords(emirates)}.`}
  >
    <Fragment slot="aside">
      <Filters
        grids={['grid-velvet', 'grid-studio']}
        total={products.length}
        karats={karats}
        collections={stylesPresent}
        categories={categoryLinks}
        rate={rate}
      />
    </Fragment>
  </PageHead>

  {velvet.length > 0 && (
    <Section tone="stage" seam class="cases" labelledby="velvet-title">
      <h2 id="velvet-title" class="cases__title eyebrow">
        On the velvet
        <span class="cases__count fig">
          {countWord(velvet.length)} {velvet.length === 1 ? 'piece' : 'pieces'}
        </span>
      </h2>
      <CaseWall
        products={velvet}
        rate={rate}
        collectionNames={names}
        layout="grid"
        columns={3}
        light="static"
        id="grid-velvet"
        filterable
      />
    </Section>
  )}

  <Section tone="ivory" labelledby="trays-title">
    <SectionHead id="trays-title" title="By piece" shape="split" class="reveal">
      Necklaces to coins and bars: one tray for each kind of piece.
    </SectionHead>
    <div class="trays rail-wrap">
      <ul class="trays__list rail" role="list">
        {trays.map((t) => (
          <li class="trays__cell">
            <CategoryPlate category={t.category} image={t.image} count={t.count} />
          </li>
        ))}
      </ul>
      <div class="rail__progress trays__progress" aria-hidden="true"></div>
      <div class="trays__nav">
        <button type="button" class="trays__btn" data-rail-prev hidden>
          <Icon name="arrow-left" label="Previous trays" />
        </button>
        <button type="button" class="trays__btn" data-rail-next hidden>
          <Icon name="arrow-right" label="Next trays" />
        </button>
      </div>
    </div>
  </Section>

  {lilac.length > 0 && (
    <Section tone="ivory" ruled labelledby="studio-title">
      <SectionHead id="studio-title" title="From the trays" shape="split" class="reveal">
        Photographed in the studio on their own ground. Each is weighed and quoted at the counter.
      </SectionHead>
      <PlateGrid
        products={lilac}
        rate={rate}
        collectionNames={names}
        columns={4}
        id="grid-studio"
        filterable
      />
    </Section>
  )}

  <EnquiryBand
    title="Ask what we have"
    accent="in the cases today"
    text="We photograph a few pieces; the trays hold many more. Tell us the piece, the karat or the budget and we will send what we have."
    whatsappUrl={whatsappGeneral()}
    secondary={{ href: routes.stores, label: 'Find a branch' }}
  />
</BaseLayout>

<style>
  /*
   * 1 and 2 are one room: the opener ends at its filter bar and the wall follows without a
   * second section gap, so the first cases are lit within the first screen.
   */
  :global(#catalogue.phead) {
    padding-block-end: 0;
  }

  @media (min-width: 64em) {
    :global(#catalogue .phead__grid) {
      margin-block-start: var(--space-7);
    }
  }

  /* ---------- 2. The velvet wall ---------- */
  :global(.sec.cases) {
    padding-block-start: var(--space-7);
  }

  .cases__title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
  }

  .cases__count {
    color: var(--muted);
  }

  /* ---------- 3. By piece: one counter of nine trays ---------- */
  .trays {
    min-inline-size: 0;
  }

  .trays__list {
    --rail-card: 44%;
    gap: 1px;
    margin-inline: calc(var(--gutter) * -1);
  }

  .trays__cell {
    min-inline-size: 0;
  }

  .trays__progress {
    margin-inline: 0;
  }

  .trays__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .trays__nav:not(:has(:not([hidden]))) {
    display: none;
  }

  .trays__btn {
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--btn-line);
    color: var(--btn-line-fg);
  }

  .trays__btn:disabled {
    border-color: var(--rule);
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .trays__list {
      --rail-card: 22%;
    }
  }

  /* Desktop: the nine trays in one row across the wide track. */
  @media (min-width: 75em) {
    .trays__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(9, minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .trays__progress,
    .trays__nav {
      display: none;
    }
  }
</style>
