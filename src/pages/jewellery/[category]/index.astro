---
/**
 * A category (/jewellery/{category}/), docs/design-system-v2.md §6.3. The ground follows the
 * category's photographs (content `ground`):
 *
 *   velvet (necklaces)  opens on the stage: the name at display size in italic, the intro, and a
 *                       small salon of the first three pieces lit at 300 px (the first is the
 *                       priority image); then the filters and the lit wall (stage).
 *   studio, several     opens on ivory with the first cut-out on its lilac plate at native width;
 *                       then the filters and the lilac counter (PlateGrid).
 *   studio, one piece   the opener's plate is that piece (a link, with its name, today's rate and
 *                       WhatsApp beneath), so the same photograph is never shown twice; no
 *                       filters, and the honest line "One piece photographed so far."
 *   nothing yet         (coins and bars) a typeset parchment square with the name and today's
 *                       rate for the category's karat; never a borrowed photograph.
 *
 * Then the buying notes for the category (three short numbered notes) and the enquiry band.
 * No FAQ on category pages.
 */
import type { InferGetStaticPropsType } from 'astro';

import CaseWall from '@/components/sections/CaseWall.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import Filters from '@/components/sections/Filters.astro';
import PlateGrid from '@/components/sections/PlateGrid.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Plate from '@/components/ui/Plate.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import StageImage from '@/components/ui/StageImage.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  collectionShortNames,
  getCategories,
  getDesignCollections,
  getProductsByCategory,
  productPath,
  splitByGround,
} from '@/lib/content';
import { formatKarat } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { TITLE_MAX } from '@/lib/seo';
import { KARAT_FACTS, toDisplayKarat, type DisplayKarat } from '@/lib/tones';
import { whatsappForProduct, whatsappForRange, whatsappUrl } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { category } = Astro.props as Props;
const { data } = category;

const [products, categories, collections, rates] = await Promise.all([
  getProductsByCategory(category.id),
  getCategories(),
  getDesignCollections(),
  getRates(),
]);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const rate = rates.latest;
const names = collectionShortNames(collections);
const shortName = data.shortName ?? data.name;
const lower = shortName.toLowerCase();
const { velvet, lilac } = splitByGround(products);

/** Which opener: the ground follows the category's photographs. */
const mode =
  products.length === 0
    ? 'none'
    : data.ground === 'velvet' && velvet.length > 0
      ? 'velvet'
      : products.length === 1
        ? 'single'
        : 'studio';
const ground = mode === 'velvet' ? 'stage' : 'ivory';
const salon = velvet.slice(0, 3);
const lead = lilac[0];
const single = mode === 'single' ? products[0] : undefined;

/** Facets present, in the order the counter reads them. */
const karats = [22, 21, 18, 24].filter((k) => products.some((p) => p.data.karat === k));
const stylesHere = collections
  .filter((c) => products.some((p) => p.data.collection?.id === c.id))
  .map((c) => ({ id: c.id, name: c.data.shortName }));
const otherCategories = categories
  .filter((c) => c.id !== category.id)
  .map((c) => ({ id: c.id, name: c.data.shortName ?? c.data.name }));
const grids = [velvet.length ? 'grid-velvet' : '', lilac.length ? 'grid-studio' : ''].filter(
  Boolean,
);

/** Nothing photographed: today's rate for the karat the category is sold in (24K for bullion). */
const emptyKarat: DisplayKarat = category.id === 'gold-coins-bars' ? '24k' : '22k';
const typesetName = shortName.replace(/\s*&\s*/g, ' and ');

const title = data.title.length <= TITLE_MAX ? data.title : `${data.name} in Dubai`;
const rangeWhatsapp = whatsappForRange(`${data.name} range`);
const coinsWhatsapp = whatsappUrl(
  `${site.whatsapp.greeting} what is today’s price for gold coins and bars?`,
);

/**
 * Buying notes per category: karat, weight and making charge (from docs/research). Keyed by
 * category id; the fallback covers any category added later.
 */
const guides: Record<string, string[]> = {
  necklaces: [
    'Most necklaces here are 22K, hallmarked 916 (91.6% gold), the usual karat for Kolkata, Rajkot, temple and antique styles. Diamond-set necklaces are made in 18K (750) because the harder alloy holds a stone’s claws better.',
    'Weight is the first number to ask for. A haar carries most of a bridal set’s gold, a fine chain carries very little, so the same move in the day’s rate changes their prices very differently.',
    'The making charge is where quotes differ. Hand filigree takes more hours per gram than a machine-cut link, so ask for the charge per gram and the net gold weight as separate figures and compare those two lines across shops. VAT at 5% is added to both.',
  ],
  earrings: [
    'Jhumkas and chandbalis are 22K (916). Diamond studs and clusters are set in 18K (750): the alloy is harder and holds small stones securely. Plain hoops come in both.',
    'Earrings are light, so the gold value is usually modest and the making charge is a larger share of the price than on a bangle. Ask for the charge per gram so a pair of jhumkas and a plain hoop can be compared on the same basis.',
    'For stone-set pairs, ask for gross and net weight: the gold is priced on the net figure and the stones separately. Every diamond is tested in the shop before it is sold, and larger stones come with an independent grading report.',
  ],
  rings: [
    'Plain and engraved bands are 22K (916). Anything set with a diamond or a coloured stone is made in 18K (750), the standard alloy for claw and pavé settings because it is harder and holds the stone.',
    'A ring is priced as gold value plus making charge plus the stone, if any, with 5% VAT on the subtotal. On a band the weight does most of the work; on a solitaire the stone does, so ask for its carat weight and report alongside the gold figures.',
    'Resizing is separate work, quoted before it starts. If you are buying for someone else, bring a ring that fits them and we will measure it.',
  ],
  pendants: [
    'Religious motifs, initials and hearts are 22K (916); diamond solitaires and halos are set in 18K (750). Chains are sold separately or as a set and are weighed and priced on their own line.',
    'Pendants are among the lightest pieces in the trays, so the making charge is a larger share of the total than on a necklace. Ask for the charge per gram and the net gold weight; on a stone-set pendant the gold is priced on the net weight and the stone separately.',
    'A plain 22K pendant holds its value by weight, which makes it an easy gift to choose. Keep the invoice: it records the weight and fineness you will need for any later exchange.',
  ],
  bangles: [
    'Bangles are the piece most often bought by weight and most often exchanged later, so the karat matters: 22K, stamped 916, with the weight and fineness printed on the invoice.',
    'Plain and machine-cut bangles carry the lowest making charges in the shop because there is little hand labour per gram. Antique-finish and stone-set bangles take more hours and are charged accordingly, so compare the charge per gram across designs, not only the total.',
    'Price is net gold weight times the day’s rate, plus the making charge, plus 5% VAT, each on its own line. Bring a bangle that fits and we will match the size.',
  ],
  bracelets: [
    'Italian-style curb, rope and Figaro chains come in 22K (916) and 18K (750); diamond tennis bracelets are 18K so the settings hold. Children’s bracelets are 22K; ask for a safety clasp.',
    'A chain bracelet is priced like a chain: net weight times the day’s rate plus a making charge that depends on the link, plus 5% VAT. Machine-made links keep the charge low. A tennis bracelet is priced mostly on its stones, so ask for the carat weight and the report as well as the gold figures.',
    'Check the clasp before you decide. A box clasp with a safety catch adds little to the price and is the difference between a bracelet you keep and one you lose.',
  ],
  chains: [
    '22K (916) is the standard for a chain that will be worn daily; 18K (750) chains in the Italian style are harder-wearing and lighter in colour. Both carry the UAE hallmark and the fineness is printed on the invoice.',
    'Length and gauge set the weight, and the weight sets the price. A diamond-cut Singapore link weighs very little, so its gold value is small and the making charge is a larger share of the total; a heavy rope chain is the reverse.',
    'If the chain will carry a pendant, bring the pendant: the bail has to pass over the clasp and the chain should be able to bear the weight without stretching.',
  ],
  anklets: [
    'Anklets are 22K (916) in adult and child sizes. They are light, so the gold value is modest and the making charge, quoted per gram, is a larger share of the price than on a heavier piece.',
    'Price is net gold weight times the day’s rate, plus the making charge, plus 5% VAT, each on its own line of the invoice. A plain chain anklet carries a lower charge than one with ghungroo or charms, which need hand finishing.',
    'For a child, ask for a lobster clasp and smooth edges. For an adult, check the length on the ankle before you decide; a chain that sits too tight wears faster.',
  ],
  'gold-coins-bars': [
    'Coins are struck in 22K (916) and 24K (999). PAMP Suisse bars are 24K at 999.9 fineness and come sealed with their assay card. Ask for the premium over the day’s rate as a separate figure, so two quotes can be compared on the same basis.',
    'VAT differs by purity. Bars and coins of 99% purity or more are zero-rated under UAE VAT law; 22K coins, like jewellery, carry 5%.',
    'Check the bar’s serial number against its assay card, and keep the invoice: it records the weight, fineness and rate you will need for any later sale or exchange.',
  ],
};
const guide = guides[category.id] ?? [
  'Most pieces here are 22K, hallmarked 916 (91.6% gold); stone-set designs are made in 18K (750) because the harder alloy holds a setting better. The fineness is stamped on the piece and printed on the invoice.',
  'Price is net gold weight times the day’s rate for the karat, plus a making charge for the work, plus 5% VAT on both. Ask for the three figures as separate lines so quotes can be compared across shops.',
];

/** No ItemList for an empty tray: a list of zero items tells a search engine nothing. */
const jsonLd =
  products.length > 0
    ? [
        itemListSchema(
          products.map((p) => ({
            name: p.data.name,
            url: new URL(routes.product(category.id, p.id), origin).toString(),
            image: p.data.images[0]
              ? new URL(p.data.images[0].src.src, origin).toString()
              : undefined,
          })),
          data.name,
        ),
      ]
    : [];
const crumbs = [
  { name: 'Jewellery', href: routes.jewellery },
  { name: shortName, href: routes.category(category.id) },
];
---

<BaseLayout ground={ground} title={title} description={data.description} jsonLd={jsonLd}>
  {mode === 'velvet' && (
    <PageHead
      tone="stage"
      id="category"
      layout="split"
      size="display"
      italic
      breadcrumbs={crumbs}
      eyebrow="By piece"
      title={data.name}
      lead={data.intro}
    >
      <div slot="media" class="salon" data-count={salon.length}>
        {salon.map((p, i) => (
          <a class="salon__case" href={productPath(p)} aria-label={p.data.name}>
            <StageImage
              image={p.data.images[0]!.src}
              alt=""
              mask="spot"
              cap={300}
              priority={i === 0}
              sizes="(min-width: 64em) 300px, 33vw"
            />
          </a>
        ))}
      </div>
    </PageHead>
  )}

  {mode === 'studio' && lead && (
    <PageHead
      tone="ivory"
      id="category"
      layout="split"
      size="display"
      italic
      breadcrumbs={crumbs}
      eyebrow="By piece"
      title={data.name}
      lead={data.intro}
    >
      <div slot="media" class="counter">
        <Plate
          image={lead.data.images[0]!.src}
          alt={lead.data.images[0]!.alt}
          cap={lead.data.images[0]!.src.width}
          priority
        />
      </div>
    </PageHead>
  )}

  {mode === 'single' && single && (
    <PageHead
      tone="ivory"
      id="category"
      layout="split"
      size="display"
      italic
      breadcrumbs={crumbs}
      eyebrow="By piece"
      title={data.name}
      lead={data.intro}
    >
      <figure slot="media" class="counter counter--piece">
        <a class="counter__plate" href={productPath(single)} data-morph-href={productPath(single)}>
          <Plate
            image={single.data.images[0]!.src}
            alt={single.data.images[0]!.alt}
            cap={single.data.images[0]!.src.width}
            priority
          />
        </a>
        <figcaption class="counter__cap">
          {single.data.collection && names[single.data.collection.id] && (
            <span class="eyebrow">{names[single.data.collection.id]}</span>
          )}
          <a class="counter__name" href={productPath(single)}>
            {single.data.name}
          </a>
          <span class="counter__meta small fig">
            {formatKarat(single.data.karat)}
            {rate && (
              <>
                {' · '}
                <RateFigure rate={rate} karat={toDisplayKarat(single.data.karat)} format="aed" /> a
                gram today
              </>
            )}
          </span>
          <span class="counter__note small">One piece photographed so far. Ask us for more.</span>
          <span class="counter__acts">
            <MoreLink href={productPath(single)}>See the piece</MoreLink>
            <MoreLink
              href={whatsappForProduct({
                name: single.data.name,
                sku: single.data.sku,
                url: new URL(productPath(single), origin).toString(),
              })}
              external
              icon="whatsapp"
            >
              Ask on WhatsApp
            </MoreLink>
          </span>
        </figcaption>
      </figure>
    </PageHead>
  )}

  {mode === 'none' && (
    <PageHead
      tone="ivory"
      id="category"
      layout="split"
      size="display"
      italic
      breadcrumbs={crumbs}
      eyebrow="By piece"
      title={data.name}
      lead={data.intro}
    >
      <div slot="media" class="typeset">
        <p class="typeset__name">{typesetName}</p>
        <p class="typeset__note small">Not photographed yet.</p>
        <p class="typeset__rate">
          <span class="eyebrow">{KARAT_FACTS[emptyKarat].label} today, per gram</span>
          <RateFigure rate={rate} karat={emptyKarat} format="aed" class="typeset__fig" />
        </p>
      </div>
    </PageHead>
  )}

  {(mode === 'velvet' || mode === 'studio') && (
    <Section
      tone={mode === 'velvet' ? 'stage' : 'ivory'}
      class="pieces"
      labelledby="pieces-title"
      ruled={mode === 'studio'}
    >
      <h2 id="pieces-title" class="sr-only">
        {data.name}, photographed
      </h2>
      {products.length >= 3 && (
        <div class="pieces__filters">
          <Filters
            grids={grids}
            total={products.length}
            karats={karats}
            collections={stylesHere}
            categories={otherCategories}
            rate={rate}
          />
        </div>
      )}
      {velvet.length > 0 && (
        <CaseWall
          products={velvet}
          rate={rate}
          collectionNames={names}
          layout="grid"
          columns={3}
          id="grid-velvet"
          filterable
        />
      )}
      {mode === 'studio' && (
        <PlateGrid
          products={lilac}
          rate={rate}
          collectionNames={names}
          columns={3}
          id="grid-studio"
          filterable
        />
      )}
    </Section>
  )}

  {mode === 'velvet' && lilac.length > 0 && (
    <Section tone="ivory" labelledby="studio-title">
      <SectionHead id="studio-title" title="From the studio" shape="stack" />
      <PlateGrid
        products={lilac}
        rate={rate}
        collectionNames={names}
        columns={3}
        id="grid-studio"
        filterable
      />
    </Section>
  )}

  <Section tone={ground === 'stage' ? 'ivory' : 'parchment'} labelledby="notes-title">
    <SectionHead id="notes-title" title={`Choosing ${lower}`} shape="split" class="reveal">
      Three things to ask at the counter.
      <Fragment slot="aside">
        <MoreLink href={`${routes.goldRate}#price`}>How a price is built</MoreLink>
      </Fragment>
    </SectionHead>
    <ol class="notes" role="list">
      {guide.map((note, i) => (
        <li class="notes__item">
          <span class="notes__n fig" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="notes__text">{note}</p>
        </li>
      ))}
    </ol>
  </Section>

  {mode === 'none' && category.id === 'gold-coins-bars' ? (
    <EnquiryBand
      title="Ask which"
      accent="weights are in stock"
      text="Tell us the weight you want, in 24K or 22K, and we will reply with what the counter has today and its price at the day’s rate."
      whatsappUrl={coinsWhatsapp}
      secondary={{ href: routes.goldRate, label: 'Today’s gold rate' }}
      rate={rate}
      rateKarat="24k"
    />
  ) : (
    <EnquiryBand
      title="Ask what we have in"
      accent={`${lower} today`}
      text={`We photograph a few pieces; the ${lower} trays hold many more. Send a photo of what you have in mind, or the weight and karat, and we will reply with what is in stock.`}
      whatsappUrl={rangeWhatsapp}
      secondary={{ href: routes.stores, label: 'Find a branch' }}
    />
  )}
</BaseLayout>

<script src="@/scripts/piece-morph.ts"></script>

<style>
  /* ---------- Velvet opener: a small salon of lit cases ---------- */
  .salon {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .salon__case {
    display: block;
    min-inline-size: 0;
  }

  .salon[data-count='1'] {
    grid-template-columns: minmax(0, 1fr);
  }

  .salon[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Three: two above, one below between them, the pools of light overlapping. */
  .salon[data-count='3'] {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .salon[data-count='3'] .salon__case:nth-child(1) {
    grid-column: 1 / span 2;
  }

  .salon[data-count='3'] .salon__case:nth-child(2) {
    grid-column: 3 / span 2;
  }

  .salon[data-count='3'] .salon__case:nth-child(3) {
    grid-column: 2 / span 2;
    margin-block-start: -18%;
  }

  /* ---------- Studio opener: the cut-out on a lilac counter ---------- */
  .counter {
    display: grid;
    justify-items: center;
    margin: 0;
  }

  .counter > :global(.plate) {
    inline-size: min(100%, var(--cap));
  }

  .counter--piece {
    gap: var(--space-5);
    justify-items: start;
  }

  .counter__plate {
    display: grid;
    place-items: center;
    inline-size: min(100%, var(--cap-velvet));
    aspect-ratio: 1;
    padding: var(--space-5);
    background: var(--plate-lilac);
  }

  .counter__cap {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .counter__cap .eyebrow {
    margin: 0;
  }

  .counter__name {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
    text-decoration: none;
  }

  .counter__name:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--wipe);
  }

  .counter__meta,
  .counter__note {
    color: var(--muted);
  }

  .counter__acts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  /* ---------- Nothing photographed: the typeset square ---------- */
  .typeset {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    inline-size: min(100%, var(--cap-case));
    aspect-ratio: 1;
    margin-inline: auto;
    padding: var(--space-6);
    background: var(--surface-2);
    outline: 1px solid var(--rule);
    outline-offset: calc(var(--space-3) * -1);
    text-align: center;
  }

  .typeset__name {
    font-family: var(--ff-display);
    font-size: var(--t-display);
    font-style: italic;
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    color: var(--fg);
    text-wrap: balance;
  }

  .typeset__note {
    color: var(--muted);
  }

  .typeset__rate {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
  }

  .typeset__rate .eyebrow {
    margin: 0;
  }

  .typeset__rate :global(.typeset__fig) {
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    color: var(--numeral);
  }

  /* ---------- The pieces ---------- */
  :global(.sec.pieces) {
    padding-block-start: var(--space-6);
  }

  .pieces__filters {
    margin-block-end: var(--space-8);
  }

  /* ---------- Buying notes ---------- */
  .notes {
    display: grid;
    gap: var(--space-6);
  }

  .notes__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule-strong);
  }

  .notes__n {
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1;
    color: var(--numeral);
  }

  .notes__text {
    max-inline-size: var(--measure);
    color: var(--body);
  }

  @media (min-width: 64em) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: calc(var(--grid-gap) * 1.5);
    }
  }
</style>
