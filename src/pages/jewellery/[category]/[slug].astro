---
/**
 * A piece (/jewellery/{category}/{slug}/), docs/design-system-v2.md §6.4.
 *
 *   1  Opener: breadcrumbs, then the stage (7) and the ticket (5) on the wide track, both sticky
 *      on desktop. A velvet piece opens on the stage, on its own sampled velvet when content has
 *      one (`stage`, written as --stage, the one content-sourced style allowed); a studio piece
 *      opens on ivory with its cut-out on a lilac plate at native size. The ticket holds the H1.
 *   2  About the piece (raised stage): the piece's own text as an italic lead, the specification,
 *      and three promises under both.
 *   3  Your quote, in three lines (ivory).
 *   4  From the same counter: three pieces of the same ground (same collection first, then same
 *      category), a static CaseWall on the stage or a PlateGrid on ivory.
 *   5  The slim old-gold estimator (plum, seam), naming the piece's karat.
 *   6  Before you decide (ivory): the product FAQ.
 *
 * Phones: the stage first (at most 600 px), then the ticket edge to edge as an ivory band; the
 * phone bar carries "Ask about this piece". No price is printed: pieces are quoted at the day's
 * rate on the weight plus a making charge; with a weight, the ticket shows the gold value.
 */
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import AssuranceLedger from '@/components/sections/AssuranceLedger.astro';
import CaseWall from '@/components/sections/CaseWall.astro';
import Estimator from '@/components/sections/Estimator.astro';
import Faq from '@/components/sections/Faq.astro';
import PieceStage from '@/components/sections/PieceStage.astro';
import PieceTicket from '@/components/sections/PieceTicket.astro';
import PlateGrid from '@/components/sections/PlateGrid.astro';
import QuoteLines from '@/components/sections/QuoteLines.astro';
import SpecTable from '@/components/sections/SpecTable.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import Ornament from '@/components/ui/Ornament.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  collectionShortNames,
  getDesignCollections,
  getFaqGroup,
  getOccasions,
  getProducts,
  photoGround,
  productPath,
  resolveProductRefs,
} from '@/lib/content';
import { formatGrams, formatKarat, karatToFineness } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { productSchema } from '@/lib/schema';
import { TITLE_MAX } from '@/lib/seo';
import { toDisplayKarat } from '@/lib/tones';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { category: product.data.category.id, slug: product.id },
    props: { product },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { product } = Astro.props as Props;
const { data } = product;

const [{ category, collection }, faq, rates, collections, occasions, products, { Content }] =
  await Promise.all([
    resolveProductRefs(product),
    getFaqGroup('product'),
    getRates(),
    getDesignCollections(),
    getOccasions(),
    getProducts(),
    render(product),
  ]);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const path = productPath(product);
const url = new URL(path, origin).toString();
const rate = rates.latest;
const karat = toDisplayKarat(data.karat);
const ground = photoGround(product);
const velvet = ground === 'velvet';
const categoryName = category.data.shortName ?? category.data.name;
const fineness = karatToFineness(data.karat);
const hasStory = Boolean(product.body?.trim());
/** Only if a piece has no Markdown text: the meta description without its call to action. */
const fallbackLead = data.description.replace(/\s*(Enquire now|Ask on WhatsApp)[.!]?\s*$/i, '');
/** The sampled velvet behind a piece shown alone (content-sourced, so validated as #rrggbb). */
const stage = velvet && data.stage && /^#[0-9a-f]{6}$/i.test(data.stage) ? data.stage : undefined;

/* ---------- Specification ---------- */
const colour = `${data.colour.charAt(0).toUpperCase()}${data.colour.slice(1).replace('-', ' ')} gold`;
const occasionNames = occasions
  .filter((o) => data.occasions.some((ref) => ref.id === o.id))
  .map((o) => o.data.name);
const availability = {
  'in-store': 'In store',
  'made-to-order': 'Made to order',
  sold: 'Sold',
}[data.availability];
const weight = data.weightGrams
  ? data.netWeightGrams
    ? `${formatGrams(data.weightGrams)} gross, ${formatGrams(data.netWeightGrams)} gold`
    : formatGrams(data.weightGrams)
  : 'On request, weighed in front of you';

/* ---------- From the same counter: same ground, same collection first, then same category ---------- */
const sameGround = products.filter((p) => p.id !== product.id && photoGround(p) === ground);
const byCollection = sameGround.filter(
  (p) => collection && p.data.collection?.id === collection.id,
);
const byCategory = sameGround.filter(
  (p) => !byCollection.includes(p) && p.data.category.id === category.id,
);
const rest = sameGround.filter((p) => !byCollection.includes(p) && !byCategory.includes(p));
const related = [...byCollection, ...byCategory, ...rest].slice(0, 3);
const names = collectionShortNames(collections);

/* ---------- SEO ---------- */
const longTitle = `${data.name}, ${formatKarat(data.karat)} ${categoryName}`;
const title = longTitle.length <= TITLE_MAX ? longTitle : data.name;
const firstImage = data.images[0]!;
const imageUrl = new URL(firstImage.src.src, origin).toString();

const jsonLd = [
  productSchema({
    name: data.name,
    description: fallbackLead,
    url,
    images: data.images.map((img) => new URL(img.src.src, origin).toString()),
    sku: data.sku,
    karat: data.karat,
    fineness,
    material: data.material === 'gold' ? 'gold' : `gold with ${data.material}`,
    colour: data.colour,
    category: category.data.name,
    collection: collection?.data.name,
    collectionUrl: collection
      ? new URL(routes.collection(collection.id), origin).toString()
      : undefined,
    weightGrams: data.weightGrams,
    stones: data.stones,
    certification: data.certification,
  }),
];
---

<BaseLayout
  ground={velvet ? 'stage' : 'ivory'}
  piece={{ name: data.name, sku: data.sku, url }}
  title={title}
  description={data.description}
  type="product"
  image={imageUrl}
  imageAlt={firstImage.alt}
  imageWidth={firstImage.src.width}
  imageHeight={firstImage.src.height}
  jsonLd={jsonLd}
>
  <Section
    tone={velvet ? 'stage' : 'ivory'}
    pad="flush"
    width="wide"
    class:list={['popen', stage && 'popen--own']}
    style={stage ? `--stage:${stage}` : undefined}
    labelledby="piece-title"
  >
    <Breadcrumbs
      class="popen__crumbs"
      items={[
        { name: 'Jewellery', href: routes.jewellery },
        { name: categoryName, href: routes.category(category.id) },
        { name: data.name, href: path },
      ]}
    />
    <div class="popen__grid">
      <PieceStage product={product} images={data.images} />
      <PieceTicket
        product={product}
        category={category}
        collection={collection}
        rate={rate}
        fetchedAt={rates.fetchedAt}
        url={url}
      />
    </div>
  </Section>

  <Section tone={velvet ? 'stage-raised' : 'stage'} width="wide" labelledby="about-title">
    <div class="about">
      <div class="about__story">
        <h2 id="about-title" class="about__title eyebrow">
          <Ornament />
          About the piece
        </h2>
        <div class="about__lead">{hasStory ? <Content /> : <p>{fallbackLead}</p>}</div>
      </div>
      <SpecTable
        class="about__spec"
        caption={`Specification of the ${data.name}`}
        rows={[
          { label: 'Karat', value: `${formatKarat(data.karat)}, stamped ${fineness}` },
          {
            label: 'Style',
            value: collection ? `${collection.data.shortName}: ${collection.data.origin}` : null,
          },
          { label: 'Metal', value: colour },
          { label: 'Plating', value: data.plating },
          { label: 'Finish', value: data.finish },
          { label: 'Stones', value: data.stones },
          { label: 'Certificate', value: data.certification },
          { label: 'Weight', value: weight },
          { label: 'Occasion', value: occasionNames.join(', ') },
          { label: 'Availability', value: availability },
          { label: 'Reference', value: data.sku },
        ]}
      />
      <div class="about__promises">
        <AssuranceLedger variant="condensed" />
      </div>
    </div>
  </Section>

  <Section tone="ivory" id="price">
    <QuoteLines karat={karat} rate={rate} />
  </Section>

  {related.length > 0 &&
    (velvet ? (
      <Section tone="stage" width="wide" labelledby="counter-title">
        <SectionHead
          id="counter-title"
          title="From the same"
          accent="counter"
          shape="split"
          class="reveal"
        >
          <Fragment slot="aside">
            <MoreLink href={routes.category(category.id)}>
              All {categoryName.toLowerCase()}
            </MoreLink>
          </Fragment>
        </SectionHead>
        <CaseWall
          products={related}
          rate={rate}
          collectionNames={names}
          columns={3}
          light="static"
        />
      </Section>
    ) : (
      <Section tone="ivory" ruled labelledby="counter-title">
        <SectionHead
          id="counter-title"
          title="From the same"
          accent="counter"
          shape="split"
          class="reveal"
        >
          <Fragment slot="aside">
            <MoreLink href={routes.jewellery}>All jewellery</MoreLink>
          </Fragment>
        </SectionHead>
        <PlateGrid products={related} rate={rate} collectionNames={names} columns={3} />
      </Section>
    ))}

  <Estimator rate={rate} variant="slim" id="piece-estimate" karat={karat} />

  <Section tone="ivory">
    <div class="faq-wrap">
      <Faq heading={faq.data.heading} items={faq.data.items} />
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- 1. Opener ---------- */
  /* Phones: the ticket is the opener's last band, so it meets the next section directly. */
  :global(.sec.popen) {
    padding-block: var(--space-5) 0;
  }

  @media (min-width: 40em) {
    :global(.sec.popen) {
      padding-block-end: var(--section-y);
    }
  }

  /* A piece shown alone sits on its own sampled velvet, so the photograph has no edge. */
  :global(.sec.popen--own) {
    background-color: var(--stage);
  }

  .popen__grid {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-5);
  }

  @media (min-width: 64em) {
    .popen__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: calc(var(--grid-gap) * 2);
      align-items: start;
      margin-block-start: var(--space-6);
    }
  }

  /* ---------- 2. About the piece ---------- */
  .about {
    display: grid;
    gap: var(--space-7);
  }

  .about__story {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .about__title {
    display: flex;
    margin: 0;
  }

  .about__lead :global(p) {
    max-inline-size: var(--measure);
    color: var(--body);
  }

  .about__lead :global(p:first-child) {
    max-inline-size: 36rem;
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: var(--fw-display);
    line-height: 1.3;
    color: var(--fg);
  }

  .about__lead :global(p + p) {
    margin-block-start: var(--space-4);
  }

  .about__promises {
    min-inline-size: 0;
  }

  @media (min-width: 64em) {
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: var(--space-8);
    }

    .about__story {
      grid-column: 1 / span 6;
    }

    .about :global(.about__spec) {
      grid-column: 8 / -1;
      align-self: start;
    }

    .about__promises {
      grid-column: 1 / -1;
    }
  }

  /* ---------- 6. FAQ ---------- */
  .faq-wrap {
    max-inline-size: 52rem;
  }
</style>
