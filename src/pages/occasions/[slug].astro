---
/**
 * One occasion (docs/design-system-v2.md §6.7). Ivory: the portrait is a pale-ground photograph.
 *
 *   1. Opener: the portrait in its window (at most 392 CSS px, the page's priority image, no text
 *      on it) beside the H1, the summary and the two ways to ask.
 *   2. Festivals only, while an offer runs: the campaign line.
 *   3. The buying note: the Markdown body and any fact the body does not already give.
 *   4. Festivals only: today's rate, on the stage.
 *   5. The pieces tagged for the occasion: velvet photographs in a case wall on the stage, studio
 *      cut-outs on their own lilac plates on ivory; then the categories to start with and, where
 *      the body names them, the styles (Wedding: Kolkata, Temple, Antique, Kuwaiti) as text links
 *      until bridal photography exists.
 *   6. An enquiry band: book a viewing.
 */
import type { InferGetStaticPropsType } from 'astro';
import { Picture } from 'astro:assets';
import { getEntries, render } from 'astro:content';

import CampaignLine from '@/components/sections/CampaignLine.astro';
import CaseWall from '@/components/sections/CaseWall.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import PlateGrid from '@/components/sections/PlateGrid.astro';
import RateInstrument from '@/components/sections/RateInstrument.astro';
import Button from '@/components/ui/Button.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  collectionShortNames,
  getActiveOffers,
  getDesignCollections,
  getOccasions,
  getProductsByOccasion,
  splitByGround,
} from '@/lib/content';
import { countWord } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { TITLE_MAX } from '@/lib/seo';
import { whatsappUrl } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const occasions = await getOccasions();
  return occasions.map((occasion) => ({ params: { slug: occasion.id }, props: { occasion } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { occasion } = Astro.props as Props;
const { data } = occasion;

const [products, categories, collections, rates, offers, { Content }] = await Promise.all([
  getProductsByOccasion(occasion.id),
  getEntries(data.suggestedCategories),
  getDesignCollections(),
  getRates(),
  getActiveOffers(),
  render(occasion),
]);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const { velvet, lilac } = splitByGround(products);
const collectionNames = collectionShortNames(collections);
const festivals = occasion.id === 'festivals';
const offer = festivals ? offers[0] : undefined;

/**
 * Copy per occasion; unknown occasions fall back to the content. `forPhrase` gives headings their
 * article ("for a wedding"); `viewing` names the visit in the enquiry band; `reason` is the visit
 * form's reason key; `note` is printed after the Markdown body, so it carries only facts the body
 * does not already give.
 */
interface OccasionCopy {
  h1: string;
  ask: string;
  forPhrase: string;
  viewing: string;
  reason?: string;
  note?: string;
}
const copy: Record<string, OccasionCopy> = {
  wedding: {
    h1: 'Bridal gold sets',
    ask: 'I’m planning wedding jewellery. Could we arrange a consultation?',
    forPhrase: 'for a wedding',
    viewing: 'bridal',
    reason: 'bridal',
  },
  anniversary: {
    h1: 'Anniversary jewellery',
    ask: 'I’m looking for an anniversary gift. Could you suggest a few pieces?',
    forPhrase: 'for an anniversary',
    viewing: 'anniversary',
    note: 'Diamonds are set in 18K because it holds a stone better than 22K. Every stone is instrument-tested in the shop, and larger diamonds come with an independent grading report.',
  },
  birthday: {
    h1: 'Birthday gold',
    ask: 'I’m looking for a birthday gift in gold. What would you suggest?',
    forPhrase: 'for a birthday',
    viewing: 'birthday',
    note: 'Keep the invoice with the gift: it records the karat and the weight in grams, which is what any later exchange is based on.',
  },
  festivals: {
    h1: 'Gold for Diwali, Dhanteras, Akshaya Tritiya and Eid',
    ask: 'I’d like to buy gold for the festival. What do you have in coins and sets?',
    forPhrase: 'for festivals',
    viewing: 'festival',
    reason: 'coins',
    note: 'On VAT: 24K coins and bars of 99% purity or more are zero-rated, while 22K coins and jewellery carry 5%.',
  },
};
const page: OccasionCopy = copy[occasion.id] ?? {
  h1: data.name,
  ask: `I’m looking for jewellery for ${data.name.toLowerCase()}.`,
  forPhrase: `for ${data.name.toLowerCase()}`,
  viewing: data.name.toLowerCase(),
};

/** Styles the body names ("…the Kolkata, Temple, Antique and Kuwait collections"). */
const body = occasion.body ?? '';
const styles = collections.filter((c) => {
  const base = c.data.name.replace(/\s+Collection$/i, '');
  return new RegExp(`\\b(${base}|${c.data.shortName})\\b`).test(body);
});

const title = data.title.length <= TITLE_MAX ? data.title : `${page.h1} in Dubai`;
const whatsapp = whatsappUrl(`${site.whatsapp.greeting} ${page.ask}`);
const visitHref = `${routes.contact}${page.reason ? `?reason=${page.reason}` : ''}#visit`;

/* The portrait: drawn at most 392 CSS px wide (2x sharp from the 784 px source), never more. */
const portrait = data.image;
const cap = Math.min(392, portrait.width);
const widths = [...new Set([296, 392, 588, 784, cap].filter((w) => w <= portrait.width))].sort(
  (a, b) => a - b,
);

const pieceWord = (n: number) => `${countWord(n)} ${n === 1 ? 'piece' : 'pieces'}`;

/** No ItemList when nothing is tagged: a list of zero items tells a search engine nothing. */
const jsonLd =
  products.length > 0
    ? [
        itemListSchema(
          products.map((p) => ({
            name: p.data.name,
            url: new URL(routes.product(p.data.category.id, p.id), origin).toString(),
          })),
          page.h1,
        ),
      ]
    : [];
---

<BaseLayout ground="ivory" title={title} description={data.description} jsonLd={jsonLd}>
  <PageHead
    tone="ivory"
    breadcrumbs={[
      { name: 'Occasions', href: routes.occasions },
      { name: data.name, href: routes.occasion(occasion.id) },
    ]}
    eyebrow={data.name}
    title={page.h1}
    lead={data.summary}
    layout="split"
    mediaFirst
  >
    <Button href={whatsapp} icon="whatsapp" external>
      Ask on WhatsApp
    </Button>
    <Button href={visitHref} variant="secondary" icon="calendar">
      Book a visit
    </Button>
    <figure
      class="portrait"
      slot="media"
      style={`--cap:${cap}px;--ar:${portrait.width}/${portrait.height}`}
    >
      <div class="portrait__frame">
        <Picture
          src={portrait}
          alt={data.imageAlt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={`(min-width: 64em) ${cap}px, min(${cap}px, calc(100vw - 3rem))`}
          fit="cover"
          position="top"
          priority
        />
      </div>
    </figure>
  </PageHead>

  {offer && <CampaignLine offer={offer} />}

  <Section tone="ivory" ruled={!offer} labelledby="buying-title">
    <div class="buying">
      <h2 class="buying__title" id="buying-title">
        Buying <em>{page.forPhrase}</em>
      </h2>
      <div class="buying__body prose">
        <Content />
        {page.note && <p>{page.note}</p>}
      </div>
    </div>
  </Section>

  {festivals && (
    <Section tone="stage" labelledby="rate-title">
      <SectionHead
        id="rate-title"
        eyebrow="Today"
        title="Bought by weight,"
        accent="at today’s rate"
        shape="split"
      >
        Coins and bars follow the 24K figure; most of our jewellery is 22K.
        <MoreLink href={routes.goldRate} slot="aside">
          Today’s gold rate
        </MoreLink>
      </SectionHead>
      <RateInstrument
        rate={rates.latest}
        stale={rates.stale}
        fetchedAt={rates.fetchedAt}
        variant="compact"
        id="festival-rate"
      />
    </Section>
  )}

  {velvet.length > 0 && (
    <Section tone={festivals ? 'stage-raised' : 'stage'} labelledby="cases-title">
      <SectionHead
        id="cases-title"
        eyebrow="In the cases"
        title={`${pieceWord(velvet.length)} ${page.forPhrase}`}
        shape="split"
      >
        Open a piece for its page, or message us for its weight and today’s price.
        <MoreLink href={routes.jewellery} slot="aside">
          All jewellery
        </MoreLink>
      </SectionHead>
      <CaseWall
        products={velvet}
        rate={rates.latest}
        collectionNames={collectionNames}
        layout="grid"
        columns={velvet.length >= 4 && velvet.length % 3 !== 0 ? 4 : 3}
      />
    </Section>
  )}

  <Section tone="ivory" ruled={velvet.length === 0} labelledby="start-title">
    {lilac.length > 0 ? (
      <>
        <SectionHead
          id="start-title"
          eyebrow="From the studio"
          title={
            velvet.length > 0
              ? `And ${pieceWord(lilac.length).toLowerCase()} more`
              : `${pieceWord(lilac.length)} ${page.forPhrase}`
          }
          shape="split"
        >
          Photographed in the studio. Ask us what the cases hold today.
        </SectionHead>
        <PlateGrid products={lilac} rate={rates.latest} collectionNames={collectionNames} />
      </>
    ) : (
      <h2 class="sr-only" id="start-title">
        Where to start
      </h2>
    )}
    <div class:list={['starts', lilac.length > 0 && 'starts--after']}>
      <p class="starts__row list-links">
        <span class="starts__label eyebrow">Start with</span>
        {categories.map((c) => (
          <a class="link-wipe" href={routes.category(c.id)}>
            {c.data.shortName ?? c.data.name}
          </a>
        ))}
      </p>
      {styles.length > 0 && (
        <p class="starts__row list-links">
          <span class="starts__label eyebrow">Styles {page.forPhrase}</span>
          {styles.map((c) => (
            <a class="link-wipe" href={routes.collection(c.id)}>
              {c.data.shortName}
            </a>
          ))}
        </p>
      )}
    </div>
  </Section>

  <EnquiryBand
    title={`Book a ${page.viewing} viewing`}
    accent="at a branch"
    text="Tell us the date, the pieces and a budget. We reply with a shortlist and today’s prices."
    whatsappUrl={whatsapp}
    secondary={{ href: visitHref, label: 'Book a visit' }}
  />
</BaseLayout>

<style>
  /* ---------- The portrait window: a frame set 0.5 rem out, nothing on the photograph ---------- */
  .portrait {
    inline-size: min(100%, calc(var(--cap) + var(--space-4) + 2px));
    margin: 0;
  }

  .portrait__frame {
    padding: var(--space-2);
    border: 1px solid var(--rule-strong);
  }

  .portrait__frame :global(picture) {
    display: block;
  }

  .portrait__frame :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: var(--ar);
    object-fit: cover;
    object-position: top;
  }

  /* ---------- Buying note ---------- */
  .buying {
    display: grid;
    gap: var(--space-6);
  }

  .buying__title {
    max-inline-size: 12ch;
  }

  .buying__body {
    font-size: var(--t-lead);
    line-height: 1.6;
  }

  @media (min-width: 64em) {
    .buying {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: calc(var(--grid-gap) * 2);
    }
  }

  /* ---------- Where to start ---------- */
  .starts {
    display: grid;
    gap: var(--space-4);
  }

  .starts--after {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
  }

  .starts__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  .starts__label {
    margin-inline-end: var(--space-3);
  }
</style>
