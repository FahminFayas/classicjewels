---
/**
 * Occasions index (docs/design-system-v2.md §6.7). Ivory throughout: the portraits are pale-ground
 * photographs (rule 1). Four windows with their summaries, never wider than 392 CSS px (sharp on
 * 2x screens from the 784 px sources), two by two on desktop with the second column set lower,
 * one column on phones. The Festivals window carries the running offer while it runs. The page
 * ends at a person.
 */
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import OccasionWindow from '@/components/sections/OccasionWindow.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import { emirates, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveOffers, getOccasions } from '@/lib/content';
import { countWord, formatDate, listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { whatsappUrl } from '@/lib/whatsapp';

const [occasions, offers] = await Promise.all([getOccasions(), getActiveOffers()]);
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const places = listWords(emirates);

/** "Diwali 2026: book the rate…" -> "Diwali offers until 10 November" (only while it runs). */
const offer = offers[0];
const offerNote = offer
  ? `${offer.data.headline
      .split(':')[0]!
      .replace(/\s*\d{4}$/, '')
      .trim()} offers until ${formatDate(offer.data.endsOn, { year: undefined })}`
  : undefined;

const ask = whatsappUrl(
  `${site.whatsapp.greeting} I’m planning jewellery for a date. Could you suggest a few pieces?`,
);

const jsonLd = [
  itemListSchema(
    occasions.map((o) => ({
      name: o.data.name,
      url: new URL(routes.occasion(o.id), origin).toString(),
    })),
    'Jewellery by occasion',
  ),
];
---

<BaseLayout
  ground="ivory"
  title="Wedding, Anniversary & Festival Gold in the UAE"
  description={`Bridal gold sets, anniversary diamonds, birthday gold and festival coins from Classic Jewels in ${places}, bought by weight at the day’s rate.`}
  jsonLd={jsonLd}
>
  <PageHead
    tone="ivory"
    breadcrumbs={[{ name: 'Occasions', href: routes.occasions }]}
    eyebrow="Occasions"
    title="Jewellery by occasion"
    lead="Wedding sets, anniversary diamonds, birthday gold and festival coins, each bought by weight at the day’s rate."
  />

  <Section tone="ivory" class="occ-windows">
    <h2 class="sr-only">{countWord(occasions.length)} occasions</h2>
    <ul class="windows" role="list">
      {occasions.map((o, i) => (
        <li class:list={['windows__cell', i > 1 && 'reveal']}>
          <OccasionWindow
            occasion={o}
            summary
            headingLevel="h3"
            note={o.id === 'festivals' ? offerNote : undefined}
          />
        </li>
      ))}
    </ul>
  </Section>

  <EnquiryBand
    title="Planning for a date?"
    accent="Tell us when."
    text="Tell us the occasion, the date and a budget. We reply with a shortlist from the cases at our branches."
    whatsappUrl={ask}
    secondary={{ href: `${routes.contact}#visit`, label: 'Book a visit' }}
  />
</BaseLayout>

<style>
  :global(.sec.occ-windows) {
    padding-block-start: 0;
  }

  .windows {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
  }

  .windows__cell {
    display: grid;
    justify-items: center;
    inline-size: 100%;
  }

  /* Two by two, the second column set lower: windows along a wall, not a grid of tiles. */
  @media (min-width: 64em) {
    .windows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: var(--space-9);
      max-inline-size: 64rem;
      margin-inline: auto;
    }

    .windows__cell:nth-child(even) {
      margin-block-start: var(--space-10);
    }
  }
</style>
