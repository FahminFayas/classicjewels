---
/**
 * About (docs/design-system-v2.md §6.12). Five movements, each fact from src/data/site.ts or the
 * content collections:
 *
 *   1. Opener, ivory: the group lockup above the H1; the heritage sentence as the lead.
 *   2. The group, ivory: its three divisions as ruled chapters, and its trade.
 *   3. From bar to bangle, stage: BarToBangle (the bar, the stamp, the piece).
 *   4. Our terms, ivory: the condensed promise ledger.
 *   5. Come in, stage: the doors.
 *
 * No pull quotes, no invented milestones, no reprinted reviews.
 */
import { getEntry } from 'astro:content';

import AssuranceLedger from '@/components/sections/AssuranceLedger.astro';
import BarToBangle from '@/components/sections/BarToBangle.astro';
import BranchDoors from '@/components/sections/BranchDoors.astro';
import GroupLockup from '@/components/ui/GroupLockup.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates, flagship, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFeaturedProducts, photoGround } from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { jewelryStoreSchema } from '@/lib/schema';

const [{ latest: rate }, p03, featured] = await Promise.all([
  getRates(),
  getEntry('products', 'antique-pearl-drop-bib'),
  getFeaturedProducts(12),
]);
/* The bar-to-bangle piece: p03, else the first featured piece photographed on velvet. */
const piece =
  p03 && photoGround(p03) === 'velvet' ? p03 : featured.find((p) => photoGround(p) === 'velvet');

const brandYear = site.founded.brandYear;
const branchWord = countWord(openBranches.length).toLowerCase();
const emirateList = listWords(emirates);
const { group } = site;

/** The heritage sentence (§8.2 band), from site.group. */
const heritage = `The Classic Group has been ${group.experienceLead}, ${group.experienceTail}.`;

/** The three divisions as chapters: name, the year or role site.ts gives, and one paragraph. */
const chapters = group.divisions.map((d) => {
  const year = /since (\d{4})/.exec(d.note)?.[1];
  const role = d.note.replace(/,?\s*since \d{4}$/, '').replace(/^the group’s first business: /, '');
  const first = /first business/.test(d.note);
  const text = first
    ? `Where the group began. Its trade is still ${group.trade}.`
    : d.name === site.name
      ? `The jewellery house, opened in ${brandYear} at ${flagship.name}; now ${branchWord} branches in ${emirateList}.`
      : `The group’s ${role} business.`;
  return {
    name: d.name,
    when: first ? 'First' : year ? `Since ${year}` : '',
    role: role.charAt(0).toUpperCase() + role.slice(1),
    text,
  };
});

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const storeImage = new URL('/og/default.png', origin).toString();
const jsonLd = openBranches
  .filter((b) => !b.isFlagship)
  .map((b) => jewelryStoreSchema(b, storeImage));

const title = 'About Classic Jewels & Diamonds, Classic Group, Dubai';
const description = `The Classic Group has been ${group.experience}. Its jewellery house opened in ${brandYear} and has ${branchWord} UAE branches.`;
---

<BaseLayout ground="ivory" title={title} description={description} jsonLd={jsonLd}>
  <PageHead
    tone="ivory"
    breadcrumbs={[{ name: 'About', href: routes.about }]}
    title="About Classic Jewels & Diamonds"
    lead={heritage}
    layout="centre"
  >
    <div slot="media">
      <GroupLockup size="md" link />
    </div>
  </PageHead>

  <Section tone="ivory" ruled labelledby="group-title">
    <SectionHead
      id="group-title"
      eyebrow={group.name}
      title="Gold traders"
      accent="first"
      shape="split"
    >
      Jewellery came last. The group was in bullion, scrap gold and refining long before it opened a
      jewellery counter in {brandYear}.
    </SectionHead>
    <ol class="chapters" role="list">
      {chapters.map((c, i) => (
        <li class="chapter">
          <p class="chapter__when eyebrow">
            <span class="chapter__n fig">{String(i + 1).padStart(2, '0')}</span>
            {c.when}
          </p>
          <h3 class="chapter__name">{c.name}</h3>
          <p class="chapter__role">{c.role}</p>
          <p class="chapter__text">{c.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  {piece && <BarToBangle rate={rate} piece={piece} />}

  <Section tone="ivory" labelledby="terms-title">
    <SectionHead id="terms-title" eyebrow="In writing" title="Our terms" shape="split">
      What every piece leaves the counter with.
      <MoreLink href={routes.promise} slot="aside">
        Our promise
      </MoreLink>
    </SectionHead>
    <AssuranceLedger variant="condensed" />
  </Section>

  <Section tone="stage" labelledby="doors-title">
    <SectionHead id="doors-title" eyebrow="Branches" title="Come in" accent="and hold it">
      {countWord(openBranches.length)} branches in {emirateList}. Message the one nearest you before
      you come.
      <MoreLink href={routes.stores} slot="aside">
        All branches
      </MoreLink>
    </SectionHead>
    <BranchDoors variant="compact" />
  </Section>
</BaseLayout>

<style>
  .chapters {
    display: grid;
    gap: var(--space-7);
  }

  .chapter {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule-strong);
  }

  .chapter__when {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
  }

  .chapter__n {
    color: var(--muted);
  }

  .chapter__name {
    font-size: var(--t-h3);
  }

  .chapter__role {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.3;
    color: var(--accent);
  }

  .chapter__text {
    max-inline-size: 34ch;
    color: var(--body);
  }

  @media (min-width: 48em) {
    .chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
  }
</style>
