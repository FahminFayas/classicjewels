---
/**
 * Where the contact endpoint sends a submission made without JavaScript (docs/design-system-v2.md
 * §6.18). The stage, noindex, kept out of the sitemap (SITEMAP_EXCLUDE in astro.config.mjs). It
 * promises no reply time: "during shop hours, usually on WhatsApp".
 */
import Icon from '@/components/ui/Icon.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes } from '@/lib/routes';
---

<BaseLayout
  ground="stage"
  title="Message received"
  description="Your message to Classic Jewels & Diamonds has been received. We reply during shop hours, usually on WhatsApp. Meanwhile, see the jewellery or today’s rate."
  noindex
>
  <PageHead
    tone="stage"
    breadcrumbs={[
      { name: 'Contact', href: routes.contact },
      { name: 'Message received', href: routes.thankYou },
    ]}
    title="Message received"
    lead="We reply during shop hours, usually on WhatsApp."
    layout="centre"
  >
    <div slot="media">
      <Icon name="c-ring" class="received__ring" size="4rem" />
    </div>
    <ul class="received__links" role="list">
      <li>
        <MoreLink href={routes.jewellery}>Jewellery</MoreLink>
      </li>
      <li>
        <MoreLink href={routes.goldRate}>Today’s gold rate</MoreLink>
      </li>
    </ul>
  </PageHead>
</BaseLayout>

<style>
  :global(.received__ring) {
    color: var(--wipe);
    stroke-width: 0.75;
  }

  .received__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-7);
  }
</style>
