---
/**
 * Contact: the three ways that actually reach the counter (WhatsApp, the flagship landline, the
 * store list), then the one contact form in a 7/5 split with a short note on what helps us reply.
 * Numbers are data, so they are set in Plex with tabular figures (spec §3), not in Bodoni.
 */
import ContactForm from '@/components/sections/ContactForm.astro';
import Hero from '@/components/sections/Hero.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { emirates, flagship, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { countWord, listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { whatsappGeneral } from '@/lib/whatsapp';

const count = countWord(openBranches.length);
const emirateList = listWords(emirates);
const counter = `the ${flagship.shortName} counter`;
const description = `WhatsApp ${site.whatsapp.display}, call ${site.phone.landline.display} (${flagship.shortName} counter) or send a message; we reply by email or phone. Our branches in ${emirateList}.`;

const tips = [
  'The piece reference from the listing, e.g. CJ-NK-001, so we quote the right piece.',
  'The karat and the rough weight you have in mind, if you are asking for a price.',
  'The branch you plan to visit, so the right counter answers.',
];
---

<BaseLayout ground="ivory" title={`Contact Us in ${emirateList}`} description={description}>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Contact', href: routes.contact }]} />
  </div>

  <Hero
    eyebrow="Contact"
    title="Contact Classic Jewels & Diamonds"
    lead={`WhatsApp is fastest during shop hours. Calls go to ${counter}. Messages sent here are answered by email or phone.`}
  />

  <section class="section section--ruled">
    <div class="container">
      <ul class="ways" role="list">
        <li class="ways__cell">
          <Eyebrow>WhatsApp</Eyebrow>
          <p class="ways__value tabular">{site.whatsapp.display}</p>
          <p class="ways__detail small">
            Fastest during shop hours. Send a photo, a sketch or a piece reference.
          </p>
          <Button href={whatsappGeneral()} icon="whatsapp" external>
            Message on WhatsApp
          </Button>
        </li>
        <li class="ways__cell">
          <Eyebrow>Call</Eyebrow>
          <p class="ways__value tabular">{site.phone.landline.display}</p>
          <p class="ways__detail small">The {flagship.shortName} counter, during shop hours.</p>
          <Button href={`tel:${site.phone.landline.e164}`} variant="secondary" icon="phone">
            Call the counter
          </Button>
        </li>
        <li class="ways__cell">
          <Eyebrow>Stores</Eyebrow>
          <p class="ways__value">{count} branches</p>
          <p class="ways__detail small">
            {emirateList}. Addresses and directions for each, with the hours we have.
          </p>
          <Button href={routes.stores} variant="secondary" icon="map-pin">
            Find a branch
          </Button>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--ruled" id="message">
    <div class="container">
      <div class="contact">
        <div class="contact__form">
          <h2>Send a message</h2>
          <p class="contact__intro lead">
            Your name, an email address and the message are enough. Add a piece reference or a
            branch if you have one.
          </p>
          <ContactForm />
        </div>
        <aside class="contact__aside">
          <h3 class="contact__aside-title">What helps us answer faster</h3>
          <ol class="rows tips" role="list">
            {tips.map((tip, i) => (
              <li class="tips__row">
                <span class="tips__no" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="tips__text">{tip}</p>
              </li>
            ))}
          </ol>
          <p class="small contact__meta">
            Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p class="small contact__meta">Registered office: {site.address.short}.</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Three cells; the section rules above and below frame them ---------- */
  .ways {
    display: grid;
  }

  /* Label, value, detail, then a flexible row so every button sits on the same baseline. */
  .ways__cell {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    justify-items: start;
    padding-block: var(--space-6);
  }

  .ways__cell > :global(:last-child) {
    align-self: end;
  }

  .ways__cell + .ways__cell {
    border-block-start: 1px solid var(--rule-1);
  }

  .ways__value {
    font-family: var(--ff-text);
    font-size: var(--t-numeral);
    font-weight: 500;
    line-height: 1.2;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink-900);
  }

  .ways__detail {
    max-inline-size: 24rem;
    margin-block-end: var(--space-2);
  }

  /* ---------- Form split: 7 / 5 ---------- */
  .contact {
    display: grid;
    gap: var(--space-8);
  }

  .contact__form {
    min-inline-size: 0;
  }

  .contact__intro {
    margin-block: var(--space-4) var(--space-6);
    max-inline-size: 40rem;
  }

  .contact__aside {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .contact__aside-title {
    font-size: var(--t-h3);
  }

  .tips__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
  }

  .tips__no {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--gold-600);
    min-inline-size: 2.2ch;
  }

  .tips__text {
    color: var(--ink-700);
  }

  .contact__meta {
    color: var(--ink-500);
  }

  @media (min-width: 56.25em) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ways__cell {
      padding-inline: var(--space-6);
    }

    .ways__cell:first-child {
      padding-inline-start: 0;
    }

    .ways__cell + .ways__cell {
      border-block-start: 0;
      border-inline-start: 1px solid var(--rule-1);
    }
  }

  @media (min-width: 64em) {
    .contact {
      grid-template-columns: 7fr 5fr;
      column-gap: calc(var(--grid-gap) * 2);
    }
  }
</style>
