---
/**
 * Contact and visit (docs/design-system-v2.md §6.13).
 *
 *   1. Opener, stage: the H1 and one line; on the right the three ways that reach the counter as
 *      large rows: WhatsApp (the primary action), the landline, the email address.
 *   2. Book a visit, plum: the four-step visit form. ?piece=, ?reason= and ?branch= are read in
 *      the browser by form.ts (the page is static), so a piece page can link straight here.
 *   3. Branches, stage, seam: the doors, so the page ends at a person (stage, not stage-raised,
 *      because the footer is stage-raised and two dark grounds in a row must differ, §1.2 rule 2).
 *
 * Numbers are data: set with lining tabular figures (.fig), every one from src/data/site.ts.
 */
import BranchDoors from '@/components/sections/BranchDoors.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import Button from '@/components/ui/Button.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates, flagship, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listWords } from '@/lib/format';
import { routes } from '@/lib/routes';
import { whatsappGeneral } from '@/lib/whatsapp';

const emirateList = listWords(emirates);
const description = `WhatsApp ${site.whatsapp.display}, call ${site.phone.landline.display} (${flagship.shortName} counter) or send a message; we reply by email or phone. Our branches in ${emirateList}.`;
---

<BaseLayout ground="stage" title={`Contact Us in ${emirateList}`} description={description}>
  <PageHead
    tone="stage"
    breadcrumbs={[{ name: 'Contact', href: routes.contact }]}
    eyebrow="Contact"
    title="Contact Classic Jewels & Diamonds"
    lead="WhatsApp is fastest. Calls go straight to the counter."
    layout="split"
  >
    <ul class="ways" role="list" slot="aside">
      <li class="way">
        <p class="way__label eyebrow">WhatsApp</p>
        <p class="way__value fig">{site.whatsapp.display}</p>
        <p class="way__note">A photo, a sketch or a piece reference is enough to start.</p>
        <Button href={whatsappGeneral()} icon="whatsapp" external>
          Message us on WhatsApp
        </Button>
      </li>
      <li class="way">
        <p class="way__label eyebrow">Call</p>
        <a class="way__value way__link fig" href={`tel:${site.phone.landline.e164}`}>
          {site.phone.landline.display}
        </a>
        <p class="way__note">The {flagship.shortName} counter, during shop hours.</p>
      </li>
      <li class="way">
        <p class="way__label eyebrow">Email</p>
        <a class="way__value way__link way__value--mail" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <p class="way__note">For anything that is not urgent.</p>
      </li>
    </ul>
  </PageHead>

  <Section tone="parchment" id="visit" labelledby="visit-title">
    <SectionHead
      id="visit-title"
      eyebrow="Book a visit"
      title="Tell us when"
      accent="you are coming"
      shape="split"
    >
      Four short steps. Send them on WhatsApp, or by email if you prefer, and we reply to confirm.
    </SectionHead>
    <ContactForm variant="visit" />
  </Section>

  <Section tone="stage" seam labelledby="doors-title">
    <SectionHead
      id="doors-title"
      eyebrow="Branches"
      title="Or simply"
      accent="come in"
      shape="split"
    >
      <MoreLink href={routes.stores} slot="aside">
        All branches
      </MoreLink>
    </SectionHead>
    <BranchDoors variant="compact" />
  </Section>
</BaseLayout>

<style>
  .ways {
    display: grid;
    border-block-start: 1px solid var(--rule-strong);
  }

  .way {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }

  .way__label {
    margin: 0;
  }

  .way__value {
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1.15;
    color: var(--fg);
  }

  .way__value--mail {
    overflow-wrap: anywhere;
  }

  .way__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.16em;
  }

  .way__link:hover {
    color: var(--accent);
    text-decoration-color: var(--wipe);
  }

  .way__note {
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .way :global(.btn) {
    margin-block-start: var(--space-3);
  }
</style>
