---
/**
 * Home (docs/design-system-v2.md §6.1, copy §8.2, heading shapes §8.3). The shop after dark:
 * the day's rate and one lit piece first, then breath and cases in turn, and every path ending at
 * a person. Grounds in order:
 *
 *   1 stage         the rate, lit (HomeHero: H1, instrument, p03 and three more pieces lit in
 *                   turn, facts)
 *   2 plum, seam    the campaign line, only while an offer runs (CampaignLine)
 *   3 ivory         the heritage sentence (OneLineBand)
 *   4 stage         the cases: eight velvet pieces (CaseWall), then "By piece"
 *   5 ivory         the hallmark stamps (KaratStamps)
 *   6 stage-raised  the styles line, west to east (StylesLine)
 *   7 plum, seam    old gold on today's scale (Estimator)
 *   8 ivory         occasions as four shop windows (OccasionWindow)
 *   9 stage         branches: the panorama, the doors, the closing line
 *
 * Never three dark sections in a row; the panorama sits between ivory and the footer, never next
 * to plum. Budgets (§6.1): 750 words in <main>, 9,000 px tall at 1440 x 900 and 10,500 px at
 * 390 x 844; the measured figures and what still exceeds them are in docs/launch-checklist.md.
 * Exactly one priority image (the hero piece). Every fact comes from src/data/site.ts or
 * src/content/.
 */
import HomeHero from '@/components/home/HomeHero.astro';
import BranchDoors from '@/components/sections/BranchDoors.astro';
import CampaignLine from '@/components/sections/CampaignLine.astro';
import CaseWall from '@/components/sections/CaseWall.astro';
import Estimator from '@/components/sections/Estimator.astro';
import KaratStamps from '@/components/sections/KaratStamps.astro';
import OccasionWindow from '@/components/sections/OccasionWindow.astro';
import OneLineBand from '@/components/sections/OneLineBand.astro';
import StylesLine from '@/components/sections/StylesLine.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import Panorama from '@/components/ui/Panorama.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { emirates, flagship, openBranches, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import panorama from '@/assets/story/banner-about.jpg';
import {
  collectionShortNames,
  getActiveOffers,
  getDesignCollections,
  getFeaturedProducts,
  getNavCategories,
  getOccasions,
  splitByGround,
} from '@/lib/content';
import { countWord, formatDate, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema, jewelryStoreSchema } from '@/lib/schema';
import { whatsappGeneral } from '@/lib/whatsapp';

/** The piece lit first in the hero (p03, §6.1). Any featured velvet piece can take its place. */
const HERO_PIECE = 'antique-pearl-drop-bib';
/** The hero's case: the first piece and the next featured velvet pieces, in editorial order. */
const HERO_SET = 4;
/** At most eight cases on the wall (§6.1 section 4). */
const WALL_SIZE = 8;

const [categories, featured, collections, occasions, rates, offers] = await Promise.all([
  getNavCategories(),
  getFeaturedProducts(24),
  getDesignCollections(),
  getOccasions(),
  getRates(),
  getActiveOffers(),
]);

const { velvet } = splitByGround(featured);
const piece = velvet.find((p) => p.id === HERO_PIECE) ?? velvet[0];
if (!piece) throw new Error('Home needs a featured piece photographed on velvet for the hero.');
const cases = velvet.filter((p) => p.id !== piece.id).slice(0, WALL_SIZE);
if (cases.length < 4) {
  throw new Error(`Home needs at least four featured velvet pieces; ${cases.length} are flagged.`);
}
const heroPieces = [piece, ...cases.slice(0, HERO_SET - 1)];

const shortNames = collectionShortNames(collections);
const offer = offers[0];
const places = listWords(emirates);

// Section 4: "Eight necklaces, eight styles" when every case is from a different collection.
const caseCount = countWord(cases.length);
const caseCategories = new Set(cases.map((p) => p.data.category.id));
const noun = caseCategories.size === 1 && caseCategories.has('necklaces') ? 'necklaces' : 'pieces';
const caseCollections = new Set(cases.map((p) => p.data.collection?.id).filter(Boolean));
const casesTitle =
  caseCollections.size === cases.length
    ? `${caseCount} ${noun}, ${caseCount.toLowerCase()} styles`
    : `${caseCount} ${noun} from the cases`;
const byPiece = categories
  .filter((c) => !caseCategories.has(c.id))
  .map((c) => ({ href: routes.category(c.id), label: c.data.shortName ?? c.data.name }))
  .map((c) => ({ ...c, label: c.label.replace(' & ', ' and ') }));

// Section 6: the place-based styles on the line.
const placeStyles = collections.filter((c) => typeof c.data.longitude === 'number').length;

// Section 7: the exchange promise's detail, as written in site.ts.
const exchangeLead = site.promises.find((p) => p.id === 'gold-exchange')?.detail;
const steps = [
  'Tested at the counter, in front of you',
  'Weighed, with stones and clasps set aside',
  'Credited at the day’s rate for its karat',
];

// Section 8: the festival window carries the running offer ("Diwali offers until 10 November").
const offerName = offer?.data.headline
  .split(':')[0]
  ?.replace(/\s+\d{4}$/, '')
  .trim();
const festivalNote =
  offer && offerName
    ? `${offerName} offers until ${formatDate(offer.data.endsOn, { year: undefined })}`
    : undefined;

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const storeImage = new URL('/og/default.png', origin).toString();
const jsonLd = [
  itemListSchema(
    [piece, ...cases].map((p) => ({
      name: p.data.name,
      url: new URL(routes.product(p.data.category.id, p.id), origin).toString(),
    })),
    'Featured pieces',
  ),
  ...openBranches.filter((b) => !b.isFlagship).map((b) => jewelryStoreSchema(b, storeImage)),
];
---

<BaseLayout
  ground="stage"
  title="Gold Jewellers in Dubai, UAE"
  brandFirst
  description={`22K and 18K hallmarked gold, tested diamonds and 24K coins from our branches in ${places}, weighed in front of you at today’s gold rate.`}
  jsonLd={jsonLd}
>
  {/* 1. The rate, lit */}
  <HomeHero
    rate={rates.latest}
    stale={rates.stale}
    fetchedAt={rates.fetchedAt}
    pieces={heroPieces}
    collectionNames={shortNames}
  />

  {/* 2. The campaign line: renders nothing once the offer has ended */}
  {offer && <CampaignLine offer={offer} />}

  {/* 3. Heritage */}
  <OneLineBand
    id="heritage"
    lockup
    line={`The Classic Group has been ${site.group.experienceLead},`}
    accent={`${site.group.experienceTail}.`}
  >
    <p>
      The group began in bullion, and still works in {site.group.trade}. In {site.founded.brandYear}
      it opened Classic Jewels &amp; Diamonds at {flagship.name}.
    </p>
    <MoreLink href={routes.about}>How the house began</MoreLink>
  </OneLineBand>

  {/* 4. The cases */}
  <Section tone="stage" width="wide" id="cases" labelledby="cases-title">
    <SectionHead
      id="cases-title"
      eyebrow="On the velvet"
      ornament
      title={casesTitle}
      shape="split"
      class="reveal"
    >
      <Fragment slot="aside">
        <MoreLink href={routes.jewellery}>All jewellery</MoreLink>
      </Fragment>
    </SectionHead>
    <CaseWall
      products={cases}
      rate={rates.latest}
      collectionNames={shortNames}
      layout="stagger"
      columns={4}
    />
    <nav class="bypiece" aria-labelledby="bypiece-label">
      <p class="bypiece__label eyebrow" id="bypiece-label">
        By piece:
      </p>
      <ul class="bypiece__list list-links" role="list">
        {byPiece.map((c) => (
          <li>
            <a class="link-wipe" href={c.href}>
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Section>

  {/* 5. The stamp says what's inside */}
  <Section tone="ivory" id="hallmarks" labelledby="hallmarks-title">
    <SectionHead
      id="hallmarks-title"
      eyebrow="Know your gold"
      title="The stamp says"
      accent="what’s inside"
      shape="stack"
      class="reveal"
    >
      Every piece carries the UAE hallmark for its karat, and your invoice prints its weight and
      fineness.
    </SectionHead>
    <KaratStamps rate={rates.latest} collections={collections} variant="band" />
  </Section>

  {/* 6. Styles */}
  <Section tone="stage-raised" width="wide" id="styles" labelledby="styles-title">
    <SectionHead
      id="styles-title"
      eyebrow="Styles"
      title="From Kuwait to Kolkata"
      shape="centre"
      size="display"
      class="reveal"
    >
      {countWord(placeStyles)} goldsmithing styles at our counters, west and east of Dubai.
    </SectionHead>
    <StylesLine collections={collections} variant="full" />
  </Section>

  {/* 7. Old gold, on today's scale */}
  <Section tone="parchment" id="old-gold" labelledby="old-gold-title">
    <div class="split split--5-6 exchange">
      <div class="exchange__copy">
        <SectionHead
          id="old-gold-title"
          eyebrow="Old gold"
          title="Old gold,"
          accent="on today’s scale"
          accentBreak
          shape="stack"
          class="exchange__head"
        >
          {exchangeLead}
        </SectionHead>
        <ol class="exchange__steps rows" role="list">
          {steps.map((step, i) => (
            <li class="exchange__step">
              <span class="exchange__n fig" aria-hidden="true">
                {i + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <Estimator rate={rates.latest} variant="panel" id="home-estimator" />
    </div>
  </Section>

  {/* 8. Occasions */}
  <Section tone="ivory" id="occasions" labelledby="occasions-title">
    <SectionHead
      id="occasions-title"
      eyebrow="Occasions"
      title="For the wedding, and every year after"
      shape="split"
      class="reveal"
    >
      <Fragment slot="aside">
        <MoreLink href={routes.occasions}>All occasions</MoreLink>
      </Fragment>
    </SectionHead>
    <div class="occ rail-wrap bleed reveal">
      <ul class="occ__list rail" role="list">
        {occasions.map((o) => (
          <li class="occ__item">
            <OccasionWindow
              occasion={o}
              cap={296}
              note={o.id === 'festivals' ? festivalNote : undefined}
            />
          </li>
        ))}
      </ul>
      <div class="occ__controls">
        <div class="rail__progress occ__progress" aria-hidden="true"></div>
        <div class="occ__buttons">
          <button class="occ__btn" type="button" data-rail-prev hidden>
            <Icon name="arrow-left" label="Previous occasion" />
          </button>
          <button class="occ__btn" type="button" data-rail-next hidden>
            <Icon name="arrow-right" label="Next occasion" />
          </button>
        </div>
      </div>
    </div>
  </Section>

  {/* 9. Come in and hold it */}
  <Section tone="stage" pad="flush" width="wide" id="branches" labelledby="branches-title">
    <Panorama
      image={panorama}
      alt="Gold sun pendant set with small white stones on navy leather"
      field="start"
    >
      <SectionHead
        id="branches-title"
        eyebrow="Branches"
        ornament
        title="Come in"
        accent="and hold it"
        accentBreak
        shape="stack"
        class="branches__head"
      >
        {countWord(openBranches.length)} branches in {places}. Message the one nearest you before
        you come.
      </SectionHead>
    </Panorama>
    <div class="branches__doors">
      <BranchDoors variant="home" />
    </div>
    <div class="close">
      <p class="close__line h-band">
        Tell us which piece you want to see, <em>and which branch suits you.</em>
      </p>
      <div class="close__actions actions actions--pair">
        <Button href={whatsappGeneral()} icon="whatsapp" external>
          WhatsApp us
        </Button>
        <Button href={`tel:${site.phone.landline.e164}`} variant="secondary" icon="phone">
          Call {site.phone.landline.display}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- 4. "By piece" under the wall ---------- */
  /* Phones: an index of two columns, each link a full tap row. From 48em: one dotted line. */
  .bypiece {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
  }

  .bypiece__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--grid-gap);
  }

  .bypiece__list li {
    border-block-end: 1px solid var(--rule);
  }

  .bypiece__list a {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--fg);
    font-weight: var(--fw-text);
  }

  @media (min-width: 48em) {
    .bypiece {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-5);
    }

    .bypiece__list {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 var(--space-4);
    }

    .bypiece__list li {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-4);
      border: 0;
      white-space: nowrap;
    }

    .bypiece__list li:not(:last-child)::after {
      content: '·' / '';
      color: var(--muted);
    }

    .bypiece__list a {
      display: inline-flex;
      min-block-size: var(--tap-inline);
    }
  }

  /* ---------- 7. Old gold ---------- */
  .exchange {
    align-items: start;
    row-gap: var(--space-7);
  }

  .exchange :global(.exchange__head) {
    margin-block-end: var(--space-6);
  }

  .exchange__steps {
    max-inline-size: var(--measure);
  }

  .exchange__step {
    display: grid;
    grid-template-columns: var(--space-7) minmax(0, 1fr);
    align-items: baseline;
    padding-block: var(--space-4);
    color: var(--fg);
    font-weight: var(--fw-text-strong);
  }

  .exchange__n {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1;
    color: var(--numeral);
  }

  /* ---------- 8. Occasions: a rail on phones, one row of four from 64em ---------- */
  .occ__item {
    display: grid;
    justify-items: start;
  }

  .occ__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding-inline-end: var(--gutter);
  }

  .occ__controls .occ__progress {
    margin-block-start: 0;
  }

  .occ {
    row-gap: var(--space-5);
    display: grid;
  }

  .occ__buttons {
    display: flex;
    gap: var(--space-2);
  }

  .occ__btn {
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--rule-strong);
    color: var(--fg);
    transition:
      border-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out);
  }

  .occ__btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .occ__btn:disabled {
    color: var(--muted);
    cursor: default;
  }

  @media (min-width: 64em) {
    .occ.bleed {
      grid-column: content;
    }

    .occ__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      padding-inline: 0;
    }

    .occ__controls {
      display: none;
    }
  }

  /* ---------- 9. Branches ---------- */
  /* The head above already ends with its own margin: the doors follow closely. */
  .branches__doors {
    margin-block-start: var(--space-5);
  }

  .close {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--section-y);
    text-align: center;
  }

  /*
   * A sentence band with its own leading (the stage rule for running text, 1.65, would otherwise
   * win over .h-band). 32 ch, like the heritage band: Cormorant's narrow zero makes ch small.
   */
  .close__line {
    max-inline-size: 32ch;
    line-height: 1.12;
  }

  @media (min-width: 64em) {
    .branches__doors {
      margin-block-start: var(--space-6);
    }
  }

  .close__actions {
    justify-content: center;
  }

  @media (max-width: 39.99em) {
    .close__actions {
      inline-size: 100%;
    }
  }
</style>
