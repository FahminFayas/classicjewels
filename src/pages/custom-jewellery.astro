---
/**
 * Custom jewellery (docs/design-system-v2.md §6.10).
 *
 *   1. Opener, stage: a made-to-order piece (p07, the Customised collection's first velvet piece)
 *      lit in its pool beside the H1, the collection's summary and the two ways to start.
 *   2. How it works, ivory: four numbered steps, each agreed before the next.
 *   3. Tell us about it, plum: the brief form (reply method, guidance, the piece, who you are).
 *   4. Questions, ivory, closing on WhatsApp and a call.
 *
 * The timeline is not published: it is agreed in writing with each quote until the owner confirms
 * typical lead times.
 */
import ContactForm from '@/components/sections/ContactForm.astro';
import Faq from '@/components/sections/Faq.astro';
import StepStrip from '@/components/sections/StepStrip.astro';
import Button from '@/components/ui/Button.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import StageImage from '@/components/ui/StageImage.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { firstVelvetProduct, getDesignCollections, getFaqGroup } from '@/lib/content';
import { routes } from '@/lib/routes';
import { whatsappCustom } from '@/lib/whatsapp';

const [faq, collections, heroProduct] = await Promise.all([
  getFaqGroup('custom-jewellery'),
  getDesignCollections(),
  firstVelvetProduct('customised'),
]);

const collection = collections.find((c) => c.id === 'customised');
const karatLine = (collection?.data.karats ?? []).map((k) => `${k}K`).join(' or ');
const heroImage = heroProduct?.data.images[0];

const lead =
  collection?.data.summary ??
  `Bring a sketch, a photo or an heirloom to remake; we design and make it${karatLine ? ` in ${karatLine}` : ''}.`;

const steps = [
  {
    title: 'Bring a sketch, a photo or an heirloom',
    text: 'To a branch, or on WhatsApp. An old piece to remake is tested and weighed in front of you.',
  },
  {
    title: 'Design, weight and making charge agreed in writing',
    text: 'With the karat and the timeline, before any work begins.',
  },
  {
    title: 'Cast only when you approve the design',
    text: 'Nothing is made until you have seen the design and said yes.',
  },
  {
    title: karatLine ? `Made in ${karatLine}` : 'Made, hallmarked and weighed',
    text: 'Hallmarked, weighed in front of you and invoiced with the weight, karat and rate.',
  },
];

const description = `Bring a sketch, a photo or an heirloom. Made${karatLine ? ` in ${karatLine}` : ''} with the karat, weight, making charge and timeline agreed in writing first. Send a photo on WhatsApp.`;
---

<BaseLayout
  ground="stage"
  title="Custom Gold Jewellery in Dubai, Made to Order"
  description={description}
>
  <PageHead
    tone="stage"
    breadcrumbs={[{ name: 'Custom jewellery', href: routes.customJewellery }]}
    eyebrow="Made to order"
    title="Custom gold jewellery, made to order"
    lead={lead}
    layout={heroImage ? 'split' : 'text'}
    mediaFirst
  >
    <Button href={whatsappCustom()} icon="whatsapp" external>
      Send a photo on WhatsApp
    </Button>
    <Button href={`${routes.contact}?reason=custom#visit`} variant="secondary" icon="calendar">
      Book a consultation
    </Button>
    {heroImage && heroProduct && (
      <figure class="made" slot="media">
        <StageImage
          image={heroImage.src}
          alt={heroImage.alt}
          mask="pool"
          cap={Math.min(520, heroImage.src.width)}
          stage={heroProduct.data.stage}
          priority
        />
        <figcaption class="made__caption">
          <span class="made__name">{heroProduct.data.name}</span>
          <span class="made__meta">
            {heroProduct.data.karat}K · {collection?.data.shortName ?? 'Made to order'} ·{' '}
            <span class="fig">{heroProduct.data.sku}</span>
          </span>
        </figcaption>
      </figure>
    )}
  </PageHead>

  <Section tone="ivory" labelledby="how-title">
    <SectionHead
      id="how-title"
      eyebrow="How it works"
      title="Four steps,"
      accent="each agreed before the next"
      shape="stack"
    />
    <StepStrip steps={steps} />
  </Section>

  <Section tone="parchment" id="brief" labelledby="brief-title">
    <SectionHead
      id="brief-title"
      eyebrow="Start a piece"
      title="Tell us"
      accent="about it"
      shape="split"
    >
      A few lines are enough. We reply with the karat, an estimated weight and the making charge, in
      writing.
    </SectionHead>
    <ContactForm variant="brief" />
  </Section>

  <Section tone="ivory">
    <Faq heading={faq.data.heading} items={faq.data.items} />
    <div class="close">
      <p class="close__line">Rather talk it through?</p>
      <div class="actions actions--pair">
        <Button href={whatsappCustom()} icon="whatsapp" external>
          WhatsApp us
        </Button>
        <Button href={`tel:${site.phone.landline.e164}`} variant="secondary" icon="phone">
          Call {site.phone.landline.display}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .made {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .made__caption {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  .made__name {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
  }

  .made__meta {
    font-size: var(--t-caption);
    color: var(--muted);
  }

  .close {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--rule-strong);
  }

  .close__line {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
  }

  @media (min-width: 64em) {
    .close {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--grid-gap);
      align-items: center;
    }
  }
</style>
