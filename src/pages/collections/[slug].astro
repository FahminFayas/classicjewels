---
/**
 * A collection (/collections/{slug}/), docs/design-system-v2.md §6.6: a chapter page.
 *
 *   1  Opener (stage): media first. The collection's first velvet piece lit at 520 px (the
 *      priority image), or its first studio cut-out on a lilac plate (Diamonds, Kids), or a
 *      typeset plate where no photograph may be shown (Kuwaiti, Singapore). A photographed piece
 *      is named under its image with a link to its page. Text: the origin as eyebrow, the name at
 *      display size in italic, the summary, the mini styles line lit at this style (place-based
 *      styles only), the hallmarks to look for and today's rate for each karat.
 *   2  The story (ivory band): the collection's text, narrow and centred, its first sentence in
 *      Cormorant italic.
 *   3  The pieces: the other velvet pieces in a lit wall (stage) and the other cut-outs on their
 *      lilac counter (ivory). The opener's piece is not repeated, so a photograph never appears
 *      twice on the page; with nothing more to show the section is left out.
 *   4  Ask us for pieces in this style (plum, seam).
 *
 * No FAQ on collection pages.
 */
import { render } from 'astro:content';

import CaseWall from '@/components/sections/CaseWall.astro';
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import PlateGrid from '@/components/sections/PlateGrid.astro';
import StylesLine from '@/components/sections/StylesLine.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Plate from '@/components/ui/Plate.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import StageImage from '@/components/ui/StageImage.astro';
import TypesetPlate from '@/components/ui/TypesetPlate.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  collectionShortNames,
  getDesignCollections,
  getProductsByCollection,
  photoGround,
  productPath,
  type DesignCollection,
} from '@/lib/content';
import { countWord, formatKarat } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { KARAT_FACTS, toDisplayKarat } from '@/lib/tones';
import { whatsappForRange } from '@/lib/whatsapp';

export async function getStaticPaths() {
  const collections = await getDesignCollections();
  return collections.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: DesignCollection;
}

const { entry } = Astro.props;
const { data } = entry;

const [collections, products, rates, { Content }] = await Promise.all([
  getDesignCollections(),
  getProductsByCollection(entry.id),
  getRates(),
  render(entry),
]);

const rate = rates.latest;
const names = collectionShortNames(collections);
const short = data.shortName;
const whatsapp = whatsappForRange(data.name);
const reason = entry.id === 'customised' ? 'custom' : 'other';

/**
 * The opener's media: no photograph may be shown (no `image` in content: Kuwaiti, Singapore) →
 * a typeset plate; else the first velvet piece; else the first studio cut-out.
 */
const velvetPieces = products.filter((p) => photoGround(p) === 'velvet');
const lilacPieces = products.filter((p) => photoGround(p) === 'lilac');
const featured = data.image ? (velvetPieces[0] ?? lilacPieces[0]) : undefined;
const featuredVelvet = featured ? photoGround(featured) === 'velvet' : false;
const cover = featured?.data.images[0];
const wall = velvetPieces.filter((p) => p !== featured);
const plates = lilacPieces.filter((p) => p !== featured);
const morePieces = wall.length + plates.length;

/** The story: plain paragraphs set by hand so the first sentence can open in italic. */
const body = (entry.body ?? '').trim();
const plain = body.length > 0 && !/[*_#`[\]<>]/.test(body);
const paragraphs = plain ? body.split(/\n\s*\n/).map((p) => p.replace(/\s+/g, ' ').trim()) : [];
const firstSentence = paragraphs[0]?.match(/^.+?[.!?](?=\s|$)/)?.[0] ?? '';
const firstRest = paragraphs[0]?.slice(firstSentence.length).trim() ?? '';

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
/** No ItemList when nothing is listed: a list of zero items tells a search engine nothing. */
const jsonLd =
  products.length > 0
    ? [
        itemListSchema(
          products.map((p) => ({
            name: p.data.name,
            url: new URL(routes.product(p.data.category.id, p.id), origin).toString(),
          })),
          `${data.name} pieces`,
        ),
      ]
    : [];
---

<BaseLayout ground="stage" title={data.title} description={data.description} jsonLd={jsonLd}>
  <PageHead
    tone="stage"
    id="collection"
    layout="split"
    mediaFirst
    size="display"
    italic
    breadcrumbs={[
      { name: 'Collections', href: routes.collections },
      { name: short, href: routes.collection(entry.id) },
    ]}
    eyebrow={data.origin}
    title={data.name}
    lead={data.summary}
  >
    <figure slot="media" class="cmedia">
      {featured && cover ? (
        featuredVelvet ? (
          <a class="cmedia__link" href={productPath(featured)} tabindex="-1" aria-hidden="true">
            <StageImage
              image={cover.src}
              alt={cover.alt}
              mask="pool"
              cap={520}
              priority
              morph="source"
              href={productPath(featured)}
              sizes="(min-width: 64em) 520px, 100vw"
            />
          </a>
        ) : (
          <a
            class="cmedia__link cmedia__plate"
            href={productPath(featured)}
            tabindex="-1"
            aria-hidden="true"
            data-morph-href={productPath(featured)}
          >
            <Plate image={cover.src} alt={cover.alt} cap={cover.src.width} priority />
          </a>
        )
      ) : (
        <TypesetPlate name={short} whatsappUrl={whatsapp} cap={520} />
      )}
      {featured && (
        <figcaption class="cmedia__cap">
          <a class="cmedia__name" href={productPath(featured)}>
            {featured.data.name}
          </a>
          <span class="small fig">
            {formatKarat(featured.data.karat)} · {featured.data.sku}
          </span>
          {morePieces === 0 && (
            <span class="small">One piece photographed so far. Ask us for more.</span>
          )}
        </figcaption>
      )}
    </figure>

    <div slot="aside" class="cfacts">
      {typeof data.longitude === 'number' && (
        <div class="cfacts__line">
          <p class="eyebrow">West to east</p>
          <StylesLine collections={collections} variant="mini" lit={entry.id} />
        </div>
      )}
      <div class="cfacts__grid">
        <div>
          <p class="eyebrow">What to look for</p>
          <ul class="cfacts__marks" role="list">
            {data.hallmarks.map((mark) => (
              <li>{mark}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Today, per gram</p>
          <ul class="cfacts__rates" role="list">
            {data.karats.map((k) => {
              const key = toDisplayKarat(k);
              return (
                <li>
                  <span class="cfacts__k">
                    {KARAT_FACTS[key].label}
                    <span class="cfacts__stamp fig">{KARAT_FACTS[key].stamp}</span>
                  </span>
                  <RateFigure rate={rate} karat={key} format="aed" class="cfacts__fig" />
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </div>
  </PageHead>

  {body.length > 0 && (
    <Section tone="ivory" pad="band" width="narrow" labelledby="story-title">
      <div class="story">
        <h2 id="story-title" class="eyebrow story__title">
          The {short} story
        </h2>
        {plain ? (
          <>
            <p class="story__open">{firstSentence}</p>
            {firstRest && <p class="story__text">{firstRest}</p>}
            {paragraphs.slice(1).map((p) => (
              <p class="story__text">{p}</p>
            ))}
          </>
        ) : (
          <div class="story__text">
            <Content />
          </div>
        )}
      </div>
    </Section>
  )}

  {wall.length > 0 && (
    <Section tone="stage" labelledby="pieces-title">
      <SectionHead
        id="pieces-title"
        title={featured ? `More from the ${short} counter` : `The ${short} pieces`}
        shape="split"
        class="reveal"
      >
        <Fragment slot="aside">
          <MoreLink href={routes.jewellery}>All jewellery</MoreLink>
        </Fragment>
      </SectionHead>
      <CaseWall
        products={wall}
        rate={rate}
        collectionNames={names}
        layout="grid"
        columns={3}
        light="static"
      />
    </Section>
  )}

  {plates.length > 0 && (
    <Section tone="ivory" ruled={wall.length === 0 && body.length > 0} labelledby="plates-title">
      <SectionHead
        id="plates-title"
        title={wall.length > 0 || featured ? `${short}, from the studio` : `The ${short} pieces`}
        shape="split"
        class="reveal"
      >
        {`${countWord(plates.length)} ${plates.length === 1 ? 'piece' : 'pieces'} photographed on their own ground.`}
      </SectionHead>
      <PlateGrid products={plates} rate={rate} collectionNames={names} columns={3} />
    </Section>
  )}

  <EnquiryBand
    title="Ask us for pieces in the"
    accent={`${short} style`}
    text={`Tell us the piece you have in mind, or send a photo, and we will reply with what the ${short} counter has today, with weights.`}
    whatsappUrl={whatsapp}
    secondary={{ href: `${routes.contact}?reason=${reason}`, label: 'Book a visit' }}
  />
</BaseLayout>

<style>
  /* ---------- 1. Opener media ---------- */
  .cmedia {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .cmedia__link {
    display: block;
    inline-size: 100%;
  }

  .cmedia__plate {
    display: grid;
    place-items: center;
    inline-size: min(100%, var(--cap-velvet));
    aspect-ratio: 1;
    padding: var(--space-5);
    background: var(--plate-lilac);
  }

  .cmedia__cap {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    text-align: center;
    color: var(--muted);
  }

  .cmedia__name {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    color: var(--fg);
    text-decoration: none;
  }

  .cmedia__name:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--wipe);
  }

  /* ---------- 1. Opener facts ---------- */
  .cfacts {
    display: grid;
    gap: var(--space-7);
  }

  .cfacts .eyebrow {
    margin-block-end: var(--space-3);
  }

  .cfacts__grid {
    display: grid;
    gap: var(--space-6);
  }

  .cfacts__marks,
  .cfacts__rates {
    border-block-start: 1px solid var(--rule);
  }

  .cfacts__marks > li,
  .cfacts__rates > li {
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--rule);
    font-size: var(--t-small);
    color: var(--body);
  }

  .cfacts__rates > li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .cfacts__k {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    color: var(--eyebrow);
  }

  .cfacts__stamp {
    color: var(--muted);
  }

  .cfacts__rates :global(.cfacts__fig) {
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1.1;
    color: var(--numeral);
  }

  @media (min-width: 48em) {
    .cfacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(var(--grid-gap) * 1.5);
    }
  }

  /* ---------- 2. The story ---------- */
  .story {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
  }

  .story__title {
    margin: 0;
  }

  .story__open {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: var(--fw-display);
    line-height: 1.3;
    color: var(--fg);
  }

  .story__text {
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--body);
  }
</style>
