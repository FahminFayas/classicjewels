---
/**
 * Collections (/collections/), docs/design-system-v2.md §6.5.
 *
 *   1  Opener (stage): eyebrow "Styles", H1, one line counting the styles from content.
 *   2  The line (raised stage): the place-based styles west to east of Dubai (StylesLine full).
 *   3  Every collection (ivory): a wall of windows, one per collection, each on its own ground:
 *      a lit case on a stage square for the first velvet piece, a lilac plate for a studio
 *      cut-out (Diamonds, Kids), a typeset plate where nothing may be shown yet (Kuwaiti,
 *      Singapore); the short name, the origin, the karats and today's rate for the first karat.
 *   4  Not sure which style? (plum, seam).
 *
 * The windows sit on ivory rather than a third dark section in a row (§3.3 pacing); each velvet
 * photograph still lives on its own stage square.
 */
import EnquiryBand from '@/components/sections/EnquiryBand.astro';
import StylesLine from '@/components/sections/StylesLine.astro';
import PageHead from '@/components/ui/PageHead.astro';
import Plate from '@/components/ui/Plate.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import StageImage from '@/components/ui/StageImage.astro';
import TypesetPlate from '@/components/ui/TypesetPlate.astro';
import { emirates } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDesignCollections, getProducts, photoGround } from '@/lib/content';
import { countWord, listWords } from '@/lib/format';
import { getRates } from '@/lib/rates';
import { routes } from '@/lib/routes';
import { itemListSchema } from '@/lib/schema';
import { KARAT_FACTS, toDisplayKarat } from '@/lib/tones';
import { whatsappGeneral } from '@/lib/whatsapp';

const [collections, products, rates] = await Promise.all([
  getDesignCollections(),
  getProducts(),
  getRates(),
]);
const rate = rates.latest;

const places = collections.filter((c) => typeof c.data.longitude === 'number');
const others = collections.filter((c) => typeof c.data.longitude !== 'number');
const lead = `Our counters carry ${countWord(places.length).toLowerCase()} goldsmithing styles from west and east of Dubai, and ${countWord(others.length).toLowerCase()} more collections by stone, by age and by commission.`;

/**
 * What each window shows: the collection's first velvet piece; else, when the collection has a
 * photograph, its first studio cut-out; else a typeset plate (no borrowed photograph).
 */
const windows = collections.map((c) => {
  const mine = products.filter((p) => p.data.collection?.id === c.id);
  const velvet = mine.find((p) => photoGround(p) === 'velvet');
  const lilac = c.data.image ? mine.find((p) => photoGround(p) === 'lilac') : undefined;
  const firstKarat = c.data.karats[0]!;
  return {
    c,
    velvet: velvet?.data.images[0],
    lilac:
      lilac?.data.images[0] ??
      (c.data.image && c.data.imageGround === 'lilac'
        ? { src: c.data.image, alt: c.data.imageAlt ?? '' }
        : undefined),
    karat: toDisplayKarat(firstKarat),
  };
});

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const count = countWord(collections.length);
const jsonLd = [
  itemListSchema(
    collections.map((c) => ({
      name: c.data.name,
      url: new URL(routes.collection(c.id), origin).toString(),
    })),
    'Jewellery collections',
  ),
];
---

<BaseLayout
  ground="stage"
  title="Gold & Diamond Jewellery Collections in Dubai"
  description={`${count} collections, from Kolkata filigree to Italian 18K chains, each listing its karats and hallmark fineness. See them in ${listWords(emirates)}, or enquire on WhatsApp.`}
  jsonLd={jsonLd}
>
  <PageHead
    tone="stage"
    id="collections"
    layout="split"
    breadcrumbs={[{ name: 'Collections', href: routes.collections }]}
    eyebrow="Styles"
    title="Collections"
    size="display"
  >
    <p slot="aside" class="lead">
      {lead}
    </p>
  </PageHead>

  <Section tone="stage-raised" width="wide" class="line" labelledby="line-title">
    <h2 id="line-title" class="line__title eyebrow">
      West and east of Dubai
    </h2>
    <StylesLine collections={collections} variant="full" />
  </Section>

  <Section tone="ivory" labelledby="windows-title">
    <SectionHead id="windows-title" title={`${count} collections`} shape="split" class="reveal">
      Each window opens its collection: the pieces we have photographed, the hallmarks to look for
      and today’s rate for its karats.
    </SectionHead>
    <ul class="windows" role="list">
      {windows.map(({ c, velvet, lilac, karat }) => (
        <li class="window">
          <a class="window__link" href={routes.collection(c.id)}>
            <span
              class:list={[
                'window__media',
                velvet
                  ? 'window__media--stage'
                  : lilac
                    ? 'window__media--plate'
                    : 'window__media--type',
              ]}
              data-tone={velvet ? 'stage' : undefined}
            >
              {velvet ? (
                <StageImage
                  image={velvet.src}
                  alt=""
                  mask="spot"
                  cap={320}
                  sizes="(min-width: 64em) 320px, 45vw"
                />
              ) : lilac ? (
                <Plate
                  image={lilac.src}
                  alt=""
                  cap={Math.min(320, Math.round(lilac.src.width / 2))}
                  sizes="(min-width: 64em) 320px, 45vw"
                />
              ) : (
                <TypesetPlate name={c.data.shortName} cap={420} />
              )}
            </span>
            <span class="window__text">
              <span class="window__name">{c.data.shortName}</span>
              <span class="window__origin small">{c.data.origin}</span>
              <span class="window__rate small fig">
                <span class="window__karats">{KARAT_FACTS[karat].label}</span>
                {rate && (
                  <>
                    {' at '}
                    <RateFigure rate={rate} karat={karat} format="aed" /> a gram today
                  </>
                )}
                {c.data.karats.length > 1 && (
                  <>
                    {' '}
                    · also{' '}
                    {c.data.karats
                      .slice(1)
                      .map((k) => `${k}K`)
                      .join(', ')}
                  </>
                )}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <EnquiryBand
    title="Not sure which style?"
    accent="Tell us the occasion."
    text="A wedding, an anniversary, a first birthday or a festival: tell us the date and the budget and we will suggest pieces from the cases."
    whatsappUrl={whatsappGeneral()}
    secondary={{ href: routes.occasions, label: 'Occasions' }}
  />
</BaseLayout>

<style>
  /*
   * The opener is one line of type and the styles line follows at once, so the line is the first
   * screen's focal object; being in the first viewport, it is drawn static (no reveal).
   */
  :global(#collections.phead) {
    padding-block-end: var(--space-7);
  }

  @media (min-width: 64em) {
    :global(#collections .phead__grid) {
      margin-block-start: var(--space-7);
    }
  }

  :global(.sec.line) {
    padding-block-start: var(--space-7);
  }

  :global(.sec.line .sline__seg),
  :global(.sec.line .sline__group) {
    animation: none !important;
  }

  .line__title {
    margin-block-end: var(--space-6);
  }

  /* ---------- The windows ---------- */
  .windows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--grid-gap);
  }

  .window {
    min-inline-size: 0;
  }

  .window__link {
    display: grid;
    gap: var(--space-4);
    color: var(--fg);
    text-decoration: none;
  }

  .window__link:hover {
    color: var(--fg);
  }

  .window__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: clip;
  }

  .window__media--plate {
    background: var(--plate-lilac);
    padding: var(--space-4);
  }

  .window__media--type {
    background: var(--stage-1);
  }

  .window__media :global(.tplate) {
    inline-size: 100%;
  }

  /* The --accent hairline under the window, drawn on hover and focus. */
  .window__media::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: var(--champagne);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  .window__media--plate::after {
    background: var(--accent);
  }

  .window__link:is(:hover, :focus-visible) .window__media::after {
    scale: 1 1;
  }

  .window__text {
    display: grid;
    gap: var(--space-1);
  }

  .window__name {
    position: relative;
    justify-self: start;
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.15;
  }

  .window__name::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: var(--wipe);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  .window__link:is(:hover, :focus-visible) .window__name::after {
    scale: 1 1;
  }

  .window__origin {
    color: var(--body);
  }

  .window__rate {
    color: var(--muted);
  }

  .window__karats {
    font-weight: var(--fw-text-strong);
    color: var(--eyebrow);
  }

  @media (min-width: 64em) {
    .windows {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-8);
    }
  }
</style>
