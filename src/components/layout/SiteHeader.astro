---
/**
 * The site header (docs/design-system-v2.md §5.3, §8.4). Solid, never translucent: its tone
 * follows the page's first section (stage: white logo, bronze button; ivory: dark logo, plum
 * button), with a 1 px rule under it. Sticky on every device, 56 px tall below 64em and 72 px
 * from 64em, and named "hdr" for cross-document view transitions.
 *
 *   Desktop  logo | Jewellery (opens the mega panel), Styles, Occasions, Gold rate, Old gold,
 *            Branches, About | rate chip, WhatsApp
 *   Phones   logo | rate chip (compact) | Menu (opens the drawer, a modal dialog)
 *
 * The mega panel, the rate popover and the drawer render here too; they live in the top layer.
 * Every menu opens without JavaScript (popovertarget, commandfor); src/scripts/nav.ts adds hover
 * intent, aria-expanded mirroring and the fallbacks.
 */
import MegaPanel from '@/components/layout/MegaPanel.astro';
import MobileDrawer from '@/components/layout/MobileDrawer.astro';
import RateChip from '@/components/layout/RateChip.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/data/site';
import { getDesignCollections, getNavCategories, getProducts } from '@/lib/content';
import type { GoldRate } from '@/lib/gold-rate';
import { routes } from '@/lib/routes';
import type { Ground } from '@/lib/tones';
import { whatsappGeneral } from '@/lib/whatsapp';

export interface Props {
  /** Tone of the page's first section. */
  tone: Ground;
  rate: GoldRate | null;
  /** The rate is more than two days old: the chip's marker turns hollow. */
  stale: boolean;
  /** When the rate was fetched (ISO), for the rate popover's status line. */
  fetchedAt: string | null;
}

const { tone, rate, stale, fetchedAt } = Astro.props;
const [categories, collections, products] = await Promise.all([
  getNavCategories(),
  getDesignCollections(),
  getProducts(),
]);

const path = Astro.url.pathname;
/** "page" for the page itself, "true" for a section the page sits inside (a piece in Jewellery). */
const current = (href: string): 'page' | 'true' | undefined =>
  path === href ? 'page' : href !== '/' && path.startsWith(href) ? 'true' : undefined;

const nav = [
  { label: 'Styles', href: routes.collections },
  { label: 'Occasions', href: routes.occasions },
  { label: 'Gold rate', href: routes.goldRate },
  { label: 'Old gold', href: routes.goldExchange },
  { label: 'Branches', href: routes.stores },
  { label: 'About', href: routes.about },
];
---

<header class="hdr" data-tone={tone}>
  <div class="track" data-width="wide">
    <div class="hdr__bar">
      <a class="hdr__logo" href={routes.home} aria-label={`${site.name} home`}>
        <Logo tone={tone === 'stage' ? 'light' : 'dark'} />
      </a>

      <nav class="hdr__nav from-lg" aria-label="Main">
        <ul class="hdr__list" role="list">
          <li>
            <button
              class="hdr__link"
              type="button"
              popovertarget="mega"
              aria-current={current(routes.jewellery)}
            >
              Jewellery
              <Icon name="chevron-down" class="hdr__chev" />
            </button>
          </li>
          {nav.map((item) => (
            <li>
              <a class="hdr__link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="hdr__actions">
        <RateChip rate={rate} stale={stale} fetchedAt={fetchedAt} compact />
        <Button
          href={whatsappGeneral()}
          variant="primary"
          size="compact"
          icon="whatsapp"
          external
          class="hdr__wa from-lg"
        >
          <span class="hdr__wa-label">WhatsApp</span>
        </Button>
        <button
          class="hdr__menu until-lg"
          type="button"
          aria-haspopup="dialog"
          commandfor="drawer"
          command="show-modal"
        >
          <Icon name="menu" />
          <span class="hdr__menu-label">Menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<MegaPanel
  categories={categories}
  collections={collections}
  products={products}
  rate={rate}
  fetchedAt={fetchedAt}
/>
<MobileDrawer piecesCount={products.length} collectionsCount={collections.length} rate={rate} />

<style>
  .hdr {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    block-size: var(--header-h);
    border-block-end: 1px solid var(--rule);
    view-transition-name: hdr;
  }

  .hdr > .track,
  .hdr__bar {
    block-size: 100%;
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hdr__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-block-size: var(--tap);
    margin-inline-end: auto;
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }

  /* ---------- Primary navigation (64em and up) ---------- */
  .hdr__nav {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    min-inline-size: 0;
  }

  .hdr__list {
    display: flex;
    gap: var(--space-5);
  }

  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: var(--tap);
    font-size: 0.9375rem; /* 15 px: the button size of base.css (§3.5); no type token exists */
    font-weight: var(--fw-text);
    line-height: 1;
    color: var(--body);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-quick) var(--ease-out);
  }

  /* The 600 ms underline wipe (as .link-wipe in base.css), shown on hover, focus, open, current. */
  .hdr__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: var(--space-2);
    block-size: 1px;
    background: var(--wipe);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  .hdr__link:is(:hover, :focus-visible, [aria-current], [aria-expanded='true']) {
    color: var(--fg);
  }

  .hdr__link:is(:hover, :focus-visible, [aria-current], [aria-expanded='true'])::after {
    scale: 1 1;
  }

  .hdr__link :global(.hdr__chev) {
    inline-size: var(--space-4);
    block-size: var(--space-4);
    color: var(--eyebrow);
  }

  /* ---------- Menu button (below 64em) ---------- */
  .hdr__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-inline-size: var(--tap);
    min-block-size: var(--tap);
    margin-inline-end: calc(var(--space-2) * -1);
    padding-inline: var(--space-2);
    font-size: var(--t-small);
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  .hdr__menu :global(.icon) {
    inline-size: var(--space-5);
    block-size: var(--space-5);
  }

  @media (max-width: 39.99em) {
    .hdr__menu-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      overflow: clip;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* The narrowest phones: a slightly smaller logo keeps the chip and Menu on one line. */
  @media (max-width: 23.99em) {
    .hdr__logo :global(.logo) {
      block-size: var(--space-6);
    }
  }

  @media (min-width: 64em) {
    .hdr__bar {
      gap: var(--space-5);
    }

    .hdr__logo {
      margin-inline-end: 0;
    }

    .hdr__actions {
      gap: var(--space-3);
    }
  }

  /* 64em to 70em: the WhatsApp button keeps its icon and a hidden label, so the nav fits. */
  @media (min-width: 64em) and (max-width: 69.99em) {
    .hdr__wa-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      overflow: clip;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .hdr :global(.hdr__wa) {
      padding-inline: var(--space-3);
    }
  }
</style>
