---
/**
 * The phone and tablet menu (docs/design-system-v2.md §5.3, §8.4): a modal <dialog> on the raised
 * stage, full height at the inline end, at most 26 rem wide. Opened with showModal(), declaratively
 * by the header's Menu button (commandfor / command="show-modal"), or by nav.ts where commandfor
 * is missing. Modal, so the page behind is inert; the backdrop is the stage scrim. Escape closes
 * natively, the backdrop closes it (closedby="any", and nav.ts where that is missing), and so does
 * the Close button (command="close"). Focus starts on Close and returns to Menu on close.
 *
 * Contents: nine destinations in Cormorant 300 at 32 px, with a quiet fact beside the ones that
 * have one in the data (pieces, styles, the followed karat's rate, open branches); the four rates
 * as a compact board; WhatsApp (filled, bronze) and Call. Rows are at least 48 px tall.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import { openBranches, site } from '@/data/site';
import type { GoldRate } from '@/lib/gold-rate';
import { routes } from '@/lib/routes';
import { DISPLAY_KARATS, KARAT_FACTS } from '@/lib/tones';
import { whatsappGeneral } from '@/lib/whatsapp';

export interface Props {
  /** Published pieces, for "Jewellery · 15 pieces". */
  piecesCount: number;
  /** Styles (design collections), for "Styles · 12". */
  collectionsCount: number;
  rate: GoldRate | null;
}

const { piecesCount, collectionsCount, rate } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string): 'page' | 'true' | undefined =>
  path === href ? 'page' : href !== '/' && path.startsWith(href) ? 'true' : undefined;

const destinations: { label: string; href: string; fact?: string; rate?: boolean }[] = [
  { label: 'Jewellery', href: routes.jewellery, fact: `${piecesCount} pieces` },
  { label: 'Styles', href: routes.collections, fact: String(collectionsCount) },
  { label: 'Occasions', href: routes.occasions },
  { label: 'Gold rate', href: routes.goldRate, rate: Boolean(rate) },
  { label: 'Old gold', href: routes.goldExchange },
  { label: 'Branches', href: routes.stores, fact: `${openBranches.length} open` },
  { label: 'Custom jewellery', href: routes.customJewellery },
  { label: 'About', href: routes.about },
  { label: 'Contact', href: routes.contact },
];
const tel = site.phone.landline;
---

<dialog
  id="drawer"
  class="sheet sheet--side drawer"
  data-tone="stage-raised"
  aria-label="Menu"
  closedby="any"
>
  <div class="drawer__in">
    <div class="drawer__top">
      <a class="drawer__logo" href={routes.home} aria-label={`${site.name} home`}>
        <Logo tone="light" />
      </a>
      <button class="drawer__close" type="button" commandfor="drawer" command="close" autofocus>
        <Icon name="close" />
        <span>Close</span>
      </button>
    </div>

    <nav aria-label="Menu">
      <ul class="drawer__nav" role="list">
        {destinations.map((d) => (
          <li>
            <a class="drawer__link" href={d.href} aria-current={current(d.href)}>
              <span class="drawer__name">{d.label}</span>
              {d.fact && (
                <span class="drawer__fact fig">
                  <span class="sr-only">, </span>
                  {d.fact}
                </span>
              )}
              {d.rate && (
                <span class="drawer__fact">
                  <span class="sr-only">, today: </span>
                  <RateFigure rate={rate} karat="follow" format="label" class="drawer__rate" />
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {rate && (
      <div class="drawer__board">
        <p class="eyebrow">Today, AED per gram</p>
        <ul class="rows drawer__rates" role="list">
          {DISPLAY_KARATS.map((k) => (
            <li class="drawer__row">
              <span class="drawer__k">
                {KARAT_FACTS[k].label}
                <span class="drawer__stamp fig">{KARAT_FACTS[k].stamp}</span>
              </span>
              <RateFigure rate={rate} karat={k} class="drawer__v" />
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="drawer__actions">
      <Button href={whatsappGeneral()} variant="primary" icon="whatsapp" external block>
        WhatsApp us
      </Button>
      <Button href={`tel:${tel.e164}`} variant="secondary" icon="phone" block>
        <span class="fig">Call {tel.display}</span>
      </Button>
    </div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline: auto 0;
    inline-size: min(100%, 26rem);
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid var(--rule);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* The page behind a modal dialog is inert; this also stops it scrolling under the drawer. */
  :global(:root:has(#drawer[open])) {
    overflow: clip;
  }

  .drawer__in {
    display: flex;
    flex-direction: column;
    min-block-size: 100%;
    padding: 0 var(--gutter) calc(var(--space-7) + env(safe-area-inset-bottom));
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: var(--header-h);
    margin-block-end: var(--space-4);
  }

  .drawer__logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap);
    min-inline-size: var(--tap);
    margin-inline-end: calc(var(--space-2) * -1);
    padding-inline: var(--space-2);
    font-size: var(--t-small);
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  .drawer__close :global(.icon) {
    inline-size: var(--space-5);
    block-size: var(--space-5);
  }

  /* ---------- Destinations ---------- */
  .drawer__nav {
    border-block-start: 1px solid var(--rule);
  }

  .drawer__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--control-h);
    padding-block: var(--space-3) var(--space-2);
    border-block-end: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }

  .drawer__name {
    font-family: var(--ff-display);
    font-size: 2rem; /* 32 px (§5.3); fixed, because the drawer is a fixed width at every viewport */
    font-weight: var(--fw-display);
    line-height: 1.1;
    letter-spacing: var(--track-h2);
  }

  .drawer__link:is(:hover, :focus-visible) .drawer__name,
  .drawer__link[aria-current] .drawer__name {
    color: var(--accent);
  }

  .drawer__fact {
    flex: none;
    font-size: var(--t-caption);
    color: var(--muted);
  }

  .drawer__fact :global(.rate-fig__k) {
    letter-spacing: 0.04em;
  }

  /* ---------- The board ---------- */
  .drawer__board {
    margin-block-start: var(--space-7);
  }

  .drawer__rates {
    margin-block-start: var(--space-3);
  }

  .drawer__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-2);
  }

  .drawer__k {
    display: inline-flex;
    gap: var(--space-3);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    color: var(--eyebrow);
  }

  .drawer__stamp {
    letter-spacing: 0;
    color: var(--muted);
    font-weight: var(--fw-text);
  }

  .drawer :global(.drawer__v) {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-weight: var(--fw-display-small);
    line-height: 1.1;
    color: var(--numeral);
  }

  /* ---------- Actions ---------- */
  .drawer__actions {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
  }
</style>
