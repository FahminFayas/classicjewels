---
/**
 * The eyebrow ornament (docs/design-system-v2.md §3.4, §5.2): a 48 px hairline with a small arch
 * at its midpoint, in the tone's --wipe colour (bronze on light grounds and the stage, champagne on
 * plum). Decorative only. Used at major section starts, at most three per page; Eyebrow
 * places it for you with `ornament`.
 */
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['ornament', className]} viewBox="0 0 48 8" aria-hidden="true" focusable="false">
  <path d="M0 7.5h18.5a5.5 5.5 0 0 1 11 0H48"></path>
</svg>

<style>
  .ornament {
    display: inline-block;
    flex: none;
    inline-size: var(--space-7);
    block-size: var(--space-2);
    overflow: visible;
    color: var(--wipe);
  }

  .ornament path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
</style>
