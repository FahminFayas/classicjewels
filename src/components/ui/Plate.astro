---
/**
 * A studio cut-out on its own ground (docs/design-system-v2.md §1.2 rules 1 and 4, §5.2). Studio
 * photographs were shot on a pale lilac sweep (sampled as --plate-lilac), so the plate is that
 * colour and no edge shows between photo and plate. Never used for velvet photographs: those go
 * through StageImage.
 *
 * A square box, inline-size min(100%, --cap), with its size before the image loads (CLS 0; the
 * old plate could collapse to 0 x 0), overflow: clip, the image contained inside it. `cap`
 * defaults to half the source width (sharp on 2x screens); openers pass image.width. It is
 * clamped to the source (a build warning names the file), and the srcset never offers a width
 * above the source. One `priority` image per page, as with StageImage.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  image: ImageMetadata;
  alt: string;
  /** CSS px. Default Math.round(image.width / 2) (sharp on 2× screens); openers pass image.width. */
  cap?: number;
  ground?: 'lilac' | 'white';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  cap: wanted,
  ground = 'lilac',
  sizes,
  priority = false,
  class: className,
} = Astro.props;

const name = image.src.split('?')[0]?.split('/').pop() ?? image.src;
const requested = Math.round(wanted ?? image.width / 2);
if (requested > image.width) {
  console.warn(
    `[Plate] ${name} is ${image.width}px wide; a cap of ${requested}px was asked for. Drawn at ${image.width}px (never upscaled).`,
  );
}
const cap = Math.min(requested, image.width);
const widths = [
  ...new Set([180, 240, 300, 360, 480, 600, cap, image.width].filter((w) => w <= image.width)),
].sort((a, b) => a - b);
const sizesAttr = sizes ?? `(min-width: 64em) ${cap}px, min(${cap}px, 100vw)`;

if (priority) {
  const locals = Astro.locals as Record<string, unknown>;
  const count = ((locals.cjPriorityImages as number | undefined) ?? 0) + 1;
  locals.cjPriorityImages = count;
  if (count > 1) {
    console.warn(`[Plate] ${Astro.url.pathname} has ${count} priority images (one allowed)`);
  }
}
---

<div class:list={['plate', className]} data-ground={ground} style={`--cap:${cap}px`}>
  {priority ? (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizesAttr}
      fit="contain"
      priority
    />
  ) : (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizesAttr}
      fit="contain"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  )}
</div>

<style>
  .plate {
    inline-size: min(100%, var(--cap));
    aspect-ratio: 1;
    margin-inline: auto;
    background: var(--plate-lilac);
    overflow: clip;
  }

  .plate[data-ground='white'] {
    background: var(--surface-0);
  }

  /* <picture> is inline by default; it needs a definite height for object-fit to centre. */
  .plate :global(picture) {
    display: block;
    block-size: 100%;
  }

  .plate :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
</style>
