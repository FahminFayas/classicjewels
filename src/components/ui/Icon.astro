---
/**
 * Inline icon from the sprite in IconSprite.astro (docs/design-system-v2.md §5.2). Decorative by
 * default (aria-hidden); pass `label` when the icon is the only content of a control. Stroke and
 * size come from the .icon rule in base.css (1.25 px monoline, 1.25em of the surrounding text).
 * The live-rate marker is CSS (.marker), not an icon.
 */
export type IconName =
  | 'whatsapp'
  | 'phone'
  | 'map-pin'
  | 'mail'
  | 'clock'
  | 'calendar'
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'chevron-down'
  | 'plus'
  | 'minus'
  | 'menu'
  | 'close'
  | 'copy'
  | 'check'
  | 'external'
  | 'c-ring';

export interface Props {
  name: IconName;
  label?: string;
  class?: string;
  /** CSS size, e.g. "1rem" or "6rem". Defaults to 1.25em of the surrounding text. */
  size?: string;
}

const { name, label, class: className, size } = Astro.props;
---

<svg
  class:list={['icon', className]}
  style={size ? `inline-size:${size};block-size:${size}` : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <use href={`#i-${name}`}></use>
</svg>
