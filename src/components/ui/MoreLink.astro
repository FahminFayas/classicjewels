---
/**
 * The standard onward link (docs/design-system-v2.md §5.2): "All jewellery", "How a price is
 * built", "See the piece". Plex 500 in the tone's link colour, a trailing arrow and the 600 ms
 * bronze underline wipe on hover and focus (.link-wipe in base.css). Nothing moves.
 * `external` opens a new tab with rel="noopener" and a visually hidden note.
 */
import Icon, { type IconName } from '@/components/ui/Icon.astro';

export interface Props {
  href: string;
  external?: boolean;
  icon?: IconName;
  class?: string;
}

const { href, external = false, icon = 'arrow-right', class: className } = Astro.props;

const isWhatsApp = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(href);
---

<a
  class:list={['link-wipe', 'more', className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  <Icon name={icon} />
  {external && (
    <span class="sr-only"> {isWhatsApp ? '(opens WhatsApp)' : '(opens in a new tab)'}</span>
  )}
</a>

<style>
  .more {
    line-height: 1.3;
  }

  .more :global(.icon) {
    inline-size: 1.125em;
    block-size: 1.125em;
    vertical-align: middle;
  }
</style>
