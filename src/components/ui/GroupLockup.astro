---
/**
 * "A Classic Group house" with the C-ring (docs/design-system-v2.md §5.2, §8.2): the line that
 * ties the jewellery house to the group's bullion roots. The ring is drawn in the tone's --wipe
 * (bronze, or champagne on plum), the label as an eyebrow. With `link`, the label links to the
 * group's own site (heritage, not a sales link) in a new tab.
 */
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';

export interface Props {
  size?: 'sm' | 'md';
  link?: boolean;
}

const { size = 'sm', link = false } = Astro.props;
const label = 'A Classic Group house';
---

<p class="lockup eyebrow" data-size={size}>
  <Icon name="c-ring" class="lockup__ring" />
  {link ? (
    <a class="lockup__link" href={site.group.url} target="_blank" rel="noopener">
      {label}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  ) : (
    <span>{label}</span>
  )}
</p>

<style>
  .lockup {
    display: flex;
    inline-size: fit-content;
    gap: var(--space-3);
  }

  .lockup :global(.lockup__ring) {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    color: var(--wipe);
  }

  .lockup[data-size='md'] :global(.lockup__ring) {
    inline-size: var(--space-6);
    block-size: var(--space-6);
  }

  .lockup__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-inline);
    color: inherit;
    text-decoration: none;
  }

  .lockup__link:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-color: var(--wipe);
  }
</style>
