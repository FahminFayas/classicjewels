---
/**
 * Eyebrow (docs/design-system-v2.md §3.4, §5.2): 12 px Plex 500, uppercase, tracked, in the tone's
 * --eyebrow colour (gold on light grounds, bronze on the stage, champagne on plum). Optional: a
 * heading never needs one. `ornament` prefixes the bronze hairline arch; keep that to major
 * section starts (three per page at most). Renders a <p> by default; pass `as="span"` inside
 * headings, links or other phrasing content.
 */
import Ornament from '@/components/ui/Ornament.astro';

export interface Props {
  as?: 'p' | 'span' | 'div';
  ornament?: boolean;
  class?: string;
}

const { as: Tag = 'p', ornament = false, class: className } = Astro.props;
---

<Tag class:list={['eyebrow', Tag !== 'span' && 'eyebrow--block', className]}>
  {ornament && <Ornament />}
  <slot />
</Tag>

<style>
  /* A block eyebrow sits above what it labels; a span eyebrow runs inside its parent. */
  .eyebrow--block {
    display: flex;
    inline-size: fit-content;
    margin-block-end: var(--space-4);
  }
</style>
