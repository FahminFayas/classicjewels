---
/**
 * Everything in <head> that search engines and social cards read.
 * Used once per page via BaseLayout; pages pass their own title/description.
 */
import { site } from '@/data/site';
import { buildTitle, clampDescription } from '@/lib/seo';

export interface Props {
  /** Page title without the brand suffix. */
  title: string;
  description: string;
  /** Absolute or root-relative path to the share image (1200x630). Defaults to the brand card. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  /** Keep the page out of search results (thank-you page, drafts). */
  noindex?: boolean;
  /** Put the brand name first ("Classic Jewels & Diamonds | ..."), used on the home page. */
  brandFirst?: boolean;
  /** Article metadata for Open Graph. */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  image = '/og/default.png',
  imageAlt = `${site.name}, ${site.address.short}`,
  type = 'website',
  noindex = false,
  brandFirst = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = buildTitle(title, { brandFirst });
const metaDescription = clampDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const imageUrl = new URL(image, Astro.site ?? site.url).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type === 'product' ? 'product' : type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="geo.region" content="AE-DU" />
<meta name="geo.placename" content="Deira, Dubai" />
<meta name="geo.position" content={`${site.map.geo.latitude};${site.map.geo.longitude}`} />
