---
/**
 * Everything in <head> that search engines and social cards read.
 * Used once per page via BaseLayout; pages pass their own title/description.
 *
 * Share images: the default brand card is 1200x630. Pages that share their own photograph
 * (products, articles) pass its real width and height; anything that is not a wide card gets the
 * "summary" Twitter card, so a square necklace photo is not cropped to a letterbox.
 * No geo.* meta tags: Google ignores them, and the business has branches in three emirates.
 */
import { site } from '@/data/site';
import { buildTitle, clampDescription } from '@/lib/seo';

export interface Props {
  /** Page title without the brand suffix. */
  title: string;
  description: string;
  /** Absolute or root-relative path to the share image. Defaults to the 1200x630 brand card. */
  image?: string;
  imageAlt?: string;
  /** Real pixel size of `image`. Leave out for the default card. */
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'product';
  /** Keep the page out of search results (thank-you page, 404, drafts). */
  noindex?: boolean;
  /** Put the brand name first ("Classic Jewels & Diamonds | ..."), used on the home page. */
  brandFirst?: boolean;
  /** Article metadata for Open Graph. */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const DEFAULT_IMAGE = '/og/default.png';

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt = `${site.name}: ${site.tagline}`,
  imageWidth = image === DEFAULT_IMAGE ? 1200 : undefined,
  imageHeight = image === DEFAULT_IMAGE ? 630 : undefined,
  type = 'website',
  noindex = false,
  brandFirst = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = buildTitle(title, { brandFirst });
const metaDescription = clampDescription(description);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const imageUrl = new URL(image, Astro.site ?? site.url).toString();
const wide = imageWidth && imageHeight ? imageWidth / imageHeight >= 1.5 : false;
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
{!noindex && <link rel="canonical" href={pageUrl} />}
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type === 'product' ? 'product' : type} />
{!noindex && <meta property="og:url" content={pageUrl} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content={wide ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
