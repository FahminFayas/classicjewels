---
/**
 * An article card (docs/design-system-v2.md §5.6, §6.16): the cover at most 375 CSS px wide
 * (half its source, so sharp on 2x screens) in a 3:2 crop, the first tag as an eyebrow, the title
 * in Cormorant 400 at --t-h3 and a two-line standfirst. No date and no reading time on the card;
 * the article page carries the date. Tone-aware; the whole card is one link.
 */
import { Picture } from 'astro:assets';

import type { Article } from '@/lib/content';
import { routes } from '@/lib/routes';

export interface Props {
  article: Article;
  /** Heading level of the title. */
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { article, headingLevel: Tag = 'h2', class: className } = Astro.props;
const { data } = article;
const cover = data.cover;
const cap = Math.min(375, cover.width);
const widths = [...new Set([240, 320, cap, Math.min(cap * 2, cover.width)])]
  .filter((w) => w <= cover.width)
  .sort((a, b) => a - b);
const tag = data.tags[0];
---

<article class:list={['jcard', className]} style={`--cap:${cap}px`}>
  <div class="jcard__cover">
    <Picture
      src={cover}
      alt=""
      formats={['avif', 'webp']}
      widths={widths}
      sizes={`(min-width: 64em) ${cap}px, min(${cap}px, calc(100vw - 2rem))`}
      fit="cover"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  </div>
  <div class="jcard__text">
    {tag && <p class="jcard__tag eyebrow">{tag}</p>}
    <Tag class="jcard__title">
      <a class="jcard__link" href={routes.article(article.id)}>
        {data.headline ?? data.title}
      </a>
    </Tag>
    <p class="jcard__standfirst">{data.description}</p>
  </div>
</article>

<style>
  .jcard {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-5);
    inline-size: min(100%, var(--cap));
    min-inline-size: 0;
  }

  .jcard__cover {
    padding: var(--space-2);
    border: 1px solid var(--rule-strong);
    transition: border-color var(--dur-quick) var(--ease-out);
  }

  .jcard__cover :global(picture) {
    display: block;
  }

  .jcard__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .jcard__text {
    display: grid;
    gap: var(--space-3);
  }

  .jcard__tag {
    margin: 0;
  }

  .jcard__title {
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .jcard__link {
    color: var(--fg);
    text-decoration: none;
  }

  /* The title's link covers the card: one target, no nested links. */
  .jcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .jcard:hover .jcard__cover,
  .jcard:focus-within .jcard__cover {
    border-color: var(--accent);
  }

  .jcard:hover .jcard__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--wipe);
    text-underline-offset: 0.16em;
  }

  @supports selector(:has(*)) {
    .jcard__link:focus-visible {
      outline: none;
    }

    .jcard:has(.jcard__link:focus-visible) {
      outline: 2px solid var(--focus-ring);
      outline-offset: var(--space-2);
    }
  }

  .jcard__standfirst {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: clip;
    color: var(--body);
  }
</style>
