---
/**
 * The rate instrument (docs/design-system-v2.md §5.4): the day's gold rate as the instrument on
 * the wall. Real text everywhere, baked at build from src/content/rates (or the live feed) and
 * refreshed in place by src/scripts/rate.ts through the data-rate hooks.
 *
 *   hero     the home first screen: 200 px numeral, four keys in a row, the status block
 *   page     the /gold-rate/ opener: the numeral on the left, the keys as a vertical board on the
 *            right, each with its fineness and the change since the previous posting
 *   compact  festivals and offer pages: the numeral at --t-numeral-xl, four keys in a row
 *
 * The karat keys are a radio fieldset and work without JavaScript: the four numerals sit stacked
 * in one grid cell (so the box is always as wide as the widest figure and nothing moves), and a
 * :has() rule scoped to this instrument shows the one whose radio is checked. Without :has() the
 * 22K figure shows. The big figures are aria-hidden; each key's label carries its value. The 22K
 * radio is checked in the HTML and nothing changes it on load (karat.ts only listens).
 *
 * Hooks for rate.ts: [data-rate] on every figure (data-roll on the big ones), [data-rate-date] on
 * the root (the baked posting date), [data-rate-time] and [data-rate-lead] in the status line,
 * [data-stale] on the marker, [data-sheen] on the rule and [data-rate-delta="22k"] for the change
 * lines. The status block always holds its three lines, so a refresh never moves the actions.
 */
import RateFigure from '@/components/ui/RateFigure.astro';
import { site } from '@/data/site';
import { formatDate, formatRateDate, formatRateTime } from '@/lib/format';
import type { GoldRate } from '@/lib/gold-rate';
import type { RateSnapshot } from '@/lib/rates';
import { DEFAULT_KARAT, DISPLAY_KARATS, KARAT_FACTS, type DisplayKarat } from '@/lib/tones';

export interface Props {
  rate: GoldRate | null;
  stale: boolean;
  fetchedAt: string | null;
  /** hero: home first screen; page: /gold-rate/ opener with a vertical key board; compact: festivals and offer pages. */
  variant?: 'hero' | 'page' | 'compact';
  /** Unique on the page; prefixes radio ids and names. */
  id: string;
  /** Snapshots newest first; the page variant prints the change since the previous day. */
  history?: RateSnapshot[];
}

const { rate, stale, fetchedAt, variant = 'hero', id, history = [] } = Astro.props;

const dayMonth = (date: string) => formatDate(date, { year: undefined });

/** "Dubai Jewellery Group suggested retail rate": the fresh lead of the status line. */
const freshLead = `${site.rate.source} ${site.rate.basis}`;
/** The lead once the posting is more than two days old (§1.2 rule 6); rate.ts writes it too. */
const STALE_LEAD = 'Last published rate';
/** Status line 1: source and fetch time, or "Last published rate, {date}" when stale. */
const status = rate
  ? stale || !fetchedAt
    ? { lead: stale ? STALE_LEAD : freshLead, at: rate.date, text: dayMonth(rate.date) }
    : {
        lead: freshLead,
        at: fetchedAt,
        text: `${formatRateDate(fetchedAt)}, ${formatRateTime(fetchedAt)}`,
      }
  : null;

/** Page variant: the change of each karat since the previous recorded posting, in neutral ink. */
const previous = rate && variant === 'page' ? history.find((s) => s.date < rate.date) : undefined;
function change(k: DisplayKarat): string {
  if (!rate || !previous) return '';
  const d = Math.round((rate.perGram[k] - previous.perGram[k]) * 100) / 100;
  const since = `since ${dayMonth(previous.date)}`;
  if (d === 0) return `Unchanged ${since}`;
  return `${d > 0 ? 'Up' : 'Down'} AED ${Math.abs(d).toFixed(2)} ${since}`;
}
---

<div class="inst" data-variant={variant} id={id} data-rate-board data-rate-date={rate?.date}>
  {rate && status ? (
    <div class="inst__body">
      <p class="inst__label eyebrow">
        <span class="marker" data-stale={stale ? '' : undefined} />
        <span class="inst__line">
          {DISPLAY_KARATS.map((k) => (
            <span class="inst__kl" data-k={k}>
              {KARAT_FACTS[k].label}
            </span>
          ))}{' '}
          <span data-rate-lead data-fresh="today, AED per gram" data-stale-lead="AED per gram">
            {stale ? 'AED per gram' : 'today, AED per gram'}
          </span>
        </span>
      </p>

      <p class="inst__figs" aria-hidden="true">
        <span class="inst__aed">AED</span>
        <span class="inst__stack">
          {DISPLAY_KARATS.map((k) => (
            <span class="inst__fig" data-k={k}>
              <RateFigure rate={rate} karat={k} roll />
            </span>
          ))}
        </span>
      </p>

      <div class="inst__rule sheen-rule" data-sheen />

      <fieldset class="inst__keys">
        <legend class="sr-only">Show the rate for</legend>
        <span class="sr-only">Figures in AED per gram.</span>
        <div class="inst__board">
          {DISPLAY_KARATS.map((k) => (
            <label class="inst__key" for={`${id}-${k}`}>
              <input
                type="radio"
                id={`${id}-${k}`}
                name={`${id}-k`}
                value={k}
                checked={k === DEFAULT_KARAT}
                data-karat-input
              />
              <span class="inst__bar" aria-hidden="true" />
              <span class="inst__id">
                <span class="inst__karat">{KARAT_FACTS[k].label}</span>
                <span class="inst__stamp">{KARAT_FACTS[k].stamp}</span>
              </span>
              <RateFigure rate={rate} karat={k} class="inst__val" />
              {variant === 'page' && <span class="inst__fine">{KARAT_FACTS[k].percent} gold</span>}
              {variant === 'page' && (
                <span class="inst__change" data-rate-delta={k}>
                  {change(k)}
                </span>
              )}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="inst__status">
        <p class="small">
          <span data-rate-lead data-fresh={`${freshLead},`} data-stale-lead={`${STALE_LEAD},`}>
            {`${status.lead},`}
          </span>{' '}
          <time datetime={status.at} data-rate-time>
            {status.text}
          </time>
        </p>
        <p class="small">{site.rate.excludes}</p>
        <p class="small inst__delta" role="status">
          {DISPLAY_KARATS.map((k) => (
            <span class="inst__d" data-k={k} data-rate-delta={k} />
          ))}
        </p>
      </div>
    </div>
  ) : (
    <div class="inst__none">
      <p class="eyebrow">Gold rate, AED per gram</p>
      <p class="inst__call">
        Call for today’s rate{' '}
        <a class="inst__tel" href={`tel:${site.phone.landline.e164}`}>
          {site.phone.landline.display}
        </a>
      </p>
      <p class="small">{site.rate.excludes}</p>
    </div>
  )}
</div>

<style>
  /* ---------- Frame ---------- */
  /* The instrument is a size container: its layout follows its own column, not the viewport. */
  .inst {
    --inst-fig: var(--t-rate);
    container-type: inline-size;
    inline-size: 100%;
  }

  .inst__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'label'
      'figs'
      'rule'
      'keys'
      'status';
  }

  @media (min-width: 64em) {
    .inst {
      --inst-fig: min(var(--t-rate), 22svh);
    }
  }

  .inst[data-variant='compact'] {
    --inst-fig: var(--t-numeral-xl);
  }

  /* ---------- The label: "22K today, AED per gram" ---------- */
  .inst__label {
    grid-area: label;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .inst__kl {
    display: none;
    color: var(--fg);
  }

  .inst__kl[data-k='22k'] {
    display: inline;
  }

  /* ---------- The numeral: four figures stacked in one cell ---------- */
  .inst__figs {
    grid-area: figs;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    color: var(--numeral);
  }

  .inst__aed {
    font-family: var(--ff-text);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    line-height: 1;
    letter-spacing: var(--track-eyebrow);
    color: var(--eyebrow);
    text-box: trim-both cap alphabetic;
  }

  .inst__stack {
    display: grid;
    min-inline-size: 0;
  }

  .inst__fig {
    grid-area: 1 / 1;
    display: block;
    font-family: var(--ff-display);
    font-size: min(var(--inst-fig), 30cqi);
    font-weight: var(--fw-display);
    line-height: var(--lh-numeral);
    letter-spacing: var(--track-rate);
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
  }

  /* No :has(): the 22K figure only. */
  .inst__fig:not([data-k='22k']) {
    visibility: hidden;
  }

  /* ---------- The sheen rule, and the keys sitting on it ---------- */
  .inst__rule {
    grid-area: rule;
    margin-block-start: var(--space-5);
  }

  .inst__keys {
    grid-area: keys;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .inst__board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .inst__key {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-block-size: 4rem;
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3);
    cursor: pointer;
    transition: background-color var(--dur-quick) var(--ease-out);
  }

  .inst__key + .inst__key {
    border-inline-start: 1px solid var(--rule);
  }

  /* The radio covers its key: focusable, labelled, arrow keys move between karats. */
  .inst__key input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* The 2 px bar on the selected key, wiping in over the sheen rule. */
  .inst__bar {
    position: absolute;
    inset-inline: 0;
    inset-block-start: -1px;
    block-size: 2px;
    background: var(--wipe);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  :global([dir='rtl']) .inst__bar {
    transform-origin: 100% 50%;
  }

  .inst__id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  .inst__karat {
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    line-height: 1.2;
    letter-spacing: var(--track-eyebrow);
    color: var(--eyebrow);
  }

  .inst__stamp {
    padding: calc(var(--space-1) / 2) var(--space-1);
    border: 1px solid var(--rule-strong);
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    line-height: 1.1;
    letter-spacing: 0.06em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
  }

  .inst__key :global(.inst__val) {
    font-family: var(--ff-display);
    font-size: min(var(--t-numeral), 6.6cqi);
    font-weight: var(--fw-display-small);
    line-height: 1;
    white-space: nowrap;
    color: var(--body);
    transition: color var(--dur-quick) var(--ease-out);
  }

  .inst__key:hover :global(.inst__val),
  .inst__key input:checked ~ :global(.inst__val) {
    color: var(--fg);
  }

  .inst__key input:checked ~ .inst__bar {
    scale: 1 1;
  }

  .inst__key:has(input:checked) {
    background: var(--field-bg);
  }

  .inst__key:has(input:focus-visible) {
    z-index: var(--z-raised);
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* ---------- The status block: three lines, the third always reserved ---------- */
  .inst__status {
    grid-area: status;
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-5);
  }

  .inst__status p {
    line-height: 1.5;
  }

  .inst__status time {
    white-space: nowrap;
  }

  /*
   * Phones: the time on its own line, so the source line wraps the same way in the fallback
   * font and in Plex (the only layout shift Lighthouse found on the home page sat here).
   */
  @media (max-width: 39.99em) {
    .inst__status time {
      display: block;
    }
  }

  .inst__delta {
    min-block-size: 1lh;
    color: var(--body);
  }

  .inst__d {
    display: none;
  }

  .inst__d[data-k='22k'] {
    display: inline;
  }

  /* ---------- The karat switch: CSS only, scoped to this instrument ----------
     The swap is instant: two figures never show at once. With JavaScript, rate.ts then rolls the
     new figure's digits in from the old one's, as on a real change. */
  @supports selector(:has(*)) {
    .inst__fig,
    .inst__fig:not([data-k='22k']) {
      visibility: hidden;
    }

    .inst__kl[data-k],
    .inst__d[data-k] {
      display: none;
    }

    .inst:has(input[value='24k']:checked) .inst__fig[data-k='24k'],
    .inst:has(input[value='22k']:checked) .inst__fig[data-k='22k'],
    .inst:has(input[value='21k']:checked) .inst__fig[data-k='21k'],
    .inst:has(input[value='18k']:checked) .inst__fig[data-k='18k'] {
      visibility: visible;
    }

    .inst:has(input[value='24k']:checked) :is(.inst__kl, .inst__d)[data-k='24k'],
    .inst:has(input[value='22k']:checked) :is(.inst__kl, .inst__d)[data-k='22k'],
    .inst:has(input[value='21k']:checked) :is(.inst__kl, .inst__d)[data-k='21k'],
    .inst:has(input[value='18k']:checked) :is(.inst__kl, .inst__d)[data-k='18k'] {
      display: inline;
    }
  }

  /* ---------- page: the numeral left, the keys as a vertical board right ---------- */
  .inst[data-variant='page'] .inst__board {
    grid-template-columns: minmax(0, 1fr);
    border-block-end: 1px solid var(--rule);
  }

  .inst[data-variant='page'] .inst__key {
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      'id fine val'
      'id change val';
    align-items: center;
    gap: var(--space-1) var(--space-4);
    min-block-size: 4.5rem;
    padding: var(--space-4) var(--space-3) var(--space-4) var(--space-4);
  }

  .inst[data-variant='page'] .inst__key + .inst__key {
    border-inline-start: 0;
    border-block-start: 1px solid var(--rule);
  }

  .inst[data-variant='page'] .inst__bar {
    inset-block: 0;
    inset-inline: 0 auto;
    inline-size: 2px;
    block-size: auto;
    scale: 1 0;
    transform-origin: 50% 0;
  }

  .inst[data-variant='page'] .inst__key input:checked ~ .inst__bar {
    scale: 1 1;
  }

  .inst[data-variant='page'] .inst__id {
    grid-area: id;
    flex-direction: column;
    align-items: flex-start;
  }

  .inst[data-variant='page'] .inst__key :global(.inst__val) {
    grid-area: val;
    font-size: var(--t-numeral);
  }

  .inst__fine {
    grid-area: fine;
    align-self: end;
    font-size: var(--t-small);
    line-height: 1.4;
    color: var(--body);
  }

  .inst__change {
    grid-area: change;
    align-self: start;
    font-size: var(--t-caption);
    line-height: 1.4;
    color: var(--muted);
  }

  .inst__change:empty {
    display: none;
  }

  /* The board beside the numeral once the instrument itself is 56 rem wide. */
  @container (min-width: 56rem) {
    .inst[data-variant='page'] .inst__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas:
        'label keys'
        'figs keys'
        'rule keys'
        'status keys';
      column-gap: calc(var(--grid-gap) * 2);
    }

    .inst[data-variant='page'] .inst__keys {
      align-self: start;
    }

    /* The numeral shares the width with the board: about 7/12 of it, AED label included. */
    .inst[data-variant='page'] .inst__fig {
      font-size: min(var(--inst-fig), 20cqi);
    }

    .inst[data-variant='page'] .inst__board {
      border-block-start: 1px solid var(--rule-strong);
    }
  }

  /* ---------- compact: a smaller numeral for festivals and offers ---------- */
  .inst[data-variant='compact'] .inst__figs {
    margin-block-start: var(--space-3);
  }

  .inst[data-variant='compact'] .inst__rule,
  .inst[data-variant='compact'] .inst__status {
    margin-block-start: var(--space-4);
  }

  /* ---------- No rate: the numeral area becomes a call ---------- */
  .inst__none {
    display: grid;
    gap: var(--space-4);
  }

  .inst__call {
    font-family: var(--ff-display);
    font-size: var(--t-h2);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    color: var(--fg);
  }

  .inst__tel {
    display: block;
    color: var(--numeral);
    font-variant-numeric: lining-nums tabular-nums;
    text-decoration-color: var(--rule-strong);
  }

  /* A narrow instrument (phones): four keys across at 72 px or more, values on one line. */
  @container (max-width: 34rem) {
    .inst__key {
      padding-inline: var(--space-2) var(--space-1);
    }

    .inst[data-variant='page'] .inst__key {
      grid-template-columns: 3.75rem minmax(0, 1fr) auto;
      grid-template-areas:
        'id fine val'
        'id change change';
      column-gap: var(--space-3);
      padding-inline: var(--space-3) var(--space-2);
    }
  }

  @media (forced-colors: active) {
    .inst__key:has(input:checked) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }
</style>
