---
/**
 * A piece's specification (docs/design-system-v2.md §5.5, §6.4): a ruled two-column table that
 * reads like a definition list, the label in eyebrow type (bronze on the stage, gold on light
 * grounds), the value in the tone's body colour. Tone-aware, so it sits on the stage or ivory.
 * Rows whose value is missing are dropped, so a page never prints a dash; the page decides the
 * wording of a fact it does not have yet (weight: "On request, weighed in front of you").
 */
export interface Props {
  /** Label and value pairs in display order. Empty or undefined values are omitted. */
  rows: { label: string; value?: string | number | null }[];
  /** Visually hidden caption for assistive technology. */
  caption?: string;
  class?: string;
}

const { rows, caption = 'Specification', class: className } = Astro.props;
const present = rows
  .map((r) => ({
    label: r.label,
    value: r.value === null || r.value === undefined ? '' : String(r.value).trim(),
  }))
  .filter((r) => r.value.length > 0);
---

<table class:list={['spec', className]}>
  <caption class="sr-only">{caption}</caption>
  <tbody>
    {present.map((r) => (
      <tr class="spec__row">
        <th class="spec__label eyebrow" scope="row">
          {r.label}
        </th>
        <td class="spec__value">{r.value}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .spec {
    border-block-start: 1px solid var(--rule);
  }

  .spec__row {
    border-block-end: 1px solid var(--rule);
  }

  .spec__label,
  .spec__value {
    padding-block: var(--space-3);
    text-align: start;
    vertical-align: baseline;
  }

  /* .eyebrow is inline-flex; in a cell it stays a table cell. */
  .spec__label {
    display: table-cell;
    inline-size: 38%;
    padding-inline-end: var(--space-5);
    line-height: 1.6;
  }

  .spec__value {
    font-size: var(--t-small);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--body);
  }
</style>
