---
/**
 * A full-bleed plum section. The page may use at most two (plus the footer). Children inherit
 * the on-plum colour rules via data-surface="plum" (see base.css and Eyebrow).
 */
export interface Props {
  id?: string;
  class?: string;
  /** Use the deeper plum (utility strip and footer tone). */
  deep?: boolean;
}

const { id, class: className, deep = false } = Astro.props;
---

<section class:list={['band', deep && 'band--deep', className]} id={id} data-surface="plum">
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .band {
    padding-block: var(--section-y);
    background: var(--surface-plum);
    color: var(--ink-on-plum);
  }

  .band--deep {
    background: var(--surface-plum-deep);
  }

  .band :global(h2),
  .band :global(h3) {
    color: var(--ink-on-plum);
  }

  .band :global(p) {
    color: var(--ink-on-plum-muted);
  }
</style>
