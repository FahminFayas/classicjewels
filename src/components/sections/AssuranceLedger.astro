---
/**
 * The written promises as a numbered ledger (docs/design-system-v2.md §5.6, §6.4, §6.12, §6.15).
 * Each row links to its terms on /our-promise/#{id}. Tone-aware: numerals in --numeral, titles in
 * --fg, details in --body, hairlines in --rule, so it sits on ivory or on the stage alike.
 *
 *   full       every promise, two columns on wide screens (the promise page)
 *   condensed  the hallmark, diamond and returns promises in a three-column row (piece pages,
 *              About)
 *
 * The exchange promise is never shown with its "no weight deduction" title until the owner
 * confirms the terms (site.exchange.confirmed): until then the full ledger reads "Old gold
 * exchanged at the day's rate" with its detail, and the condensed one leaves it out anyway.
 */
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { routes } from '@/lib/routes';

export interface Props {
  variant?: 'full' | 'condensed';
  class?: string;
}

const { variant = 'full', class: className } = Astro.props;

const CONDENSED = ['hallmark-916', 'certified-diamonds', 'returns'];
const promises = site.promises.map((p) =>
  p.id === 'gold-exchange' && !site.exchange.confirmed
    ? { ...p, title: 'Old gold exchanged at the day’s rate' }
    : p,
);
const rows =
  variant === 'condensed'
    ? CONDENSED.flatMap((id) => promises.filter((p) => p.id === id))
    : promises;
---

<ol class:list={['ledger', `ledger--${variant}`, className]} role="list">
  {rows.map((p, i) => (
    <li class="ledger__row">
      <a class="ledger__link" href={`${routes.promise}#${p.id}`}>
        <span class="ledger__no fig" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="ledger__text">
          <span class="ledger__title">{p.title}</span>
          <span class="ledger__detail">{p.detail}</span>
        </span>
        <Icon name="arrow-right" class="ledger__arrow" />
      </a>
    </li>
  ))}
</ol>

<style>
  .ledger {
    display: grid;
    border-block-start: 1px solid var(--rule);
  }

  .ledger__row {
    min-inline-size: 0;
    border-block-end: 1px solid var(--rule);
  }

  .ledger__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-4) var(--space-5);
    block-size: 100%;
    padding-block: var(--space-6);
    color: var(--fg);
    text-decoration: none;
  }

  .ledger__no {
    min-inline-size: 2ch;
    font-family: var(--ff-display);
    font-size: var(--t-numeral);
    font-weight: var(--fw-display-small);
    line-height: 1;
    color: var(--numeral);
  }

  .ledger__text {
    display: grid;
    gap: var(--space-2);
  }

  .ledger__title {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.16em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }

  .ledger__link:is(:hover, :focus-visible) .ledger__title {
    text-decoration-color: var(--wipe);
  }

  .ledger__detail {
    max-inline-size: 52ch;
    color: var(--body);
  }

  .ledger :global(.ledger__arrow) {
    margin-block-start: 0.4em;
    color: var(--wipe);
  }

  .ledger--condensed .ledger__link {
    padding-block: var(--space-5);
  }

  .ledger--condensed .ledger__detail {
    font-size: var(--t-small);
    line-height: 1.5;
  }

  @media (min-width: 56.25em) {
    .ledger--full {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-8);
    }

    /* Three promises across, each its own ruled cell. */
    .ledger--condensed {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      border-block-start: 0;
    }

    .ledger--condensed .ledger__row {
      border-block: 1px solid var(--rule);
    }

    .ledger--condensed .ledger__link {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .ledger--condensed :global(.ledger__arrow) {
      display: none;
    }
  }
</style>
