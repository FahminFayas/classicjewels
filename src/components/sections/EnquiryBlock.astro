---
/**
 * The conversion block that ends most pages: a WhatsApp link with a pre-filled message, the
 * landline, and a link to the shop. Pass `reference` on product pages to add "Copy reference".
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { routes } from '@/lib/routes';
import { whatsappGeneral } from '@/lib/whatsapp';

export interface Props {
  heading?: string;
  text?: string;
  /** Full wa.me URL with the page-specific message. */
  whatsappUrl?: string;
  whatsappLabel?: string;
  /** Product SKU; renders a copy-to-clipboard button. */
  reference?: string;
  /** Tighter spacing for use inside a sticky product column. */
  compact?: boolean;
  class?: string;
}

const {
  heading = 'Ask us about a piece',
  text = 'WhatsApp is fastest during shop hours. Calls go straight to the counter.',
  whatsappUrl = whatsappGeneral(),
  whatsappLabel = 'Enquire on WhatsApp',
  reference,
  compact = false,
  class: className,
} = Astro.props;
---

<div class:list={['enquiry', compact && 'enquiry--compact', className]}>
  {!compact && <h2 class="enquiry__heading">{heading}</h2>}
  <p class="enquiry__text">{text}</p>
  <div class="enquiry__actions">
    <Button href={whatsappUrl} icon="whatsapp" external>
      {whatsappLabel}
    </Button>
    <Button href={`tel:${site.phone.landline.e164}`} variant="secondary" icon="phone">
      Call {site.phone.landline.display}
    </Button>
  </div>
  <ul class="enquiry__links small" role="list">
    <li>
      <a href={routes.stores}>
        <Icon name="map-pin" /> Visit a store: Dubai, Sharjah, Abu Dhabi
      </a>
    </li>
    {reference && (
      <li>
        <button class="enquiry__copy" type="button" data-copy={reference}>
          <Icon name="copy" />
          <span data-copy-label>Copy reference {reference}</span>
        </button>
      </li>
    )}
  </ul>
</div>

<style>
  .enquiry {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7);
    border-block: 1px solid var(--rule-1);
  }

  .enquiry--compact {
    padding-block: var(--space-5);
    border-block-end: 0;
  }

  .enquiry__heading {
    font-size: var(--t-h2);
  }

  .enquiry__text {
    max-inline-size: 40rem;
    color: var(--ink-700);
  }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .enquiry__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .enquiry__links a,
  .enquiry__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap);
    color: var(--ink-700);
    text-decoration: none;
  }

  .enquiry__links a:hover,
  .enquiry__copy:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
  }

  .enquiry__copy[data-copied='true'] {
    color: var(--ok);
  }
</style>
