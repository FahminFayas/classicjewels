---
/**
 * Page opener: eyebrow, H1, lead and actions in a 5-column text block, media in the 7-column
 * block. On phones the text comes first in the DOM so the H1 is the largest contentful paint.
 *
 * media="image": a lifestyle photo (3:2 on wide screens, 4:5 on phones), the LCP on desktop.
 * media="plate": a product photo on a white plate.
 * media="none":  typographic hero, text spans 7 columns, optional margin note in the `note` slot.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Plate from '@/components/ui/Plate.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Use the larger display size (home and hub pages). */
  display?: boolean;
  media?: 'image' | 'plate' | 'none';
  image?: ImageMetadata;
  imageAlt?: string;
  /** Literal description shown under the photo. */
  caption?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  display = false,
  media = 'none',
  image,
  imageAlt = '',
  caption,
  class: className,
} = Astro.props;
const hasMedia = media !== 'none' && image;
---

<section class:list={['hero', hasMedia ? 'hero--media' : 'hero--text', className]}>
  <div class="container container--wide hero__grid">
    <div class="hero__text">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 class:list={['hero__title', display && 'display']} set:text={title} />
      {lead && <p class="hero__lead lead" set:text={lead} />}
      {Astro.slots.has('default') && (
        <div class="hero__actions">
          <slot />
        </div>
      )}
    </div>
    {hasMedia && media === 'image' && (
      <figure class="hero__media">
        <Picture
          class="hero__img"
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 768, 1024, 1488]}
          sizes="(min-width: 64em) 58vw, 100vw"
          fit="cover"
          priority
        />
        {caption && <figcaption class="caption hero__caption">{caption}</figcaption>}
      </figure>
    )}
    {hasMedia && media === 'plate' && (
      <figure class="hero__media hero__media--plate">
        <Plate
          image={image}
          alt={imageAlt}
          widths={[480, 768, 1024]}
          sizes="(min-width: 64em) 50vw, 100vw"
          priority
          padding="10%"
        />
        {caption && <figcaption class="caption hero__caption">{caption}</figcaption>}
      </figure>
    )}
    {Astro.slots.has('note') && (
      <aside class="hero__note note">
        <slot name="note" />
      </aside>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__text {
    max-inline-size: 40rem;
  }

  .hero__lead {
    margin-block-start: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__media {
    min-inline-size: 0;
  }

  .hero__img :global(img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hero__caption {
    margin-block-start: var(--space-3);
  }

  .hero__note {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    max-inline-size: 18rem;
  }

  .hero__note::before {
    content: '';
    flex: none;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 1.25px solid var(--gold-600);
    border-radius: 50%;
    clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
    transform: translateY(0.05em);
  }

  @media (min-width: 64em) {
    .hero {
      padding-block: var(--space-9) var(--space-8);
    }

    .hero--media .hero__grid {
      grid-template-columns: 5fr 7fr;
      column-gap: calc(var(--grid-gap) * 2);
    }

    .hero--text .hero__grid {
      grid-template-columns: 2fr 7fr 3fr;
      column-gap: calc(var(--grid-gap) * 2);
    }

    .hero--text .hero__text {
      grid-column: 2;
      max-inline-size: 44rem;
    }

    .hero--text .hero__note {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      padding-block-start: var(--space-2);
    }

    .hero--media .hero__note {
      grid-column: 1;
    }

    .hero__img :global(img) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
