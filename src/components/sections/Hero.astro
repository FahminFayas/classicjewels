---
/**
 * Page opener: eyebrow, H1, lead and actions in a 5-column text block, media in the 7-column
 * block. On phones the text comes first in the DOM so the H1 is the largest contentful paint.
 *
 * media="image":  a photograph. `shape="landscape"` (default) crops 3:2 on wide screens and 4:5
 *                 on phones; `shape="portrait"` keeps 4:5 and caps the height to the viewport so
 *                 the H1 stays above the fold.
 * media="plate":  a product photo on a square plate (see Plate.astro).
 * media="banner": a 5:2 cut-out strip (the category photographs), shown full-bleed in a box.
 * media="none":   typographic hero; text spans 7 columns, optional margin note in the `note` slot.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Eyebrow from '@/components/ui/Eyebrow.astro';
import Plate from '@/components/ui/Plate.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Use the larger display size (home and hub pages). */
  display?: boolean;
  media?: 'image' | 'plate' | 'banner' | 'none';
  /** Crop for media="image". */
  shape?: 'landscape' | 'portrait';
  image?: ImageMetadata;
  imageAlt?: string;
  /** Literal description shown under the photo. */
  caption?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  display = false,
  media = 'none',
  shape = 'landscape',
  image,
  imageAlt = '',
  caption,
  class: className,
} = Astro.props;
const hasMedia = media !== 'none' && image;
/** Never request a rendition wider than the source. */
const widthsFor = (img: ImageMetadata, wanted: number[]) => [
  ...new Set([...wanted.filter((w) => w < img.width), img.width]),
];
---

<section
  class:list={[
    'hero',
    hasMedia ? 'hero--media' : 'hero--text',
    hasMedia && `hero--${media}`,
    hasMedia && media === 'image' && `hero--${shape}`,
    className,
  ]}
>
  <div class="container hero__grid">
    <div class="hero__text">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 class:list={['hero__title', display && 'display']} set:text={title} />
      {lead && <p class="hero__lead lead" set:text={lead} />}
      {Astro.slots.has('default') && (
        <div class="hero__actions">
          <slot />
        </div>
      )}
    </div>
    {hasMedia && media === 'image' && (
      <figure class="hero__media">
        <Picture
          class="hero__img"
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={widthsFor(image, [480, 768, 1024, 1488])}
          sizes="(min-width: 64em) 58vw, 100vw"
          fit="cover"
          position={shape === 'portrait' ? 'top' : 'centre'}
          priority
        />
        {caption && <figcaption class="caption hero__caption">{caption}</figcaption>}
      </figure>
    )}
    {hasMedia && media === 'plate' && (
      <figure class="hero__media hero__media--plate">
        <Plate
          image={image}
          alt={imageAlt}
          widths={[480, 768, 1024]}
          sizes="(min-width: 64em) 50vw, 100vw"
          priority
          padding="10%"
        />
        {caption && <figcaption class="caption hero__caption">{caption}</figcaption>}
      </figure>
    )}
    {hasMedia && media === 'banner' && (
      <figure class="hero__media hero__media--banner">
        <Picture
          class="hero__banner"
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={widthsFor(image, [480, 800])}
          sizes="(min-width: 64em) 58vw, 100vw"
          fit="cover"
          priority
        />
        {caption && <figcaption class="caption hero__caption">{caption}</figcaption>}
      </figure>
    )}
    {Astro.slots.has('note') && (
      <aside class="hero__note note">
        <span class="hero__note-text">
          <slot name="note" />
        </span>
      </aside>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__text {
    max-inline-size: 40rem;
  }

  .hero__title {
    max-inline-size: 24ch;
    text-wrap: balance;
  }

  .hero__lead {
    margin-block-start: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__media {
    min-inline-size: 0;
  }

  /* <Picture class> lands on the <img>, so target it directly. */
  .hero__media :global(img.hero__img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hero__media--banner {
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--surface-0);
    border: 1px solid var(--rule-1);
  }

  .hero__media--banner :global(img.hero__banner) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .hero__caption {
    margin-block-start: var(--space-3);
  }

  /* Two flex items only (the ring and one text run), however much markup the slot holds. */
  .hero__note {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    max-inline-size: 18rem;
  }

  .hero__note::before {
    content: '';
    flex: none;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 1.25px solid var(--gold-600);
    border-radius: 50%;
    clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
    transform: translateY(0.05em);
  }

  .hero__note-text {
    min-inline-size: 0;
  }

  @media (min-width: 64em) {
    .hero {
      padding-block: var(--space-9) var(--space-8);
    }

    .hero--media .hero__grid {
      grid-template-columns: 5fr 7fr;
      column-gap: calc(var(--grid-gap) * 2);
    }

    /* A tall portrait would push a vertically centred H1 below the fold. */
    .hero--portrait .hero__grid {
      align-items: start;
    }

    .hero--text .hero__grid {
      grid-template-columns: 2fr 7fr 3fr;
      column-gap: calc(var(--grid-gap) * 2);
    }

    .hero--text .hero__text {
      grid-column: 2;
      max-inline-size: 44rem;
    }

    .hero--text .hero__note {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      padding-block-start: var(--space-2);
    }

    .hero--media .hero__note {
      grid-column: 1;
    }

    .hero--landscape .hero__media :global(img.hero__img) {
      aspect-ratio: 3 / 2;
    }

    .hero--portrait .hero__media :global(img.hero__img) {
      max-block-size: calc(100svh - var(--header-h) - var(--space-9));
    }
  }
</style>
