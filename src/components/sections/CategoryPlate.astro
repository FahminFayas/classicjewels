---
/**
 * One category as a link card (docs/design-system-v2.md §5.5; replaces CategoryTile). The media
 * is a square on the photograph's own ground, so a row of them reads as one counter:
 *
 *   velvet category (necklaces)  a StageImage (spot mask) on a small stage square
 *   studio category              a Plate of its first cut-out on lilac, 180 px at most
 *   nothing photographed         a typeset parchment square with the category's name in
 *                                Cormorant italic (coins and bars), never a borrowed photograph
 *
 * Below it the category's short name in Cormorant 400 and, only from three pieces up, the count
 * ("9 pieces"). The image is decorative (the name labels the link), so its alt is empty unless
 * the page passes one. Hover and focus draw the name's wipe and an --accent hairline under the
 * square; nothing moves.
 */
import type { ImageMetadata } from 'astro';

import Plate from '@/components/ui/Plate.astro';
import StageImage from '@/components/ui/StageImage.astro';
import type { Category } from '@/lib/content';
import { routes } from '@/lib/routes';

export interface Props {
  category: Category;
  image?: ImageMetadata;
  imageAlt?: string;
  count?: number;
}

const { category, image, imageAlt = '', count } = Astro.props;
const name = category.data.shortName ?? category.data.name;
const velvet = category.data.ground === 'velvet';
const cap = 180;
/** The typeset square spells the name out: "Coins and bars". */
const typeset = name.replace(/\s*&\s*/g, ' and ');
---

<a class="cplate" href={routes.category(category.id)}>
  <span
    class:list={[
      'cplate__media',
      !image ? 'cplate__media--type' : velvet ? 'cplate__media--stage' : 'cplate__media--plate',
    ]}
    data-tone={image && velvet ? 'stage' : undefined}
  >
    {image ? (
      velvet ? (
        <StageImage image={image} alt={imageAlt} mask="spot" cap={cap} sizes={`${cap}px`} />
      ) : (
        <Plate image={image} alt={imageAlt} cap={cap} sizes={`${cap}px`} />
      )
    ) : (
      <span class="cplate__type" aria-hidden="true">
        {typeset}
      </span>
    )}
  </span>
  <span class="cplate__text">
    <span class="cplate__name">{name}</span>
    {count !== undefined && count >= 3 && (
      <span class="cplate__count small fig">{count} pieces</span>
    )}
  </span>
</a>

<style>
  .cplate {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    block-size: 100%;
    color: var(--fg);
    text-decoration: none;
  }

  .cplate:hover {
    color: var(--fg);
  }

  .cplate__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: var(--space-3);
    overflow: clip;
  }

  .cplate__media--plate {
    background: var(--plate-lilac);
  }

  .cplate__media--type {
    background: var(--surface-2);
  }

  /* The --accent hairline under the square, drawn on hover and focus. */
  .cplate__media::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  .cplate__media--stage::after {
    background: var(--champagne);
  }

  .cplate:is(:hover, :focus-visible) .cplate__media::after {
    scale: 1 1;
  }

  .cplate__media :global(.stage-img),
  .cplate__media :global(.plate) {
    inline-size: min(100%, var(--cap));
  }

  .cplate__type {
    font-family: var(--ff-display);
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-900);
  }

  .cplate__text {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-3) 0;
  }

  .cplate__name {
    position: relative;
    justify-self: start;
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: var(--fw-display-small);
    line-height: 1.15;
  }

  .cplate__name::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: var(--wipe);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  .cplate:is(:hover, :focus-visible) .cplate__name::after {
    scale: 1 1;
  }

  .cplate__count {
    color: var(--muted);
  }
</style>
