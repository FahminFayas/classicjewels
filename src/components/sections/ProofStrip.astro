---
/**
 * The proof strip under the home hero: four facts a buyer checks, each linked to its evidence
 * (the rate page, the Google listing, the exchange terms, the store list). Values come from
 * site.ts and the baked rate; nothing here is typed by hand.
 */
import { openBranches, site } from '@/data/site';
import { countWord } from '@/lib/format';
import type { GoldRate } from '@/lib/gold-rate';
import { routes } from '@/lib/routes';

export interface Props {
  rate: GoldRate | null;
}

const { rate } = Astro.props;
const items = [
  rate
    ? {
        label: '22K today',
        value: `AED ${rate.perGram['22k'].toFixed(2)} / g`,
        detail: 'Dubai Jewellery Group rate, posted daily',
        href: routes.goldRate,
        live: true,
      }
    : {
        label: 'Gold rate',
        value: 'Posted daily',
        detail: 'Call the shop for today’s rate',
        href: routes.goldRate,
      },
  {
    label: 'On Google',
    value: `${site.reviews.rating.toFixed(1)} from ${site.reviews.count} reviews`,
    detail: 'Deira flagship, read them yourself',
    href: site.reviews.url,
    external: true,
  },
  {
    label: 'Old gold',
    value: '0% deduction on exchange',
    detail: 'Weighed and tested in front of you',
    href: routes.goldExchange,
  },
  {
    label: 'Branches',
    value: `${countWord(openBranches.length)} across the UAE`,
    detail: 'Dubai, Sharjah and Abu Dhabi',
    href: routes.stores,
  },
];
---

<section class="proof" aria-label="Facts about Classic Jewels">
  <div class="container">
    <ul class="proof__list" role="list">
      {items.map((item) => (
        <li class="proof__item">
          <a
            class="proof__link"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            <span class="proof__label">{item.label}</span>
            <span class="proof__value tabular">
              {item.live ? (
                <>
                  AED <span data-rate="22k">{rate!.perGram['22k'].toFixed(2)}</span> / g
                </>
              ) : (
                item.value
              )}
            </span>
            <span class="proof__detail small">{item.detail}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proof {
    border-block: 1px solid var(--rule-1);
  }

  .proof__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proof__item {
    border-block-end: 1px solid var(--rule-1);
  }

  .proof__item:nth-child(odd) {
    border-inline-end: 1px solid var(--rule-1);
  }

  .proof__link {
    display: grid;
    gap: var(--space-1);
    min-block-size: 100%;
    padding: var(--space-4) var(--space-3);
    color: var(--ink-900);
    text-decoration: none;
  }

  .proof__label {
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--gold-700);
  }

  .proof__value {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: 500;
    line-height: 1.2;
  }

  .proof__link:hover .proof__value {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
    text-underline-offset: 0.15em;
  }

  .proof__detail {
    color: var(--ink-500);
  }

  @media (min-width: 56.25em) {
    .proof__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .proof__item {
      border-block-end: 0;
    }

    .proof__item:not(:last-child) {
      border-inline-end: 1px solid var(--rule-1);
    }

    .proof__link {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
