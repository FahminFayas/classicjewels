---
/**
 * Category link tile: the cut-out photo in a 5:2 box, the name and the piece count.
 * Categories without a photograph (coins & bars, until it is shot) get a typeset tile in the
 * same box instead of a placeholder image. The whole tile is one anchor.
 */
import { Picture } from 'astro:assets';

import type { Category } from '@/lib/content';
import { routes } from '@/lib/routes';

export interface Props {
  category: Category;
  count?: number;
  class?: string;
}

const { category, count, class: className } = Astro.props;
const { data } = category;
const image = data.image;
const widths = image
  ? [...new Set([...[400, 800].filter((w) => w < image.width), image.width])]
  : [];
const label = data.shortName ?? data.name;
---

<a class:list={['tile', className]} href={routes.category(category.id)}>
  <span class:list={['tile__media', !image && 'tile__media--type']}>
    {image ? (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={widths}
        sizes="(min-width: 64em) 25vw, 50vw"
        fit="cover"
      />
    ) : (
      <span class="tile__type" aria-hidden="true">
        {label}
      </span>
    )}
  </span>
  <span class="tile__text">
    <span class="tile__name">{label}</span>
    {typeof count === 'number' && count > 0 && (
      <span class="tile__count small">
        {count} {count === 1 ? 'piece' : 'pieces'}
      </span>
    )}
  </span>
</a>

<style>
  .tile {
    display: grid;
    align-content: start;
    min-inline-size: 0;
    gap: var(--space-3);
    color: var(--ink-900);
    text-decoration: none;
  }

  /* The category photographs are 5:2 cut-outs on their own pale ground, so they fill the box. */
  .tile__media {
    display: block;
    min-inline-size: 0;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--surface-0);
    border: 1px solid var(--rule-1);
  }

  .tile__media :global(picture) {
    display: block;
    block-size: 100%;
  }

  .tile__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Typeset tile: the plum "velvet tray" with the name in champagne, for coins and bars. */
  .tile__media--type {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-plum);
    border-color: var(--surface-plum);
  }

  .tile__type {
    font-family: var(--ff-display);
    font-size: var(--t-h3);
    font-weight: 500;
    color: var(--gold-300);
  }

  .tile__text {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .tile__name {
    font-size: var(--t-title);
    font-weight: 500;
  }

  .tile:hover .tile__name {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
    text-underline-offset: 0.2em;
  }
</style>
