---
/**
 * The one contact form on the site. It posts natively to PUBLIC_FORM_ENDPOINT (by default the PHP
 * endpoint in public/api/contact.php, which redirects to /thank-you/); with src/scripts/form.ts it
 * submits in place and shows the reply under the button. Spam defences match the endpoint: a
 * honeypot named "website", and "fill_ms" (how long the form was open, measured on the device by
 * form.ts at submit; absent without JavaScript, in which case the endpoint skips the check).
 */
import { PUBLIC_FORM_ENDPOINT } from 'astro:env/client';

import Button from '@/components/ui/Button.astro';
import { openBranches } from '@/data/site';

export interface Props {
  /** Pre-fills the piece reference, e.g. when linked from a product page. */
  reference?: string;
  /** Pre-selects a branch by its id. */
  branch?: string;
  class?: string;
}

const { reference, branch, class: className } = Astro.props;

const topics = [
  'General enquiry',
  'A specific piece',
  'Bridal or wedding order',
  'Custom design',
  'Gold exchange',
  'Coins and bars',
  'Current offer',
];
---

<form class:list={['form', className]} method="post" action={PUBLIC_FORM_ENDPOINT} data-enhance>
  <div class="form__fields" data-form-fields>
    <div class="form__row">
      <div class="field">
        <label class="field__label" for="cf-name">
          Name (required)
        </label>
        <input
          class="field__input"
          id="cf-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          maxlength="120"
        />
      </div>
      <div class="field">
        <label class="field__label" for="cf-email">
          Email (required)
        </label>
        <input
          class="field__input"
          id="cf-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          maxlength="200"
        />
      </div>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="cf-phone">
          Phone
        </label>
        <input
          class="field__input"
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="40"
          aria-describedby="cf-phone-hint"
        />
        <p class="field__hint" id="cf-phone-hint">
          Optional. Include the country code, e.g. +971.
        </p>
      </div>
      <div class="field">
        <label class="field__label" for="cf-branch">
          Branch
        </label>
        <select class="field__input" id="cf-branch" name="branch">
          <option value="">Any branch</option>
          {openBranches.map((b) => (
            <option value={b.name} selected={b.id === branch}>
              {b.name}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="cf-topic">
          Topic
        </label>
        <select class="field__input" id="cf-topic" name="topic">
          {topics.map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="cf-reference">
          Piece reference
        </label>
        <input
          class="field__input"
          id="cf-reference"
          name="reference"
          type="text"
          value={reference}
          maxlength="40"
          autocomplete="off"
          aria-describedby="cf-reference-hint"
        />
        <p class="field__hint" id="cf-reference-hint">
          Piece reference, e.g. CJ-NK-001
        </p>
      </div>
    </div>

    <div class="field">
      <label class="field__label" for="cf-message">
        Message (required)
      </label>
      <textarea
        class="field__input"
        id="cf-message"
        name="message"
        rows="6"
        required
        maxlength="4000"
      ></textarea>
    </div>

    <div class="form__trap sr-only" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input
        id="cf-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
    </div>
    <input type="hidden" name="fill_ms" value="" data-fill-ms />

    <p class="form__privacy small">We use your details only to reply.</p>
    <div class="form__actions">
      <Button type="submit" iconEnd="arrow-right">
        Send message
      </Button>
    </div>
  </div>
  <!-- Rendered (empty) from the start so assistive technology registers the live region before
       its text changes; an element revealed and filled in the same tick is often not announced. -->
  <p class="form__status" data-form-status role="status" aria-live="polite" tabindex="-1"></p>
</form>

<script src="@/scripts/form.ts"></script>

<style>
  .form {
    display: grid;
    gap: var(--space-5);
  }

  .form__fields {
    display: grid;
    gap: var(--space-5);
  }

  .form__fields[hidden] {
    display: none;
  }

  .form__row {
    display: grid;
    gap: var(--space-5);
  }

  select.field__input {
    padding-inline-end: var(--space-6);
  }

  .form__privacy {
    color: var(--ink-500);
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .form__status {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule-2);
    background: var(--surface-2);
    color: var(--ink-900);
  }

  /* Empty until there is something to say; stays in the accessibility tree either way. */
  .form__status:empty {
    padding: 0;
    border: 0;
  }

  .form__status[data-tone='ok'] {
    border-color: var(--ok);
    color: var(--ok);
  }

  .form__status[data-tone='err'] {
    border-color: var(--err);
    color: var(--err);
  }

  @media (min-width: 40em) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
