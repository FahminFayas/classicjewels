---
/**
 * The rate record table (docs/design-system-v2.md §5.4 RateBoard): one row per recorded posting,
 * newest first, with the four karats we print and the change in 22K since the previous posting,
 * in neutral ink (never red or green). Rendered inside RateRecord on /gold-rate/. Every figure
 * comes from src/content/rates (or the live feed at build); nothing is interpolated.
 *
 * The old band and mini variants are retired. Their props are still accepted, and ignored, so
 * a page that has not been rebuilt yet keeps compiling until WP6 removes them.
 */
import { formatDate } from '@/lib/format';
import type { GoldRate } from '@/lib/gold-rate';
import { getRates, type RateSnapshot } from '@/lib/rates';
import { DISPLAY_KARATS, KARAT_FACTS } from '@/lib/tones';

export interface Props {
  /** Snapshots, newest first. Defaults to every snapshot recorded at build. */
  history?: RateSnapshot[];
  /** How many of the newest postings to list (all by default). */
  rows?: number;
  /** @deprecated Retired with the band and mini variants; ignored. */
  rate?: GoldRate | null;
  /** @deprecated Retired: the board is now only the record table; ignored. */
  variant?: string;
  /** @deprecated Ignored. */
  stale?: boolean;
  id?: string;
}

const { history: given, rows, id } = Astro.props;
const history = given ?? (await getRates()).history;
const shown = rows ? history.slice(0, rows) : history;

/** "Down 5.50", "Up 2.50", "Unchanged"; the oldest posting on record has nothing to compare. */
function change(i: number): { text: string; first: boolean } {
  const now = history[i];
  const before = history[i + 1];
  if (!now || !before) return { text: 'Start of record', first: true };
  const d = Math.round((now.perGram['22k'] - before.perGram['22k']) * 100) / 100;
  if (d === 0) return { text: 'Unchanged', first: false };
  return { text: `${d > 0 ? 'Up' : 'Down'} ${Math.abs(d).toFixed(2)}`, first: false };
}
---

<table class="record" id={id}>
  <caption class="sr-only">
    Posted gold rates, AED per gram, newest first, with the change in 22K since the previous posting
  </caption>
  <thead>
    <tr>
      <th scope="col">Posted</th>
      {DISPLAY_KARATS.map((k) => (
        <th scope="col" class="record__num">
          {KARAT_FACTS[k].label}
        </th>
      ))}
      <th scope="col" class="record__num">
        22K change
      </th>
    </tr>
  </thead>
  <tbody>
    {shown.map((s, i) => {
      const c = change(i);
      return (
        <tr>
          <th scope="row">
            <time datetime={s.date}>
              <span class="record__long">{formatDate(s.date, { year: undefined })}</span>
              <span class="record__short">
                {formatDate(s.date, { year: undefined, month: 'short' })}
              </span>
            </time>
          </th>
          {DISPLAY_KARATS.map((k) => (
            <td class="record__num fig">{s.perGram[k].toFixed(2)}</td>
          ))}
          <td class:list={['record__num', 'record__change', c.first && 'record__change--first']}>
            {c.text}
          </td>
        </tr>
      );
    })}
  </tbody>
</table>

<style>
  .record {
    inline-size: 100%;
    font-size: var(--t-small);
    color: var(--body);
    border-block: 1px solid var(--rule-strong);
  }

  .record th,
  .record td {
    padding-block: var(--space-3);
    padding-inline: var(--space-2);
    text-align: start;
    vertical-align: baseline;
    white-space: nowrap;
  }

  .record :is(th, td):first-child {
    padding-inline-start: 0;
  }

  .record :is(th, td):last-child {
    padding-inline-end: 0;
  }

  .record thead th {
    font-size: var(--t-eyebrow);
    font-weight: var(--fw-text-strong);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .record tbody tr {
    border-block-start: 1px solid var(--rule);
  }

  .record tbody th {
    font-weight: var(--fw-text-strong);
    color: var(--fg);
  }

  .record .record__num {
    text-align: end;
  }

  .record td.record__num {
    font-variant-numeric: lining-nums tabular-nums;
  }

  .record__change {
    color: var(--muted);
  }

  .record__change--first {
    font-style: italic;
  }

  .record__short {
    display: none;
  }

  /* Phones: "15 Oct", tighter cells, so six columns fit 358 px without scrolling. */
  @media (max-width: 39.99em) {
    .record {
      font-size: var(--t-caption);
    }

    .record th,
    .record td {
      padding-inline: var(--space-1);
    }

    .record thead th {
      letter-spacing: 0.08em;
    }

    .record__long {
      display: none;
    }

    .record__short {
      display: inline;
    }
  }
</style>
