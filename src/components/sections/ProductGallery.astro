---
/**
 * Product photographs. On wide screens the plates stack in a single column (no carousel); below
 * that they form a horizontal scroll-snap strip, one plate per screen, with a "1 / n" counter
 * printed on each cell. Native scrolling only: no arrows, no script.
 */
import type { ImageMetadata } from 'astro';

import Plate from '@/components/ui/Plate.astro';

export interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Product name, used for the list label. */
  name: string;
  class?: string;
}

const { images, name, class: className } = Astro.props;
const many = images.length > 1;
---

<ol
  class:list={['gallery', many && 'gallery--many', className]}
  role="list"
  aria-label={`Photographs of ${name}`}
>
  {images.map((img, i) => (
    <li class="gallery__item">
      <Plate
        image={img.src}
        alt={img.alt}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 64em) 56vw, 100vw"
        priority={i === 0}
      />
      {many && (
        <span class="gallery__count small tabular" aria-hidden="true">
          {i + 1} / {images.length}
        </span>
      )}
    </li>
  ))}
</ol>

<style>
  .gallery {
    display: flex;
    gap: 1px;
    min-inline-size: 0;
    background: var(--rule-1);
    border: 1px solid var(--rule-1);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .gallery__item {
    position: relative;
    flex: 0 0 100%;
    min-inline-size: 0;
    scroll-snap-align: start;
    background: var(--surface-0);
  }

  .gallery__count {
    position: absolute;
    inset-block-end: var(--space-3);
    inset-inline-end: var(--space-4);
    color: var(--ink-500);
  }

  @media (min-width: 64em) {
    .gallery {
      display: grid;
      overflow: visible;
      scroll-snap-type: none;
    }

    .gallery__item {
      flex: none;
    }

    .gallery__count {
      display: none;
    }
  }
</style>
