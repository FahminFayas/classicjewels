---
/**
 * One piece in a wall or a grid (docs/design-system-v2.md §5.5). Two layouts, chosen from the
 * cover photograph's `ground` unless `layout` is passed:
 *
 *   case   a velvet photograph through StageImage: spot mask, the case light (light="scroll" in
 *          walls), morph source for the piece page. The media box carries the stage tone, so a
 *          case reads as a lit case on any ground.
 *   plate  a studio cut-out through Plate, centred in a square of its own lilac, so a row of
 *          plates (PlateGrid) is one continuous lilac counter with no edges.
 *
 * Then the collection eyebrow, the name (Cormorant italic, --t-name; its link is stretched over
 * the image and the name, so there are no nested links), the meta line "22K · AED 468.25 a gram
 * today" (RateFigure, so a newer posting reaches it), the gold value only when a weight is known,
 * and a separate "Ask on WhatsApp" link above the stretched one. Hover and focus draw a 1 px
 * --accent plinth under the image and underline the name; the photograph never moves.
 *
 * Filter contract (src/scripts/filter.ts): data-karat, data-collection, data-name, data-new.
 */
import Plate from '@/components/ui/Plate.astro';
import RateFigure from '@/components/ui/RateFigure.astro';
import StageImage from '@/components/ui/StageImage.astro';
import { photoGround, productPath, type Product } from '@/lib/content';
import { formatAed, formatKarat } from '@/lib/format';
import type { GoldRate } from '@/lib/gold-rate';
import { goldValue } from '@/lib/pricing';
import { toDisplayKarat } from '@/lib/tones';
import { whatsappForProduct } from '@/lib/whatsapp';

export interface Props {
  product: Product;
  collectionName?: string; // the collection's shortName
  rate?: GoldRate | null;
  /** case: velvet photo on the stage; plate: studio cut-out on lilac. Defaults from the image's `ground`. */
  layout?: 'case' | 'plate';
  cap?: number;
  light?: 'static' | 'scroll';
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  product,
  collectionName,
  rate = null,
  layout = photoGround(product) === 'velvet' ? 'case' : 'plate',
  cap,
  light = 'static',
  headingLevel: Tag = 'h3',
  class: className,
} = Astro.props;

const { data } = product;
const href = productPath(product);
const url = new URL(href, Astro.site ?? Astro.url.origin).toString();
const cover = data.images[0];
if (!cover) throw new Error(`Product ${product.id} has no images`);

const caseCap = Math.min(cap ?? 420, cover.src.width);
const collection = collectionName?.replace(/ (Collection|Jewellery)$/i, '');
const value = goldValue(data, rate);
const sold = data.availability === 'sold';
const askLabel = sold ? 'Ask for a similar piece' : 'Ask on WhatsApp';
const status = sold
  ? 'Sold. Ask for a similar piece.'
  : data.availability === 'made-to-order'
    ? 'Made to order'
    : null;
---

<article
  class:list={['card', `card--${layout}`, className]}
  data-karat={data.karat}
  data-category={data.category.id}
  data-collection={data.collection?.id ?? ''}
  data-name={data.name}
  data-new={data.isNew ? '1' : '0'}
>
  {layout === 'case' ? (
    <div class="card__media" data-tone="stage">
      <StageImage
        image={cover.src}
        alt={cover.alt}
        mask="spot"
        cap={caseCap}
        light={light}
        morph="source"
        href={href}
        sizes={`(min-width: 64em) ${caseCap}px, (min-width: 48em) 33vw, 50vw`}
      />
    </div>
  ) : (
    <div class="card__media">
      <div class="card__plate" data-morph-href={href}>
        <Plate image={cover.src} alt={cover.alt} cap={cap} />
      </div>
    </div>
  )}
  <div class="card__body">
    {collection && <p class="card__collection eyebrow">{collection}</p>}
    <Tag class="card__name">
      <a class="card__link" href={href}>
        {data.name}
      </a>
    </Tag>
    <p class="card__meta small fig">
      {formatKarat(data.karat)}
      {data.stones ? (
        <> · {data.stones}</>
      ) : (
        rate && (
          <>
            {' · '}
            <RateFigure rate={rate} karat={toDisplayKarat(data.karat)} format="aed" /> a gram today
          </>
        )
      )}
    </p>
    {value && (
      <p class="card__meta small fig">
        Gold value today ≈{' '}
        <span data-rate-calc={value.karat} data-grams={value.grams}>
          {formatAed(value.value)}
        </span>
      </p>
    )}
    {status && <p class="card__status small">{status}</p>}
    <a
      class="card__ask link-wipe"
      href={whatsappForProduct({ name: data.name, sku: data.sku, url })}
      target="_blank"
      rel="noopener"
      aria-label={`${askLabel} about the ${data.name} (opens WhatsApp)`}
    >
      {askLabel}
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    block-size: 100%;
  }

  /* ---------- Media and the plinth ---------- */
  .card__media {
    position: relative;
  }

  /* The plinth: a resting hairline under the image, and an --accent one that draws over it. */
  .card__media::after,
  .card__media::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
  }

  .card__media::after {
    background: var(--rule);
  }

  .card__media::before {
    z-index: var(--z-raised);
    background: var(--accent);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-slow) var(--ease-lux);
  }

  [dir='rtl'] .card__media::before {
    transform-origin: 100% 50%;
  }

  .card:is(:hover, :focus-within) .card__media::before {
    scale: 1 1;
  }

  /* case: the lit figure sits a little above its plinth. */
  .card--case .card__media {
    padding-block-end: var(--space-3);
  }

  /* plate: a lilac field, the cut-out centred in it at its own size (never above half its
     source width, and never taller than the field), so neighbouring plates join into one
     counter. 4:3, so a small piece is not lost in a large square. */
  .card--plate .card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: var(--space-4);
    background: var(--plate-lilac);
    container-type: size;
  }

  .card__plate {
    display: grid;
    place-items: center;
    inline-size: 100%;
  }

  .card--plate .card__plate :global(.plate) {
    inline-size: min(100cqi, 100cqb, var(--cap));
  }

  /* ---------- Text ---------- */
  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-block: var(--space-4) 0;
  }

  .card--plate .card__body {
    padding-inline: var(--space-4);
  }

  .card__collection {
    margin: 0;
  }

  .card__name {
    font-size: var(--t-name);
    font-style: italic;
    font-weight: var(--fw-display-small);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .card__link {
    color: var(--fg);
    text-decoration: none;
  }

  /* The name's link covers the whole card: image, plinth and name. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link,
  .card__link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--wipe);
    text-underline-offset: 0.18em;
  }

  .card__meta {
    color: var(--muted);
  }

  .card__meta :global(.rate-fig) {
    white-space: nowrap;
  }

  .card__status {
    color: var(--body);
  }

  /* Above the stretched link, so it stays its own target. */
  .card__ask {
    position: relative;
    z-index: var(--z-raised);
    margin-block-start: auto;
    font-size: var(--t-small);
  }
</style>
