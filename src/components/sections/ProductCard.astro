---
/**
 * One cell of a tray grid. The name link is stretched over the whole cell; the Enquire link is a
 * separate, pre-filled WhatsApp link so no JavaScript is needed to convert.
 *
 * Filter contract (read by src/scripts/filter.ts): data-karat, data-collection, data-name and
 * data-new on the <article>. Cards can be direct children of <TrayGrid filterable>.
 *
 * Pass `rate` to show the gold value at today's rate (only when a weight is known; see
 * src/lib/pricing.ts). The figure is marked for src/scripts/rate.ts, which recomputes it in place.
 */
import Icon from '@/components/ui/Icon.astro';
import Plate from '@/components/ui/Plate.astro';
import type { Product } from '@/lib/content';
import { productPath } from '@/lib/content';
import { formatAed, formatGrams, formatKarat } from '@/lib/format';
import type { GoldRate } from '@/lib/gold-rate';
import { goldValue } from '@/lib/pricing';
import { whatsappForProduct } from '@/lib/whatsapp';

export interface Props {
  product: Product;
  /** Collection name for the fact line ("Kolkata"), resolved by the page for THIS product. */
  collectionName?: string;
  rate?: GoldRate | null;
  /** First few cards in a grid are above the fold: load them eagerly. */
  priority?: boolean;
  /** Force edge-to-edge bleed or padded plate. */
  bleed?: boolean;
  class?: string;
}

const {
  product,
  collectionName,
  rate = null,
  priority = false,
  bleed,
  class: className,
} = Astro.props;
const { data } = product;
const href = productPath(product);
const url = new URL(href, Astro.site ?? Astro.url.origin).toString();
const cover = data.images[0];
if (!cover) throw new Error(`Product ${product.id} has no images`);

const facts = [
  formatKarat(data.karat),
  data.weightGrams ? formatGrams(data.weightGrams) : null,
  collectionName?.replace(/ (Collection|Jewellery)$/i, ''),
].filter(Boolean);

const value = goldValue(data, rate);
const sold = data.availability === 'sold';

const chip = sold
  ? 'Sold · ask for similar'
  : data.availability === 'made-to-order'
    ? 'Made to order'
    : data.isNew
      ? 'New'
      : null;
---

<article
  class:list={['card', className]}
  data-karat={data.karat}
  data-category={data.category.id}
  data-collection={data.collection?.id ?? ''}
  data-name={data.name}
  data-new={data.isNew ? '1' : '0'}
>
  <Plate image={cover.src} alt={cover.alt} priority={priority} bleed={bleed} />
  <div class="card__body">
    <h3 class="card__name">
      <a class="card__link link-quiet" href={href}>
        {data.name}
      </a>
    </h3>
    <p class="card__facts tabular">{facts.join(' · ')}</p>
    {value && (
      <p class="card__value small">
        Gold value today ≈{' '}
        <span data-rate-calc={value.karat} data-grams={value.grams}>
          {formatAed(value.value)}
        </span>
      </p>
    )}
    {chip && <p class="card__chip small">{chip}</p>}
    <a
      class="card__enquire"
      href={whatsappForProduct({ name: data.name, sku: data.sku, url })}
      target="_blank"
      rel="noopener"
    >
      <Icon name="whatsapp" class="card__enquire-icon" />
      <span>{sold ? 'Ask for a similar piece' : 'Enquire on WhatsApp'}</span>
      <span class="sr-only"> about the {data.name} on WhatsApp (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The body fills the rest of the cell so the Enquire links line up across a row. */
  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-5);
    border-block-start: 1px solid var(--rule-1);
  }

  .card__name {
    font-family: var(--ff-text);
    font-size: var(--t-title);
    font-weight: 500;
    line-height: 1.35;
  }

  .card__link {
    color: var(--ink-900);
  }

  /* Stretch the name link over the whole cell. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
  }

  .card:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .card__facts {
    font-size: 0.9375rem;
    color: var(--ink-700);
  }

  .card__value,
  .card__chip {
    color: var(--ink-500);
  }

  .card__enquire {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    margin-block-start: auto;
    padding-block: var(--space-1);
    min-block-size: var(--tap);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--t-small);
    font-weight: 500;
    text-decoration: none;
    color: var(--plum-700);
    transition: color var(--dur-fast) var(--ease);
  }

  .card__enquire-icon {
    inline-size: 1.15em;
    block-size: 1.15em;
    flex-shrink: 0;
  }

  .card__enquire:hover {
    color: var(--gold-700);
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
  }
</style>
