---
/**
 * One cell of a tray grid. The name link is stretched over the whole cell; the Enquire link is a
 * separate, pre-filled WhatsApp link so no JavaScript is needed to convert.
 * Pass `rate` to show the baked gold-value line (only rendered when the weight is known).
 */
import Plate from '@/components/ui/Plate.astro';
import type { Product } from '@/lib/content';
import { productPath } from '@/lib/content';
import { formatAed, formatGrams, formatKarat } from '@/lib/format';
import type { GoldRate, Karat } from '@/lib/gold-rate';
import { whatsappForProduct } from '@/lib/whatsapp';

export interface Props {
  product: Product;
  /** Collection name for the fact line ("Kolkata"), already resolved by the page. */
  collectionName?: string;
  rate?: GoldRate | null;
  /** First few cards in a grid are above the fold: load them eagerly. */
  priority?: boolean;
  class?: string;
}

const { product, collectionName, rate = null, priority = false, class: className } = Astro.props;
const { data } = product;
const href = productPath(product);
const url = new URL(href, Astro.site ?? Astro.url.origin).toString();
const cover = data.images[0];
if (!cover) throw new Error(`Product ${product.id} has no images`);

const facts = [
  formatKarat(data.karat),
  data.weightGrams ? formatGrams(data.weightGrams) : null,
  collectionName?.replace(/ (Collection|Jewellery)$/i, ''),
].filter(Boolean);

const karatKey = `${data.karat}k` as Karat;
const goldValue =
  rate && data.weightGrams && data.availability !== 'sold'
    ? formatAed(Math.round(rate.perGram[karatKey] * data.weightGrams))
    : null;

const chip =
  data.availability === 'sold'
    ? 'Sold · ask for similar'
    : data.availability === 'made-to-order'
      ? 'Made to order'
      : data.isNew
        ? 'New'
        : null;
---

<article class:list={['card', className]} data-karat={data.karat} data-category={data.category.id}>
  <Plate image={cover.src} alt={cover.alt} priority={priority} />
  <div class="card__body">
    <h3 class="card__name">
      <a class="card__link link-quiet" href={href}>
        {data.name}
      </a>
    </h3>
    <p class="card__facts tabular">{facts.join(' · ')}</p>
    {goldValue && <p class="card__value small">Gold value today ≈ {goldValue}</p>}
    {chip && <p class="card__chip small">{chip}</p>}
    <a
      class="card__enquire"
      href={whatsappForProduct({ name: data.name, sku: data.sku, url })}
      target="_blank"
      rel="noopener"
    >
      {data.availability === 'sold' ? 'Ask for a similar piece' : 'Enquire'}
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .card__body {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-5);
    border-block-start: 1px solid var(--rule-1);
  }

  .card__name {
    font-family: var(--ff-text);
    font-size: var(--t-title);
    font-weight: 500;
    line-height: 1.35;
  }

  .card__link {
    color: var(--ink-900);
  }

  /* Stretch the name link over the whole cell. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
  }

  .card:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .card__facts {
    font-size: 0.9375rem;
    color: var(--ink-700);
  }

  .card__value {
    color: var(--ink-500);
  }

  .card__chip {
    color: var(--ink-500);
  }

  .card__enquire {
    position: relative;
    z-index: 1;
    justify-self: start;
    margin-block-start: var(--space-2);
    min-block-size: var(--tap);
    display: inline-flex;
    align-items: center;
    font-size: var(--t-small);
    font-weight: 500;
    text-decoration: none;
    color: var(--plum-700);
  }

  .card__enquire:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-600);
  }
</style>
