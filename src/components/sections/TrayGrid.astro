---
/**
 * The tray: a grid of white cells divided by 1 px hairlines (the technique in docs/design-spec.md
 * §4). Children are usually <ProductCard />. Empty state is rendered by the page, not here.
 */
export interface Props {
  class?: string;
  /** Marks the grid for src/scripts/filter.ts. */
  filterable?: boolean;
  id?: string;
}

const { class: className, filterable = false, id } = Astro.props;
---

<div class:list={['tray', className]} id={id} data-filter-grid={filterable || undefined}>
  <slot />
</div>
